# Variabel lingkungan backend (set di server / systemd; file ini tidak dibaca otomatis)
APP_ENV=production
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=news_portal
DB_PASSWORD=
DB_NAME=news_portal
# Alamat frontend yang boleh mengakses API, pisahkan dengan koma
CORS_ORIGINS=https://contoh.id,https://www.contoh.id
# Arsip berita dimuat otomatis pada database kosong; isi false untuk mematikannya
# SEED_NEWS=false
