# Salin menjadi backend/.env lalu isi. Dibaca otomatis oleh backend dan deploy/deploy.sh.
# Variabel yang sudah ada di environment (systemd, pm2) tidak ditimpa.
APP_ENV=production

# Alamat backend. Di belakang nginx cukup 127.0.0.1; pilih port yang belum dipakai aplikasi lain.
HOST=127.0.0.1
PORT=3021
# Port server tampilan (frontend), juga hanya untuk nginx
FRONTEND_PORT=3022

# Alamat situs (dipakai deploy/deploy.sh saat build frontend)
SITE_URL=https://contoh.id
# Alamat frontend yang boleh mengakses API, pisahkan dengan koma
CORS_ORIGINS=https://contoh.id,https://www.contoh.id

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# openssl rand -hex 32
JWT_SECRET=

# Akun admin pertama (minimal 10 karakter). Boleh dihapus setelah akun terbuat.
ADMIN_EMAIL=admin@edutech.id
ADMIN_PASSWORD=

# Arsip berita dimuat otomatis pada database kosong; isi false untuk mematikannya
# SEED_NEWS=false
