---
// Poster/iklan dari Dashboard > Kelola Poster
import { bannerLink, type Banner } from '../lib/site';

export interface Props {
  banners: Banner[];
  variant: 'header' | 'tengah' | 'samping';
}
const { banners, variant } = Astro.props;
---

{banners.map((b) => {
  const link = bannerLink(b);
  return (
    <a class={`poster-slot poster-${variant}`} href={link.href} target={link.target} rel={link.rel} title={b.title} data-banner={b.id}>
      <span class="ad-label">IKLAN</span>
      <img src={b.imageUrl} alt={b.title} loading={variant === 'header' ? 'eager' : 'lazy'} />
    </a>
  );
})}

<style is:global>
  .poster-slot {
    display: block;
    position: relative;
    border-radius: 5px;
    overflow: hidden;
    background: var(--color-bg-hover, #eef2f7);
  }
  .poster-slot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .poster-slot .ad-label {
    position: absolute;
    top: 4px;
    right: 6px;
    padding: 1px 5px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff !important;
    font-size: 8px;
    letter-spacing: 1px;
  }
  .poster-tengah {
    margin: 18px 0 27px;
  }
  /* poster lebar ditampilkan utuh; gambar tinggi tidak memenuhi layar */
  .poster-tengah img {
    max-height: 240px;
    object-fit: contain;
  }
  .poster-header {
    flex: 1;
    max-width: 690px;
    height: 64px;
    margin: auto 18px;
    background: transparent;
  }
  .poster-header img {
    height: 100%;
    width: 100%;
    object-fit: contain;
  }
  @media (max-width: 980px) {
    .poster-header {
      display: none;
    }
  }
</style>
