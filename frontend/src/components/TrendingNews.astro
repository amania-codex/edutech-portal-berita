---
// TrendingNews.astro — Sidebar trending articles list
export interface Props {
  trending: Array<{
    id: number;
    title: string;
    slug: string;
    imageUrl?: string;
    author?: string;
    viewCount?: number;
    createdAt?: string;
  }>;
}

const { trending = [] } = Astro.props;

function timeAgo(dateStr: string): string {
  if (!dateStr) return "Baru saja";
  const date = new Date(dateStr);
  const now = new Date();
  const diffDays = Math.floor((now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays === 0) return "Hari ini";
  if (diffDays < 7) return `${diffDays} hari lalu`;
  if (diffDays < 30) return `${Math.floor(diffDays / 7)} minggu lalu`;
  return `${Math.floor(diffDays / 30)} bulan lalu`;
}
---

<aside class="trending-sidebar" aria-labelledby="trending-heading">
  <div class="trending-header">
    <h2 id="trending-heading">Trending</h2>
    <div class="trending-indicator">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span>LIVE</span>
    </div>
  </div>

  <div class="trending-list">
    {trending.length === 0 ? (
      <p class="empty-state">Belum ada berita trending.</p>
    ) : (
      trending.map((article, index) => (
        <a href={`/berita/${article.slug}`} class="trending-item" key={article.id}>
          <div class="trending-rank">{index + 1}</div>
          <div class="trending-content">
            <div class="trending-time">
              <span class="time-dot" aria-hidden="true">●</span>
              {timeAgo(article.createdAt || '')}
            </div>
            <p class="trending-title">{article.title}</p>
            <div class="trending-meta news-meta">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <span>{article.viewCount || 0}</span>
              <span class="meta-sep">·</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <span>{article.author || 'Redaksi'}</span>
            </div>
          </div>
          {article.imageUrl && (
            <div class="trending-thumb">
              <img src={article.imageUrl} alt="" loading="lazy" aria-hidden="true" />
            </div>
          )}
        </a>
      ))
    )}
  </div>
</aside>

<style>
  .trending-sidebar {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* Header */
  .trending-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .trending-header h2 {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-text-primary);
    position: relative;
  }

  .trending-header h2::after {
    content: '';
    display: block;
    width: 28px;
    height: 3px;
    background: var(--color-accent);
    margin-top: 3px;
    border-radius: var(--radius-full);
  }

  .trending-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 1.5s ease infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  /* List */
  .trending-list {
    display: flex;
    flex-direction: column;
  }

  .empty-state {
    padding: var(--space-6);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Item */
  .trending-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .trending-item:last-child {
    border-bottom: none;
  }

  .trending-item:hover {
    background: var(--color-bg-hover);
  }

  .trending-rank {
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--color-border-light);
    min-width: 20px;
    line-height: 1;
    flex-shrink: 0;
    padding-top: 2px;
  }

  .trending-item:nth-child(1) .trending-rank { color: var(--color-accent); }
  .trending-item:nth-child(2) .trending-rank { color: #e76f51; }
  .trending-item:nth-child(3) .trending-rank { color: var(--color-gold); }

  .trending-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .trending-time {
    font-size: 11px;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .time-dot {
    font-size: 6px;
    color: var(--color-accent);
  }

  .trending-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-fast);
  }

  .trending-item:hover .trending-title {
    color: var(--color-accent);
  }

  .trending-meta {
    font-size: 11px;
    color: var(--color-text-muted);
    gap: var(--space-1);
  }

  .trending-meta svg {
    width: 11px;
    height: 11px;
  }

  .meta-sep {
    color: var(--color-border-light);
  }

  /* Thumbnail */
  .trending-thumb {
    flex-shrink: 0;
    width: 72px;
    height: 56px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-surface);
  }

  .trending-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .trending-item:hover .trending-thumb img {
    transform: scale(1.1);
  }
</style>
