---
// LatestSlider.astro — Horizontal scroll slider untuk berita terbaru
// Terinspirasi dari "three_slide" (Terbaru section) dalam full-block-one.php beritaxx
// Menampilkan thumbnail 90x90 + judul + views + author dalam carousel horizontal

export interface Article {
  id: number;
  title: string;
  slug: string;
  imageUrl?: string;
  author?: string;
  viewCount?: number;
  createdAt?: string;
  category?: string;
}

export interface Props {
  articles?: Article[];
  title?: string;
}

const { articles = [], title = "Terbaru" } = Astro.props;

function timeAgo(dateStr: string): string {
  if (!dateStr) return "Baru saja";
  const date = new Date(dateStr);
  const now = new Date();
  const diff = now.getTime() - date.getTime();
  const hours = Math.floor(diff / (1000 * 60 * 60));
  if (hours < 1) return "Baru saja";
  if (hours < 24) return `${hours} jam lalu`;
  const days = Math.floor(hours / 24);
  if (days < 7) return `${days} hari lalu`;
  if (days < 30) return `${Math.floor(days / 7)} minggu lalu`;
  return `${Math.floor(days / 30)} bulan lalu`;
}

const fallbackImg = "https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=800&q=80";
---

<div class="latest-slider-wrap">
  <div class="latest-slider-header">
    <span class="latest-slider-label">{title}</span>
    <div class="slider-nav">
      <button class="slider-btn" id="slide-prev" aria-label="Sebelumnya">‹</button>
      <button class="slider-btn" id="slide-next" aria-label="Berikutnya">›</button>
    </div>
  </div>

  <div class="latest-slider-track" id="latest-slider-track">
    {articles.map((article) => (
      <a href={`/berita/${article.slug}`} class="latest-slide-item">
        <div class="slide-thumb">
          <img
            src={article.imageUrl || fallbackImg}
            alt=""
            loading="lazy"
            aria-hidden="true"
            onerror={`this.onerror=null;this.src='${fallbackImg}';`}
          />
        </div>
        <div class="slide-content">
          <div class="slide-time">{timeAgo(article.createdAt || '')}</div>
          <p class="slide-title">{article.title}</p>
          <div class="slide-meta">
            <span class="slide-views">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              {article.viewCount || 0}
            </span>
            <span class="slide-author" title={article.author || 'Redaksi'}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span class="author-name">{article.author || 'Redaksi'}</span>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .latest-slider-wrap {
    margin-top: var(--space-4);
    position: relative;
  }

  .latest-slider-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .latest-slider-label {
    display: inline-block;
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--radius-sm);
  }

  .slider-nav {
    display: flex;
    gap: var(--space-1);
  }

  .slider-btn {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .slider-btn:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  /* Slider track */
  .latest-slider-track {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: var(--space-1);
  }

  .latest-slider-track::-webkit-scrollbar {
    display: none;
  }

  /* Slide item */
  .latest-slide-item {
    flex-shrink: 0;
    width: 220px;
    display: flex;
    gap: var(--space-2);
    text-decoration: none;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    transition: all var(--transition-fast);
  }

  .latest-slide-item:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .slide-thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-surface);
  }

  .slide-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .latest-slide-item:hover .slide-thumb img {
    transform: scale(1.08);
  }

  .slide-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .slide-time {
    font-size: 11px;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .slide-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    transition: color var(--transition-fast);
  }

  .latest-slide-item:hover .slide-title {
    color: var(--color-accent);
  }

  .slide-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 11px;
    color: var(--color-text-muted);
    margin-top: auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-wrap: nowrap;
    min-width: 0;
  }

  .slide-views {
    display: flex;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .slide-author {
    display: flex;
    align-items: center;
    gap: 3px;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .author-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
  }

  .slide-views svg,
  .slide-author svg {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }
</style>

<script>
  const track = document.getElementById('latest-slider-track');
  const prevBtn = document.getElementById('slide-prev');
  const nextBtn = document.getElementById('slide-next');

  const scrollAmount = 240;

  prevBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });
</script>
