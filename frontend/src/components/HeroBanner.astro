---
// HeroBanner.astro - Dynamic Photo Poster / Banner Component
export interface Props {
  banners?: any[];
}

const API_BASE = "http://localhost:3000/api";
let activeBanners: any[] = Astro.props.banners || [];

if (!activeBanners || activeBanners.length === 0) {
  try {
    const res = await fetch(`${API_BASE}/banners`);
    if (res.ok) {
      activeBanners = await res.json();
    }
  } catch (err) {
    console.error("Failed to fetch active banners:", err);
  }
}

// Fallback jika database belum ada banner aktif sama sekali
if (!activeBanners || activeBanners.length === 0) {
  activeBanners = [
    {
      id: 1,
      title: "SENIKO 2026 - Seminar Nasional Informatika dan Komputer: Memperkuat Resiliensi Smart City",
      image_url: "https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1600&q=80",
      target_url: "https://seniko.id",
      is_active: true,
    },
  ];
}
---

<section class="hero-poster-container" aria-label="Poster Utama Portal Berita">
  <div class="poster-slider" id="poster-slider">
    {activeBanners.map((banner: any, index: number) => {
      const fullImgUrl = banner.image_url?.startsWith("http")
        ? banner.image_url
        : `http://localhost:3000${banner.image_url}`;

      return (
        <div class={`poster-slide ${index === 0 ? "active" : ""}`} data-index={index}>
          <a
            href={banner.target_url || "#"}
            target={banner.target_url ? "_blank" : "_self"}
            rel="noopener noreferrer"
            class="poster-card"
          >
            <div class="poster-image-wrap">
              <img
                src={fullImgUrl}
                alt={banner.title}
                class="poster-img"
                loading={index === 0 ? "eager" : "lazy"}
                onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1600&q=80';"
              />
              <div class="poster-overlay"></div>
            </div>

            <!-- Poster Caption / Details -->
            <div class="poster-content">
              <div class="poster-badge-row">
                <span class="poster-badge">
                  <span class="badge-pulse"></span>
                  EVENT & POSTER TERKINI
                </span>
                {banner.target_url && (
                  <span class="poster-cta-pill">
                    Buka Tautan
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12">
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </span>
                )}
              </div>

              <h2 class="poster-title">{banner.title}</h2>
            </div>
          </a>
        </div>
      );
    })}

    <!-- Navigation Controls (if multiple banners) -->
    {activeBanners.length > 1 && (
      <>
        <button class="slider-btn prev-btn" id="slider-prev" aria-label="Poster Sebelumnya">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="slider-btn next-btn" id="slider-next" aria-label="Poster Selanjutnya">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <div class="slider-dots" id="slider-dots">
          {activeBanners.map((_: any, idx: number) => (
            <button
              class={`dot-btn ${idx === 0 ? "active" : ""}`}
              data-slide={idx}
              aria-label={`Ke slide ${idx + 1}`}
            ></button>
          ))}
        </div>
      </>
    )}
  </div>
</section>

<style>
  .hero-poster-container {
    position: relative;
    width: 100%;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    background: #0b0f19;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .poster-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: 240px;
    max-height: 480px;
  }

  .poster-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s;
    z-index: 1;
  }

  .poster-slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .poster-card {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
    overflow: hidden;
  }

  .poster-image-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .poster-card:hover .poster-img {
    transform: scale(1.03);
  }

  .poster-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 14, 26, 0.98) 0%,
      rgba(10, 14, 26, 0.85) 45%,
      rgba(10, 14, 26, 0.35) 75%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* Content */
  .poster-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-6) var(--space-8);
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 860px;
  }

  .poster-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .poster-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-accent);
    color: white;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 9999px;
    backdrop-filter: blur(4px);
    box-shadow: 0 2px 10px rgba(230, 57, 70, 0.5);
  }

  .badge-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(255, 255, 255, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
    }
  }

  .poster-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 9999px;
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition: all 0.2s;
  }

  .poster-card:hover .poster-cta-pill {
    background: white;
    color: #0f172a;
  }

  .poster-title {
    color: #ffffff;
    font-size: clamp(1.25rem, 2.8vw, 2.2rem);
    font-weight: 800;
    line-height: 1.35;
    margin: 0;
    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.95);
    max-width: 90%;
  }

  /* Slider Controls */
  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s;
    backdrop-filter: blur(4px);
  }

  .slider-btn svg {
    width: 20px;
    height: 20px;
  }

  .slider-btn:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-50%) scale(1.05);
  }

  .prev-btn { left: 16px; }
  .next-btn { right: 16px; }

  .slider-dots {
    position: absolute;
    bottom: 16px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 10;
  }

  .dot-btn {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    transition: all 0.3s;
    padding: 0;
  }

  .dot-btn.active {
    width: 26px;
    background: var(--color-accent);
  }

  @media (max-width: 768px) {
    .poster-slider {
      aspect-ratio: 16 / 10;
      min-height: 200px;
    }

    .poster-content {
      padding: var(--space-4);
      gap: 6px;
    }

    .poster-title {
      font-size: 1rem;
      max-width: 100%;
    }

    .slider-btn {
      width: 34px;
      height: 34px;
    }

    .slider-btn svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script is:inline>
  (function () {
    const slides = document.querySelectorAll('.poster-slide');
    const dots = document.querySelectorAll('.dot-btn');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer = null;

    function goToSlide(index) {
      slides[currentIndex]?.classList.remove('active');
      dots[currentIndex]?.classList.remove('active');

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex]?.classList.add('active');
      dots[currentIndex]?.classList.add('active');
    }

    function startAutoSlide() {
      stopAutoSlide();
      timer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 5000);
    }

    function stopAutoSlide() {
      if (timer) clearInterval(timer);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(currentIndex - 1);
        startAutoSlide();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(currentIndex + 1);
        startAutoSlide();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const slideIndex = parseInt(dot.getAttribute('data-slide') || '0', 10);
        goToSlide(slideIndex);
        startAutoSlide();
      });
    });

    const slider = document.getElementById('poster-slider');
    if (slider) {
      slider.addEventListener('mouseenter', stopAutoSlide);
      slider.addEventListener('mouseleave', startAutoSlide);
    }

    startAutoSlide();
  })();
</script>
