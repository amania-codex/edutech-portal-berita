---
// HeroBanner.astro - Main featured event/conference banner
---

<section class="hero-banner" aria-label="Banner Utama">
  <div class="hero-inner">
    <!-- Top Labels -->
    <div class="hero-top">
      <div class="hero-badge-left">
        <div class="accredited-badge">
          <span class="badge-sinta">TERAKREDITASI</span>
          <span class="badge-sinta-level">SINTA 2</span>
          <span class="badge-sub">Prinsip Indeksasi Scopus</span>
        </div>
      </div>
      <div class="hero-top-center">
        <h1 class="hero-title">
          SENIKO<span class="hero-year">.2026</span>
        </h1>
        <p class="hero-subtitle">Seminar Nasional Informatika dan Komputer</p>
      </div>
      <div class="hero-badge-right">
        <div class="journal-badge">
          <span class="journal-label">JURNAL TEKNIK</span>
          <span class="journal-name">INFORMATIKA</span>
          <span class="journal-abbr">(JUTIF)</span>
          <span class="journal-accredited">TERAKREDITASI SINTA 2</span>
        </div>
      </div>
    </div>

    <!-- Theme Text -->
    <div class="hero-theme">
      <p class="theme-label">TATA KELOLA SISTEM INFORMASI CERDAS:</p>
      <h2 class="theme-main">
        MEMPERKUAT RESILIENSI SMART CITY<br/>
        TERHADAP ANCAMAN CYBER WARFARE
      </h2>
    </div>

    <!-- Info Row -->
    <div class="hero-info">
      <div class="info-item">
        <div class="info-icon">📅</div>
        <div>
          <div class="info-label">SABTU</div>
          <div class="info-value">24 OKTOBER 2026</div>
          <div class="info-sub">08.00 WIB - SELESAI</div>
        </div>
      </div>
      <div class="info-divider"></div>
      <div class="info-item">
        <div class="info-icon">📍</div>
        <div>
          <div class="info-label">LOKASI</div>
          <div class="info-value">PURWOKERTO</div>
          <div class="info-sub">HYBRID CONFERENCE (OFFLINE & ONLINE)</div>
        </div>
      </div>
      <div class="info-divider"></div>
      <div class="info-item">
        <div class="info-icon">👥</div>
        <div>
          <div class="info-label">TARGET PESERTA</div>
          <div class="info-value">250+</div>
          <div class="info-sub">PESERTA NASIONAL</div>
        </div>
      </div>
    </div>

    <!-- Hashtags -->
    <div class="hero-hashtags">
      <span>#SENIKO2026</span>
      <span>#SmartCity</span>
      <span>#AI</span>
      <span>#CyberResilience</span>
      <span>#DigitalTransformation</span>
      <span>#IndonesiaSmartFuture</span>
    </div>

    <!-- Footer Row -->
    <div class="hero-footer">
      <div class="organizer">
        <span class="org-label">PENYELENGGARA:</span>
        <span class="org-name">PROGRAM STUDI INFORMATIKA · FAKULTAS TEKNIK · UNIVERSITAS JENDERAL SOEDIRMAN</span>
      </div>
      <div class="hero-logos">
        <div class="logo-pill">JUTIF</div>
        <div class="logo-pill accent">SENIKO 2026</div>
        <div class="logo-pill">MITRA PERGURUAN TINGGI NASIONAL</div>
      </div>
      <div class="hero-contact">
        <span>🌐 https://seniko.id</span>
        <span>📧 admin@seniko.id</span>
        <span>📱 085111346465</span>
      </div>
    </div>

    <!-- Gradient overlay for depth -->
    <div class="hero-overlay" aria-hidden="true"></div>
    <!-- Background grid effect -->
    <div class="hero-grid-bg" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    background: linear-gradient(135deg, #0a0e1a 0%, #0d1b2a 30%, #1a2a4a 60%, #0d1b2a 100%);
    border: 1px solid rgba(72, 149, 239, 0.2);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-lg), 0 0 40px rgba(72, 149, 239, 0.1);
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(72, 149, 239, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(72, 149, 239, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(72, 149, 239, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Top Row */
  .hero-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: var(--space-4);
  }

  .accredited-badge, .journal-badge {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .accredited-badge {
    border: 2px solid var(--color-gold);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    background: rgba(244, 196, 48, 0.05);
    color: var(--color-gold);
    align-self: start;
    max-width: 180px;
  }

  .badge-sinta-level {
    font-size: var(--text-xl);
    color: var(--color-gold);
  }

  .badge-sub {
    font-size: 10px;
    opacity: 0.8;
  }

  .hero-top-center {
    text-align: center;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    letter-spacing: -2px;
    color: white;
    text-shadow: 0 0 30px rgba(72, 149, 239, 0.5);
    line-height: 1;
  }

  .hero-year {
    color: var(--color-gold);
  }

  .hero-subtitle {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  .journal-badge {
    text-align: right;
    align-self: start;
    border: 2px solid rgba(72, 149, 239, 0.5);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    color: var(--color-blue);
    background: rgba(72, 149, 239, 0.05);
    margin-left: auto;
    max-width: 180px;
  }

  .journal-name {
    font-size: var(--text-lg);
  }

  /* Theme */
  .hero-theme {
    text-align: center;
    padding: var(--space-4) 0;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .theme-label {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .theme-main {
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 900;
    color: white;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.25;
    text-shadow: 0 2px 20px rgba(0,0,0,0.5);
  }

  /* Info Row */
  .hero-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-align: left;
  }

  .info-icon {
    font-size: 1.5rem;
  }

  .info-label {
    font-size: 10px;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .info-value {
    font-size: var(--text-base);
    font-weight: 800;
    color: white;
    letter-spacing: 0.02em;
  }

  .info-sub {
    font-size: 10px;
    color: rgba(255,255,255,0.6);
    margin-top: 1px;
  }

  .info-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.15);
  }

  /* Hashtags */
  .hero-hashtags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }

  .hero-hashtags span {
    font-size: var(--text-xs);
    color: var(--color-blue);
    font-weight: 600;
    opacity: 0.85;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .hero-hashtags span:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* Footer Row */
  .hero-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .organizer {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .org-label {
    font-size: 9px;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .org-name {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.7);
    font-weight: 500;
  }

  .hero-logos {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .logo-pill {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255,255,255,0.2);
    font-size: 10px;
    font-weight: 700;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .logo-pill.accent {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  .hero-contact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 10px;
    color: rgba(255,255,255,0.5);
  }

  @media (max-width: 768px) {
    .hero-inner {
      padding: var(--space-4);
    }

    .hero-top {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .accredited-badge, .journal-badge {
      display: none;
    }

    .hero-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .info-divider {
      display: none;
    }

    .hero-info {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
