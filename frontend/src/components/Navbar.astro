---
// Navbar.astro — Edutech-portal-ramai editorial style
import { getSessionFromRequest } from '../lib/session';

const session = await getSessionFromRequest(Astro.request);

const todayStr = new Intl.DateTimeFormat("id-ID", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric"
}).format(new Date());

const currentPath = Astro.url.pathname;
---

<div class="topline">
  <div class="container topline-inner">
    <span id="todayDate">{todayStr}</span>
    <div class="top-links">
      <a href="/#redaksi">Tentang Kami</a>
      <a href="/#kontak">Kontak</a>
      <a href="/#newsletter">Newsletter</a>
      <span class="social-dot" title="Facebook">f</span>
      <span class="social-dot" title="X / Twitter">𝕏</span>
      <span class="social-dot" title="YouTube">▶</span>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container brand-row">
    <button class="mobile-menu" id="mobileMenu" aria-label="Buka menu">☰</button>
    <a class="brand" href="/" aria-label="EduTech.id Beranda">
      <span class="brand-mark"><span></span><span></span><span></span></span>
      <span class="brand-name">Edu<span>Tech</span><small>.id</small></span>
    </a>
    
    <div class="header-ad">
      <span class="ad-label">ADVERTISEMENT</span>
      <strong>Ruang kolaborasi untuk ide dan inovasi.</strong>
      <span>Publikasikan kegiatan, riset, dan kabar institusi Anda.</span>
    </div>

    <div class="header-actions">
      <button id="searchToggle" aria-label="Cari berita" title="Cari">⌕</button>
      <button id="themeToggle" aria-label="Ubah tema" title="Ganti Mode Gelap/Terang">☾</button>
      
      {session ? (
        <a href="/dashboard" class="auth-btn-pill" title="Ke Dashboard">
          <span class="auth-avatar-pill">{session.name.charAt(0).toUpperCase()}</span>
          <span>Dashboard</span>
        </a>
      ) : (
        <a href="/login" class="auth-btn-pill" title="Masuk">
          <span>Masuk</span>
        </a>
      )}
    </div>
  </div>

  <nav class="main-nav" id="mainNav">
    <div class="container nav-inner">
      <a class={`nav-home ${currentPath === '/' ? 'active' : ''}`} href="/" title="Beranda">⌂</a>
      <a href="/kategori/pendidikan" class={currentPath === '/kategori/pendidikan' ? 'active' : ''}>Pendidikan</a>
      <a href="/kategori/kampus" class={currentPath === '/kategori/kampus' ? 'active' : ''}>Kampus</a>
      <a href="/kategori/teknologi" class={currentPath === '/kategori/teknologi' ? 'active' : ''}>Teknologi</a>
      <a href="/kategori/riset" class={currentPath === '/kategori/riset' ? 'active' : ''}>Riset</a>
      <a href="/event" class={currentPath.startsWith('/event') ? 'active' : ''}>Event & Webinar</a>
      <a href="/kategori/artikel" class={currentPath === '/kategori/artikel' ? 'active' : ''}>Artikel</a>
      {session && (
        <a href="/user/tickets" class={currentPath === '/user/tickets' ? 'active' : ''}>Tiket Saya</a>
      )}
      <a href="/kategori/headline" class="nav-special">Advertorial <span>↗</span></a>
      <a href="/#kontak">Kontak</a>
    </div>
  </nav>

  <div class="search-panel" id="searchPanel">
    <div class="container search-inner">
      <form action="/cari" method="get" style="display: contents;">
        <input type="search" name="q" id="searchInput" placeholder="Cari berita, kampus, teknologi, event..." aria-label="Cari berita" autocomplete="off" />
        <button type="submit" id="searchSubmit">Cari ↗</button>
        <button type="button" id="searchClose">Tutup ✕</button>
      </form>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile navigation toggle
  const mobileBtn = document.getElementById("mobileMenu");
  const mainNav = document.getElementById("mainNav");
  if (mobileBtn && mainNav) {
    mobileBtn.addEventListener("click", () => {
      mainNav.classList.toggle("mobile-open");
      mobileBtn.textContent = mainNav.classList.contains("mobile-open") ? "✕" : "☰";
    });
  }

  // Search panel toggle
  const searchToggle = document.getElementById("searchToggle");
  const searchPanel = document.getElementById("searchPanel");
  const searchClose = document.getElementById("searchClose");
  const searchInput = document.getElementById("searchInput");

  if (searchToggle && searchPanel) {
    searchToggle.addEventListener("click", () => {
      searchPanel.classList.toggle("open");
      if (searchPanel.classList.contains("open") && searchInput) {
        searchInput.focus();
      }
    });
  }

  if (searchClose && searchPanel) {
    searchClose.addEventListener("click", () => {
      searchPanel.classList.remove("open");
    });
  }

  // Theme toggle
  const themeToggle = document.getElementById("themeToggle");
  function syncThemeToggleIcon() {
    const isDark = document.body.classList.contains("dark") || document.documentElement.classList.contains("dark");
    if (themeToggle) {
      themeToggle.textContent = isDark ? "☀" : "☾";
    }
  }

  if (themeToggle) {
    syncThemeToggleIcon();
    themeToggle.addEventListener("click", () => {
      document.body.classList.toggle("dark");
      document.documentElement.classList.toggle("dark");
      const isDark = document.body.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      syncThemeToggleIcon();
      
      const toast = document.getElementById("toast");
      if (toast) {
        toast.textContent = isDark ? "Mode gelap diaktifkan" : "Mode terang diaktifkan";
        toast.classList.add("show");
        setTimeout(() => toast.classList.remove("show"), 2200);
      }
    });
  }
</script>
