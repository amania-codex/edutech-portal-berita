---
// CategoryBlock.astro — 3-column category grid (terinspirasi dari full-category-block.php beritaxx)
// Kolom 1: 1 artikel featured per kategori A (gambar besar + overlay)
// Kolom 2: Daftar 5 artikel kategori B (list style)
// Kolom 3: Grid 4 artikel kecil kategori C (2x2 grid)

export interface Article {
  id: number;
  title: string;
  slug: string;
  excerpt?: string;
  imageUrl?: string;
  category?: string;
  author?: string;
  viewCount?: number;
  createdAt?: string;
}

export interface Props {
  catOneTitle?: string;
  catOneArticles?: Article[];
  catTwoTitle?: string;
  catTwoArticles?: Article[];
  catThreeTitle?: string;
  catThreeArticles?: Article[];
}

const {
  catOneTitle = "Rakornas",
  catOneArticles = [],
  catTwoTitle = "Event",
  catTwoArticles = [],
  catThreeTitle = "Riset",
  catThreeArticles = [],
} = Astro.props;

function timeAgo(dateStr: string): string {
  if (!dateStr) return "Baru saja";
  const date = new Date(dateStr);
  const now = new Date();
  const diff = now.getTime() - date.getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins} menit lalu`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours} jam lalu`;
  const days = Math.floor(hours / 24);
  if (days < 7) return `${days} hari lalu`;
  if (days < 30) return `${Math.floor(days / 7)} minggu lalu`;
  return `${Math.floor(days / 30)} bulan lalu`;
}

const fallbackImg = "https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=800&q=80";
---

<section class="cat-block-section" aria-label="Berita per Kategori">
  <div class="cat-block-grid">

    <!-- Kolom 1: Featured overlay (seperti cat_block_block kolom kiri) -->
    {catOneArticles.length > 0 && (
      <div class="cat-col cat-col-featured">
        <div class="cat-col-head">
          <span class="cat-head-badge">{catOneTitle}</span>
        </div>
        <div class="cat-featured-stack">
          {catOneArticles.slice(0, 2).map((article, i) => (
            <a href={`/berita/${article.slug}`} class={`cat-feat-item ${i === 0 ? 'cat-feat-main' : 'cat-feat-sub'}`}>
              <div class="cat-feat-img">
                <img
                  src={article.imageUrl || fallbackImg}
                  alt={article.title}
                  loading="lazy"
                  onerror={`this.onerror=null;this.src='${fallbackImg}';`}
                />
                <div class="cat-feat-overlay"></div>
              </div>
              <div class="cat-feat-info">
                <div class="cat-feat-meta">
                  <span class="cat-time">{timeAgo(article.createdAt || '')}</span>
                  <span class="cat-views">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    {article.viewCount || 0}
                  </span>
                </div>
                <h3 class="cat-feat-title">{article.title}</h3>
                <span class="cat-feat-author">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  {article.author || 'Redaksi'}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Kolom 2: Daftar list artikel (seperti block_two_list) -->
    {catTwoArticles.length > 0 && (
      <div class="cat-col cat-col-list">
        <div class="cat-col-head">
          <h3 class="cat-head-title">{catTwoTitle}</h3>
        </div>
        <ul class="cat-list">
          {catTwoArticles.slice(0, 5).map((article) => (
            <li class="cat-list-item">
              <a href={`/berita/${article.slug}`} class="cat-list-link">
                <div class="cat-list-img">
                  <img
                    src={article.imageUrl || fallbackImg}
                    alt=""
                    loading="lazy"
                    aria-hidden="true"
                    onerror={`this.onerror=null;this.src='${fallbackImg}';`}
                  />
                </div>
                <div class="cat-list-content">
                  <span class="cat-time">{timeAgo(article.createdAt || '')}</span>
                  <p class="cat-list-title">{article.title}</p>
                  <div class="cat-list-meta">
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      {article.viewCount || 0}
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      {article.author || 'Redaksi'}
                    </span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Kolom 3: Grid 2x2 kecil (seperti block_three_grid) -->
    {catThreeArticles.length > 0 && (
      <div class="cat-col cat-col-grid">
        <div class="cat-col-head">
          <h3 class="cat-head-title">{catThreeTitle}</h3>
        </div>
        <div class="cat-small-grid">
          {catThreeArticles.slice(0, 4).map((article, i) => (
            <a href={`/berita/${article.slug}`} class="cat-small-item">
              <div class="cat-small-img">
                <img
                  src={article.imageUrl || fallbackImg}
                  alt={article.title}
                  loading="lazy"
                  onerror={`this.onerror=null;this.src='${fallbackImg}';`}
                />
                <div class="cat-small-overlay"></div>
              </div>
              <div class="cat-small-info">
                <span class="cat-time">{timeAgo(article.createdAt || '')}</span>
                <p class="cat-small-title">{article.title}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<style>
  .cat-block-section {
    margin-top: var(--space-10);
  }

  .cat-block-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  /* === Column Head === */
  .cat-col-head {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-accent);
    position: relative;
  }

  .cat-head-badge {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: var(--radius-sm);
  }

  .cat-head-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.2px;
  }

  /* === Kolom 1: Featured Stack === */
  .cat-featured-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cat-feat-item {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    position: relative;
  }

  .cat-feat-main .cat-feat-img { height: 200px; }
  .cat-feat-sub .cat-feat-img { height: 140px; }

  .cat-feat-img {
    position: relative;
    overflow: hidden;
  }

  .cat-feat-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .cat-feat-item:hover .cat-feat-img img {
    transform: scale(1.05);
  }

  .cat-feat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
  }

  .cat-feat-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-3);
  }

  .cat-feat-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .cat-feat-title {
    font-size: 13px;
    font-weight: 700;
    color: white;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
    margin: 0 0 var(--space-1);
    transition: color var(--transition-fast);
  }

  .cat-feat-item:hover .cat-feat-title {
    color: #ffd166;
  }

  .cat-feat-author {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: rgba(255,255,255,0.7);
  }

  .cat-feat-author svg {
    width: 11px;
    height: 11px;
  }

  /* === Kolom 2: List === */
  .cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cat-list-item {
    border-bottom: 1px solid var(--color-border);
  }

  .cat-list-item:last-child {
    border-bottom: none;
  }

  .cat-list-link {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .cat-list-link:hover .cat-list-title {
    color: var(--color-accent);
  }

  .cat-list-img {
    flex-shrink: 0;
    width: 80px;
    height: 60px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-surface);
  }

  .cat-list-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .cat-list-link:hover .cat-list-img img {
    transform: scale(1.08);
  }

  .cat-list-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cat-list-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    transition: color var(--transition-fast);
  }

  .cat-list-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .cat-list-meta span {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .cat-list-meta svg {
    width: 11px;
    height: 11px;
  }

  /* === Kolom 3: Small Grid 2x2 === */
  .cat-small-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .cat-small-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cat-small-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .cat-small-img {
    position: relative;
    height: 110px;
    overflow: hidden;
  }

  .cat-small-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .cat-small-item:hover .cat-small-img img {
    transform: scale(1.08);
  }

  .cat-small-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 60%);
  }

  .cat-small-info {
    padding: 0 var(--space-2) var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cat-small-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    transition: color var(--transition-fast);
  }

  .cat-small-item:hover .cat-small-title {
    color: var(--color-accent);
  }

  /* === Shared === */
  .cat-time {
    font-size: 11px;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .cat-views {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    color: rgba(255,255,255,0.65);
  }

  .cat-views svg {
    width: 11px;
    height: 11px;
  }

  /* === Responsive === */
  @media (max-width: 1024px) {
    .cat-block-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cat-col-grid {
      grid-column: 1 / -1;
    }

    .cat-small-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .cat-block-grid {
      grid-template-columns: 1fr;
    }

    .cat-col-grid {
      grid-column: 1;
    }

    .cat-small-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
