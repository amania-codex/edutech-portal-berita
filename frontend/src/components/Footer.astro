---
// Footer.astro
const categories = [
  { label: "Beranda", href: "/" },
  { label: "Headline", href: "/kategori/headline" },
  { label: "Berita", href: "/kategori/berita" },
  { label: "Artikel", href: "/kategori/artikel" },
  { label: "Event", href: "/kategori/event" },
  { label: "Video", href: "/kategori/video" },
  { label: "Riset", href: "/kategori/riset" },
  { label: "Loker", href: "/kategori/loker" },
];
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="container footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="EduTech Home">
          <div class="logo-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 3L1 9L5 11.18V17.18L12 21L19 17.18V11.18L21 10.09V17H23V9L12 3ZM18.82 9L12 12.72L5.18 9L12 5.28L18.82 9ZM17 15.99L12 18.72L7 15.99V12.27L12 15L17 12.27V15.99Z" fill="#e63946"/>
            </svg>
            <span class="logo-text">Edu<span class="logo-accent">Tech</span></span>
          </div>
        </a>
        <p class="footer-desc">
          Portal berita terdepan untuk informasi seputar pendidikan, teknologi, riset, dan karir akademik Indonesia. Menyajikan berita akurat, terpercaya, dan terkini.
        </p>
        <div class="footer-social">
          <a href="#" class="social-icon" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622 3.604 3.604 0 0 0-.272 1.237v1.808h3.605l-.499 3.667h-3.106v7.98H9.101z"/>
            </svg>
          </a>
          <a href="#" class="social-icon" aria-label="X (Twitter)">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="#" class="social-icon" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
            </svg>
          </a>
          <a href="#" class="social-icon" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="footer-col">
        <h3 class="footer-heading">Navigasi</h3>
        <ul class="footer-links">
          {categories.map((cat) => (
            <li>
              <a href={cat.href} class="footer-link">
                <span class="link-arrow" aria-hidden="true">›</span>
                {cat.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h3 class="footer-heading">Kontak</h3>
        <ul class="footer-contact-list">
          <li class="contact-item">
            <span class="contact-icon">📍</span>
            <span>Jl. Pendidikan No. 1, Indonesia</span>
          </li>
          <li class="contact-item">
            <span class="contact-icon">📧</span>
            <a href="mailto:redaksi@edutech.id">redaksi@edutech.id</a>
          </li>
          <li class="contact-item">
            <span class="contact-icon">📱</span>
            <a href="tel:+6285111346465">+62 851-1134-6465</a>
          </li>
          <li class="contact-item">
            <span class="contact-icon">🌐</span>
            <a href="/">www.edutech.id</a>
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="footer-col">
        <h3 class="footer-heading">Newsletter</h3>
        <p class="footer-newsletter-desc">Dapatkan berita terbaru langsung di kotak masuk email kamu.</p>
        <form class="newsletter-form" onsubmit="return false;">
          <input
            type="email"
            id="newsletter-email"
            placeholder="Masukkan email kamu..."
            autocomplete="email"
            required
          />
          <button type="submit" class="newsletter-btn">
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright">
        © {new Date().getFullYear()} EduTech News Portal. Semua hak cipta dilindungi.
      </p>
      <div class="footer-bottom-links">
        <a href="/kebijakan-privasi">Kebijakan Privasi</a>
        <span>·</span>
        <a href="/syarat-penggunaan">Syarat Penggunaan</a>
        <span>·</span>
        <a href="/tentang-kami">Tentang Kami</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .footer-top {
    padding: var(--space-10) 0 var(--space-8);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: var(--space-8);
    align-items: start;
  }

  /* Brand */
  .footer-brand {}

  .footer-logo {
    display: inline-block;
    margin-bottom: var(--space-4);
    text-decoration: none;
  }

  .logo-box {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: white;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    border: 2px solid #e0e0e0;
    width: fit-content;
  }

  .logo-text {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: var(--text-lg);
    color: #222;
    letter-spacing: -0.5px;
  }

  .logo-accent {
    color: var(--color-accent);
  }

  .footer-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .footer-social {
    display: flex;
    gap: var(--space-2);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-muted);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .social-icon:hover {
    background: var(--color-accent);
    color: white;
  }

  .social-icon svg {
    width: 16px;
    height: 16px;
  }

  /* Columns */
  .footer-col {}

  .footer-heading {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    position: relative;
    padding-bottom: var(--space-2);
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 24px;
    height: 2px;
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .link-arrow {
    color: var(--color-accent);
    font-size: var(--text-lg);
    line-height: 0;
  }

  /* Contact */
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .contact-icon {
    flex-shrink: 0;
    width: 18px;
    text-align: center;
  }

  .contact-item a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .contact-item a:hover {
    color: var(--color-accent);
  }

  /* Newsletter */
  .footer-newsletter-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .newsletter-form input {
    width: 100%;
    padding: 10px var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .newsletter-form input::placeholder {
    color: var(--color-text-muted);
  }

  .newsletter-form input:focus {
    border-color: var(--color-accent);
  }

  .newsletter-btn {
    padding: 10px var(--space-4);
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 700;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: background var(--transition-fast), transform var(--transition-fast);
    border: none;
  }

  .newsletter-btn:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  /* Bottom Bar */
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: var(--space-4) 0;
    background: var(--color-bg-primary);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .copyright {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-bottom-links a {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-bottom-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
