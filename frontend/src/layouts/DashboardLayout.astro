---
export type StaffRole = 'admin' | 'editor' | 'penulis';
export interface Props {
  title?: string;
  activeMenu?: string;
  /** Peran yang boleh membuka halaman ini (bawaan: hanya admin) */
  roles?: StaffRole[];
}

const { title = 'Dashboard', activeMenu = '', roles = ['admin'] } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <script>
      // Apply theme immediately to prevent FOUC
      const theme = localStorage.getItem('edutech-theme');
      if (theme === 'light') {
        document.documentElement.classList.add('light');
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — EduTech Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class="dashboard-body" data-page-roles={roles.join(" ")}>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <a href="/" class="sidebar-logo">
          <div class="sidebar-logo-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M12 3L1 9L5 11.18V17.18L12 21L19 17.18V11.18L21 10.09V17H23V9L12 3ZM18.82 9L12 12.72L5.18 9L12 5.28L18.82 9ZM17 15.99L12 18.72L7 15.99V12.27L12 15L17 12.27V15.99Z" fill="white"/>
            </svg>
          </div>
          <span class="sidebar-brand">Edu<span class="sidebar-accent">Tech</span></span>
        </a>
        <button class="sidebar-close" id="sidebar-close" aria-label="Close sidebar">✕</button>
      </div>

      <!-- User Info -->
      <div class="sidebar-user">
        <div class="sidebar-avatar" id="sidebarAvatar">?</div>
        <div class="sidebar-user-info">
          <p class="sidebar-user-name" id="sidebarName">Memuat...</p>
          <span class="sidebar-role-badge" id="sidebarRole">—</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-section">
          <p class="nav-section-title">Menu Utama</p>
          <a href="/dashboard" class={`sidebar-link ${activeMenu === 'dashboard' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Ringkasan
          </a>
        </div>

        <div class="nav-section">
          <p class="nav-section-title">Aksi Cepat</p>
          <a href="/dashboard/news/create" class={`sidebar-link sidebar-link-action ${activeMenu === 'create-news' ? 'active' : ''}`}>
            <div class="action-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
            <span>Tulis Berita</span>
          </a>
        </div>

        <div class="nav-section">
          <p class="nav-section-title">Manajemen Konten</p>
          <a href="/dashboard/news" class={`sidebar-link ${activeMenu === 'news' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Kelola Berita
          </a>
          <a href="/dashboard/categories" data-roles="admin" hidden class={`sidebar-link ${activeMenu === 'categories' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            Kelola Kategori
          </a>
          <a href="/dashboard/banners" data-roles="admin" hidden class={`sidebar-link ${activeMenu === 'banners' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            Kelola Poster
          </a>
          <a href="/dashboard/videos" data-roles="admin editor" hidden class={`sidebar-link ${activeMenu === 'videos' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="3"/><polygon points="10 9 15 12 10 15 10 9"/></svg>
            Kelola Video
          </a>
          <a href="/dashboard/comments" data-roles="admin" hidden class={`sidebar-link ${activeMenu === 'comments' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Analisis Komentar
          </a>
        </div>

        <div class="nav-section">
          <p class="nav-section-title">Tim Redaksi</p>
          <a href="/dashboard/users" data-roles="admin" hidden class={`sidebar-link ${activeMenu === 'users' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Akun Redaksi
          </a>
          <a href="/dashboard/activity" class={`sidebar-link ${activeMenu === 'activity' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Riwayat Aktivitas
          </a>
        </div>

        <div class="nav-section">
          <p class="nav-section-title">Event</p>
          <a href="/dashboard/events" data-roles="admin" hidden class={`sidebar-link ${activeMenu === 'events' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Kelola Event
          </a>
          <a href="/dashboard/registrations" data-roles="admin" hidden class={`sidebar-link ${activeMenu === 'registrations' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
            Pendaftaran
          </a>
        </div>

        <div class="nav-section">
          <p class="nav-section-title">Situs</p>
          <a href="/dashboard/pages" data-roles="admin" hidden class={`sidebar-link ${activeMenu === 'pages' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
            Halaman Informasi
          </a>
          <a href="/dashboard/settings" data-roles="admin" hidden class={`sidebar-link ${activeMenu === 'settings' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-2.82 1.17V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 7 19.4l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 3 15H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6V4a2 2 0 1 1 4 0v.09A1.65 1.65 0 0 0 15 4.6l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9H21a2 2 0 1 1 0 4h-.09A1.65 1.65 0 0 0 19.4 15z"/></svg>
            Pengaturan Situs
          </a>
        </div>

        <div class="nav-section nav-bottom">
          <a href="/" class="sidebar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Beranda Portal
          </a>
          <button class="sidebar-link sidebar-logout" id="logout-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Keluar
          </button>
        </div>
      </nav>
    </aside>

    <!-- Overlay -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <!-- Main Content -->
    <div class="dashboard-main">
      <!-- Top bar -->
      <header class="dashboard-header">
        <button class="header-menu-btn" id="header-menu-btn" aria-label="Toggle menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <h1 class="header-title">{title}</h1>
        <div class="header-actions">
          <button id="theme-toggle" class="header-action-btn" title="Ganti Mode">
            <svg class="sun-icon" style="display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <a href="/" class="header-action-btn" title="Lihat Portal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <div class="header-avatar" id="headerAvatar" title="">?</div>
        </div>
      </header>

      <div class="dashboard-content">
        <slot />
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* Elemen khusus peran (halaman memakai class ini) */
  body:not([data-role="admin"]) .admin-only,
  body:not([data-role="admin"]):not([data-role="editor"]) .editor-only {
    display: none !important;
  }

  .dashboard-body {
    margin: 0;
    display: flex;
    min-height: 100vh;
    background: var(--color-bg-primary);
    font-family: var(--font-sans);
  }

  /* === SIDEBAR === */
  .sidebar {
    width: 260px;
    background: var(--color-bg-secondary);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    min-height: 100vh;
    z-index: 200;
    transition: transform 0.3s ease;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .sidebar::-webkit-scrollbar {
    display: none;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .sidebar-logo-icon {
    width: 36px; height: 36px;
    background: var(--color-accent);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .sidebar-brand {
    font-size: 18px; font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.3px;
  }
  .sidebar-accent { color: var(--color-accent); }

  .sidebar-close {
    display: none;
    background: none; border: none;
    color: var(--color-text-muted); cursor: pointer;
    font-size: 18px; padding: 4px;
  }

  .sidebar-user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-avatar {
    width: 40px; height: 40px;
    background: linear-gradient(135deg, var(--color-accent), #c1121f);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 800; color: white;
    flex-shrink: 0;
  }

  .sidebar-user-name {
    font-size: 14px; font-weight: 600;
    color: var(--color-text-primary);
    margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .sidebar-role-badge {
    font-size: 11px; font-weight: 700;
    background: rgba(230,57,70,0.15); color: var(--color-accent);
    padding: 2px 8px; border-radius: 20px;
    display: inline-block; margin-top: 2px;
  }

  .sidebar-nav { flex: 1; padding: 12px 12px 20px; display: flex; flex-direction: column; }

  .nav-section { margin-bottom: 8px; }

  .nav-section-title {
    font-size: 10px; font-weight: 700; letter-spacing: 0.08em;
    color: var(--color-text-muted); text-transform: uppercase;
    padding: 8px 10px 4px; margin: 0;
  }

  .sidebar-link[hidden],
  .nav-section[hidden] {
    display: none !important;
  }

  .sidebar-link {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; border-radius: 8px;
    font-size: 13.5px; font-weight: 500;
    color: var(--color-text-secondary);
    transition: all 0.15s; cursor: pointer;
    border: none; background: none; width: 100%;
    text-decoration: none; text-align: left; font-family: var(--font-sans);
  }

  .sidebar-link svg { width: 16px; height: 16px; flex-shrink: 0; opacity: 0.7; }
  .sidebar-link:hover { background: var(--color-surface); color: var(--color-text-primary); }
  .sidebar-link:hover svg { opacity: 1; }
  .sidebar-link.active { background: rgba(230,57,70,0.12); color: var(--color-accent); font-weight: 600; }
  .sidebar-link.active svg { opacity: 1; color: var(--color-accent); }

  .sidebar-link-action {
    background: rgba(230, 57, 70, 0.08);
    color: var(--color-accent);
    font-weight: 600;
    border: 1px dashed rgba(230, 57, 70, 0.35);
  }
  .sidebar-link-action:hover {
    background: var(--color-accent);
    color: white;
  }
  .action-icon-wrap {
    width: 22px;
    height: 22px;
    background: var(--color-accent);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .action-icon-wrap svg {
    width: 14px;
    height: 14px;
    stroke: white !important;
    opacity: 1 !important;
  }
  .sidebar-link-action:hover .action-icon-wrap {
    background: white;
  }
  .sidebar-link-action:hover .action-icon-wrap svg {
    stroke: var(--color-accent) !important;
  }

  .nav-bottom { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--color-border); }

  .sidebar-logout { color: var(--color-text-muted); }
  .sidebar-logout:hover { background: rgba(239,68,68,0.1); color: #ef4444; }

  /* === MAIN === */
  .dashboard-main {
    flex: 1;
    min-width: 0;
    margin-left: 260px;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .dashboard-header {
    position: sticky; top: 0; z-index: 100;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    display: flex; align-items: center; gap: 16px;
    padding: 0 24px; height: 60px;
    box-shadow: 0 1px 0 var(--color-border);
  }

  .header-menu-btn {
    display: none; background: none; border: none;
    color: var(--color-text-secondary); cursor: pointer;
    width: 34px; height: 34px; border-radius: 8px;
    align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .header-menu-btn svg { width: 18px; height: 18px; }
  .header-menu-btn:hover { background: var(--color-surface); }

  .header-title {
    font-size: 15px; font-weight: 600;
    color: var(--color-text-primary); margin: 0; flex: 1;
  }

  .header-actions { display: flex; align-items: center; gap: 8px; }

  .header-action-btn {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 8px;
    color: var(--color-text-muted); transition: all 0.15s; background: none; border: none; cursor: pointer;
  }
  .header-action-btn svg { width: 16px; height: 16px; }
  .header-action-btn:hover { background: var(--color-surface); color: var(--color-text-primary); }

  :global(html.light) .moon-icon { display: none; }
  :global(html.light) .sun-icon { display: block !important; }

  .header-avatar {
    width: 32px; height: 32px;
    background: linear-gradient(135deg, var(--color-accent), #c1121f);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 800; color: white; cursor: pointer;
  }

  .dashboard-content { flex: 1; padding: 24px; }

  /* Overlay */
  .sidebar-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.5); z-index: 150;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .sidebar { transform: translateX(-100%); }
    .sidebar.open { transform: translateX(0); }
    .sidebar-close { display: flex; }
    .sidebar-overlay.open { display: block; }
    .dashboard-main { margin-left: 0; }
    .header-menu-btn { display: flex; }
  }

  /* Dashboard Card Styles */
  .dash-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
  }

  .dash-card-title {
    font-size: 13px; font-weight: 700; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--color-text-muted);
    margin: 0 0 16px;
  }
</style>

<script>
  import { API_BASE as API_GO } from '../lib/config';

  // Client-side auth guard
  (async () => {
    try {
      const res = await fetch(`${API_GO}/auth/profile`, { credentials: 'include' });
      if (!res.ok) { window.location.href = '/login'; return; }
      const user = await res.json();
      const ROLE_LABEL: Record<string, string> = { admin: 'Admin', editor: 'Editor', penulis: 'Penulis' };
      if (!ROLE_LABEL[user.role]) { window.location.href = '/user'; return; }
      const pageRoles = (document.body.dataset.pageRoles || 'admin').split(' ');
      if (!pageRoles.includes(user.role)) { window.location.href = '/dashboard'; return; }
      document.body.dataset.role = user.role;

      // Menu sesuai peran; bagian yang kosong disembunyikan
      document.querySelectorAll<HTMLElement>('.sidebar-nav [data-roles]').forEach((link) => {
        link.hidden = !(link.dataset.roles || '').split(' ').includes(user.role);
      });
      document.querySelectorAll<HTMLElement>('.sidebar-nav .nav-section').forEach((section) => {
        const links = [...section.querySelectorAll<HTMLElement>('.sidebar-link')];
        section.hidden = links.length > 0 && links.every((l) => l.hidden);
      });
      (window as any).__staff = user;
      document.dispatchEvent(new CustomEvent('staff-ready', { detail: user }));

      // Populate user info in sidebar and header
      const avatarInitial = (user.name || 'U').charAt(0).toUpperCase();
      const sidebarAvatar = document.getElementById('sidebarAvatar');
      const sidebarName = document.getElementById('sidebarName');
      const sidebarRole = document.getElementById('sidebarRole');
      const headerAvatar = document.getElementById('headerAvatar');

      if (sidebarAvatar) sidebarAvatar.textContent = avatarInitial;
      if (sidebarName) sidebarName.textContent = user.name || '';
      if (sidebarRole) sidebarRole.textContent = ROLE_LABEL[user.role];
      if (headerAvatar) {
        headerAvatar.textContent = avatarInitial;
        headerAvatar.title = user.name || '';
      }
    } catch {
      window.location.href = '/login';
    }
  })();

  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const menuBtn = document.getElementById('header-menu-btn');
  const closeBtn = document.getElementById('sidebar-close');
  const logoutBtn = document.getElementById('logout-btn');

  function openSidebar() {
    if (sidebar) sidebar.classList.add('open');
    if (overlay) overlay.classList.add('open');
  }
  function closeSidebar() {
    if (sidebar) sidebar.classList.remove('open');
    if (overlay) overlay.classList.remove('open');
  }

  if (menuBtn) menuBtn.addEventListener('click', openSidebar);
  if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
  if (overlay) overlay.addEventListener('click', closeSidebar);

  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      await fetch(`${API_GO}/auth/logout`, { method: 'POST', credentials: 'include' });
      window.location.href = '/';
    });
  }

  // Theme Toggle
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      document.documentElement.classList.toggle('light');
      const isLight = document.documentElement.classList.contains('light');
      localStorage.setItem('edutech-theme', isLight ? 'light' : 'dark');
    });
  }
</script>
