---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import NewsCard from "../../../components/NewsCard.astro";
import TrendingNews from "../../../components/TrendingNews.astro";
import Footer from "../../../components/Footer.astro";
import { getCategories, getNewsPage, getTrending } from "../../../lib/news";

const PAGE_SIZE = 24;
const category = Astro.params.category as string;
const pageParam = Astro.params.page ?? "";
const currentPage = pageParam === "" ? 1 : Number(pageParam);
// /kategori/x/1 → /kategori/x; nomor halaman tidak sah → 404
if (pageParam === "1") return Astro.redirect(`/kategori/${category}`, 301);
if (!Number.isInteger(currentPage) || currentPage < 1 || String(currentPage) !== (pageParam || "1")) return Astro.rewrite("/404");

const [trendingNews, categories, list] = await Promise.all([
  getTrending(),
  getCategories(),
  getNewsPage(`/news?lite=1&limit=${PAGE_SIZE}&offset=${(currentPage - 1) * PAGE_SIZE}&category=${encodeURIComponent(category)}`),
]);
const lastPage = Math.max(1, Math.ceil(list.total / PAGE_SIZE));
const known = category === "semua" || categories.some((c) => c.slug === category);
if ((!known && list.total === 0) || currentPage > lastPage) return Astro.rewrite("/404");

const page = { data: list.items, total: list.total, currentPage, lastPage };
const displayCategory =
  category === "semua" ? "Semua Berita" : categories.find((c) => c.slug === category)?.name || list.items[0]?.category || category;

const current = categories.find((c) => c.slug === category);
const parent = current && categories.find((c) => c.id === current.parentId);
const children = current ? categories.filter((c) => c.parentId === current.id) : [];
const topLevel = categories.filter((c) => c.parentId === null && c.slug !== category);

const pageUrl = (n: number) => `/kategori/${category}${n > 1 ? `/${n}` : ""}`;
const pageNumbers: Array<number | null> = [];
for (let n = 1; n <= page.lastPage; n++) {
  if (n === 1 || n === page.lastPage || Math.abs(n - page.currentPage) <= 2) pageNumbers.push(n);
  else if (pageNumbers[pageNumbers.length - 1] !== null) pageNumbers.push(null);
}

const categoryIcons: Record<string, string> = {
  pendidikan: "🎓",
  "perguruan-tinggi": "🏫",
  unsoed: "🏫",
  artikel: "📝",
  "jateng-diy": "📍",
  purbalingga: "📍",
  banyumas: "📍",
  banjarnegara: "📍",
  cilacap: "📍",
  pariwisata: "🏞️",
  "destinasi-wisata": "🏞️",
  hotel: "🏨",
  kuliner: "🍜",
  advertorial: "📣",
  edutube: "🎬",
};
const iconFor = (slug: string) => categoryIcons[slug] || "📰";
---

<Layout
  title={`${displayCategory}${page.currentPage > 1 ? ` (halaman ${page.currentPage})` : ""} — EduTech News Portal`}
  description={`Kumpulan berita dan artikel terbaru seputar ${displayCategory} di EduTech News Portal.`}
>
  <Navbar />

  <!-- Category Header -->
  <div class="category-hero">
    <div class="container category-hero-inner">
      <div class="category-icon-big">{iconFor(category)}</div>
      <div>
        <div class="breadcrumb-mini">
          <a href="/">Beranda</a>
          <span>›</span>
          {parent && (
            <>
              <a href={`/kategori/${parent.slug}`}>{parent.name}</a>
              <span>›</span>
            </>
          )}
          <span>{displayCategory}</span>
        </div>
        <h1 class="category-page-title">{displayCategory}</h1>
        <p class="category-count">
          {page.total.toLocaleString("id-ID")} artikel{page.lastPage > 1 && ` · halaman ${page.currentPage} dari ${page.lastPage}`}
        </p>
        {children.length > 0 && (
          <div class="sub-categories">
            {children.map((c) => (
              <a href={`/kategori/${c.slug}`}>{c.name}</a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <main id="main-content" class="container category-layout">
    <!-- Articles Grid -->
    <section class="category-articles" aria-label={`Berita ${displayCategory}`}>
      {
        page.data.length === 0 ? (
          <div class="empty-category">
            <div class="empty-icon">📭</div>
            <h2>Belum Ada Berita</h2>
            <p>Tidak ada berita dalam kategori "{displayCategory}" saat ini.</p>
            <a href="/" class="back-home">
              ← Kembali ke Beranda
            </a>
          </div>
        ) : (
          <div class="articles-grid">
            {page.data.map((article: any) => (
              <NewsCard
                title={article.title}
                slug={article.slug}
                excerpt={article.excerpt}
                imageUrl={article.imageUrl}
                category={article.category}
                author={article.author}
                viewCount={article.viewCount}
                readTime={article.readTime}
                createdAt={article.createdAt}
                size="md"
              />
            ))}
          </div>
        )
      }

      {page.lastPage > 1 && (
        <nav class="pagination" aria-label="Halaman berita">
          {page.currentPage > 1 && <a href={pageUrl(page.currentPage - 1)} rel="prev">← Sebelumnya</a>}
          {pageNumbers.map((n) =>
            n === null ? (
              <span class="gap">…</span>
            ) : (
              <a href={pageUrl(n)} class:list={[{ active: n === page.currentPage }]} aria-current={n === page.currentPage ? "page" : undefined}>{n}</a>
            ),
          )}
          {page.currentPage < page.lastPage && <a href={pageUrl(page.currentPage + 1)} rel="next">Berikutnya →</a>}
        </nav>
      )}
    </section>

    <!-- Trending Sidebar -->
    <aside class="category-sidebar">
      <TrendingNews trending={trendingNews} />

      <!-- Other Categories -->
      <div class="other-categories">
        <div class="section-header" style="margin-top: var(--space-5)">
          <h2>Kategori Lain</h2>
        </div>
        <div class="other-cat-list">
          {
            topLevel.map((cat) => (
              <a href={`/kategori/${cat.slug}`} class="other-cat-link">
                <span>{iconFor(cat.slug)}</span>
                <span>{cat.name}</span>
              </a>
            ))
          }
        </div>
      </div>
    </aside>
  </main>

  <Footer />
</Layout>

<style>
  /* Hero */
  .category-hero {
    background: linear-gradient(
      135deg,
      var(--color-bg-secondary) 0%,
      var(--color-bg-card) 100%
    );
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-8) 0;
  }

  .category-hero-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .category-icon-big {
    font-size: 3rem;
    line-height: 1;
  }

  .breadcrumb-mini {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .breadcrumb-mini a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .breadcrumb-mini a:hover {
    color: var(--color-accent);
  }

  .category-page-title {
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-text-primary);
    line-height: 1.1;
  }

  .category-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: 4px;
  }

  /* Layout */
  .category-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }

  /* Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .articles-grid > :global(*) {
    min-width: 0;
  }

  .sub-categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .sub-categories a,
  .pagination a {
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .sub-categories a:hover,
  .pagination a:hover,
  .pagination a.active {
    background: #c2560c;
    border-color: #c2560c;
    color: white;
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }

  .pagination .gap {
    color: var(--color-text-muted);
  }

  /* Empty State */
  .empty-category {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: var(--space-4);
  }

  .empty-category h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .empty-category p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
  }

  .back-home {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: var(--text-sm);
    transition: background var(--transition-fast);
  }

  .back-home:hover {
    background: var(--color-accent-hover);
    color: white;
  }

  /* Sidebar */
  .category-sidebar {
    position: sticky;
    top: calc(var(--navbar-height) + var(--space-4));
  }

  /* Other Categories */
  .other-cat-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .other-cat-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    transition: all var(--transition-fast);
    font-weight: 500;
  }

  .other-cat-link:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .category-layout {
      grid-template-columns: 1fr;
    }
    .category-sidebar {
      position: static;
    }
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
