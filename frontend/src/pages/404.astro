---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Halaman Tidak Ditemukan — EduTech News Portal">
  <Navbar />
  <main id="main-content" class="container not-found">
    <h1>Halaman Tidak Ditemukan</h1>
    <p>Halaman yang Anda cari mungkin sudah dipindahkan atau dihapus.</p>
    <div class="nf-links">
      <a href="/">← Kembali ke Beranda</a>
      <a href="/cari">Cari Berita</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found { text-align: center; padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .not-found h1 { font-size: var(--text-3xl); font-weight: 900; color: var(--color-text-primary); margin-bottom: var(--space-3); }
  .not-found p { color: var(--color-text-secondary); margin-bottom: var(--space-5); }
  .nf-links { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; }
  .nf-links a { padding: var(--space-3) var(--space-5); border-radius: var(--radius-md); background: var(--color-accent); color: white; font-weight: 600; font-size: var(--text-sm); }
</style>

<script>
  // Alamat WordPress lama: /<slug>/, /<kategori>/<slug>/, /category/<x>/, /tag/<x>/
  import { API_BASE } from "../lib/config";

  const segs = location.pathname.split("/").filter(Boolean);
  const last = segs[segs.length - 1] || "";
  if (segs[0] === "category" && segs.length > 1) {
    location.replace(`/kategori/${last}`);
  } else if (segs[0] === "tag" && segs.length > 1) {
    location.replace(`/cari?tag=${encodeURIComponent(decodeURIComponent(last).replace(/-/g, " "))}`);
  } else if (last && segs[0] !== "kategori") {
    fetch(`${API_BASE}/news/resolve/${last}`)
      .then(async (res) => {
        if (!res.ok) return;
        const target = `/berita/${(await res.json()).slug}`;
        if (target !== location.pathname.replace(/\/$/, "")) location.replace(target);
      })
      .catch(() => {});
  }
</script>
