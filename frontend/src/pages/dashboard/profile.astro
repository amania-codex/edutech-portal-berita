---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getSessionFromRequest } from '../../lib/session';

const session = await getSessionFromRequest(Astro.request);
if (!session) return Astro.redirect('/login');

const user = {
  id: session.userId,
  name: session.name || 'User',
  email: session.email || '',
  role: session.role || 'user',
  avatar: null as string | null,
  created_at: new Date().toISOString(),
  bio: 'Pengguna portal berita EduTech.'
};
---

<DashboardLayout title="Profil Saya" activeMenu="profile">
  <div class="profile-container">
    <div class="dash-card profile-card">
      <div class="profile-header">
        <div class="profile-avatar-large">
          {user.avatar ? (
            <img src={user.avatar} alt={user.name} />
          ) : (
            <span>{user.name.charAt(0).toUpperCase()}</span>
          )}
        </div>
        <div class="profile-info">
          <h2 class="profile-name">{user.name}</h2>
          <p class="profile-email">{user.email}</p>
          <span class="profile-role">{user.role === 'admin' ? 'Administrator' : 'Pengguna Aktif'}</span>
        </div>
      </div>

      <div class="profile-details">
        <div class="detail-group">
          <h3 class="detail-title">Informasi Akun</h3>
          <p class="detail-text"><strong>Bergabung Sejak:</strong> {new Date(user.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
          <p class="detail-text"><strong>Bio:</strong> {user.bio || 'Belum ada bio.'}</p>
        </div>

        <button class="btn-secondary mt-4">Edit Profil (Segera Hadir)</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .profile-container { max-width: 800px; margin: 0 auto; }
  .dash-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; padding: 30px; }
  
  .profile-header { display: flex; align-items: center; gap: 24px; border-bottom: 1px solid var(--color-border); padding-bottom: 24px; margin-bottom: 24px; }
  .profile-avatar-large {
    width: 100px; height: 100px; border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent), #c1121f);
    display: flex; align-items: center; justify-content: center;
    font-size: 40px; font-weight: 800; color: white; overflow: hidden;
  }
  .profile-avatar-large img { width: 100%; height: 100%; object-fit: cover; }
  
  .profile-name { font-size: 24px; font-weight: 700; color: var(--color-text-primary); margin: 0 0 4px; }
  .profile-email { font-size: 14px; color: var(--color-text-muted); margin: 0 0 12px; }
  .profile-role {
    font-size: 11px; font-weight: 700; padding: 4px 12px;
    background: rgba(230,57,70,0.1); color: var(--color-accent);
    border-radius: 20px; display: inline-block;
  }

  .detail-group { display: flex; flex-direction: column; gap: 12px; }
  .detail-title { font-size: 15px; font-weight: 600; color: var(--color-text-primary); margin: 0 0 8px; }
  .detail-text { font-size: 14px; color: var(--color-text-secondary); margin: 0; line-height: 1.6; }
  .detail-text strong { color: var(--color-text-primary); }

  .mt-4 { margin-top: 24px; }
  .btn-secondary {
    padding: 10px 20px; border-radius: 8px; font-size: 13.5px; font-weight: 600;
    cursor: not-allowed; border: 1.5px solid var(--color-border);
    background: var(--color-surface); color: var(--color-text-muted);
  }
</style>
