---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Kelola Kategori" activeMenu="categories">
  <div class="dashboard-header-flex">
    <div>
      <h2 class="page-title">Manajemen Kategori</h2>
      <p class="page-subtitle">Kelola kategori yang tersedia untuk berita dan artikel.</p>
    </div>
    <button class="btn btn-primary" id="btn-add-category">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      Tambah Kategori
    </button>
  </div>

  <div class="dash-card mt-6">
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nama Kategori</th>
            <th>Slug</th>
            <th>Artikel</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="cat-rows">
          <tr><td colspan="5" class="text-center empty-state">Memuat kategori...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Tambah/Edit Kategori -->
  <div class="modal-overlay" id="category-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title" id="modal-title">Tambah Kategori</h3>
        <button class="modal-close" id="modal-close">✕</button>
      </div>
      <div class="modal-body">
        <form id="category-form">
          <input type="hidden" id="cat-id" />
          <div class="form-group">
            <label class="form-label">Nama Kategori</label>
            <input type="text" id="cat-name" class="form-input" placeholder="Contoh: Teknologi" required />
          </div>
          <div class="form-group mt-4">
            <label class="form-label">Slug (Opsional)</label>
            <input type="text" id="cat-slug" class="form-input" placeholder="contoh-slug-kategori" />
            <p class="form-hint">Jika dikosongkan, slug akan dibuat otomatis dari nama.</p>
          </div>
          <div class="modal-actions mt-6">
            <button type="button" class="btn btn-outline" id="btn-cancel">Batal</button>
            <button type="submit" class="btn btn-primary" id="btn-save">Simpan</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <template id="row-template">
              <tr>
                <td class="cat-id"></td>
                <td><span class="category-name"></span></td>
                <td><span class="category-slug"></span></td>
                <td class="cat-count"></td>
                <td class="text-right actions-cell">
                  <button class="btn-icon btn-edit" title="Edit Kategori">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                  </button>
                  <button class="btn-icon btn-delete" title="Hapus Kategori">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                  </button>
                </td>
              </tr>
  </template>
</DashboardLayout>

<style>
  .dashboard-header-flex { display: flex; justify-content: space-between; align-items: flex-end; }
  .page-title { font-size: 24px; font-weight: 800; color: var(--color-text-primary); margin: 0 0 4px; }
  .page-subtitle { color: var(--color-text-secondary); margin: 0; font-size: 14px; }
  .mt-6 { margin-top: 24px; }
  .mt-4 { margin-top: 16px; }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; border: none; font-family: var(--font-sans); }
  .btn svg { width: 16px; height: 16px; }
  .btn-primary { background: var(--color-accent); color: white; }
  .btn-primary:hover { background: #c1121f; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(230,57,70,0.25); }
  .btn-outline { background: transparent; border: 1px solid var(--color-border); color: var(--color-text-primary); }
  .btn-outline:hover { background: var(--color-surface); }
  
  .btn-icon { background: none; border: none; cursor: pointer; color: var(--color-text-muted); padding: 6px; border-radius: 6px; transition: all 0.2s; }
  .btn-icon svg { width: 18px; height: 18px; }
  .btn-icon:hover { background: var(--color-surface); color: var(--color-text-primary); }
  .btn-edit:hover { color: #3b82f6; background: rgba(59,130,246,0.1); }
  .btn-delete:hover { color: #ef4444; background: rgba(239,68,68,0.1); }

  /* Table */
  .table-container { overflow-x: auto; }
  .data-table { width: 100%; border-collapse: collapse; text-align: left; }
  .data-table th { padding: 14px 16px; font-size: 13px; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 2px solid var(--color-border); }
  .data-table td { padding: 16px; font-size: 14px; color: var(--color-text-primary); border-bottom: 1px solid var(--color-border); vertical-align: middle; }
  .data-table tbody tr:hover { background: var(--color-surface); }
  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .empty-state { padding: 40px !important; color: var(--color-text-muted) !important; font-style: italic; }

  /* Modal */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.2s; backdrop-filter: blur(2px); }
  .modal-overlay.active { opacity: 1; visibility: visible; }
  .modal-content { background: var(--color-bg-card); width: 100%; max-width: 450px; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); transform: translateY(20px); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .modal-overlay.active .modal-content { transform: translateY(0); }
  .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--color-border); }
  .modal-title { margin: 0; font-size: 18px; font-weight: 700; color: var(--color-text-primary); }
  .modal-close { background: none; border: none; font-size: 18px; color: var(--color-text-muted); cursor: pointer; padding: 4px; border-radius: 4px; transition: background 0.2s; }
  .modal-close:hover { background: var(--color-surface); color: var(--color-text-primary); }
  .modal-body { padding: 24px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-label { font-size: 13px; font-weight: 600; color: var(--color-text-secondary); }
  .form-input { padding: 10px 14px; border-radius: 8px; border: 1px solid var(--color-border-light); background: var(--color-bg-primary); color: var(--color-text-primary); font-family: var(--font-sans); font-size: 14px; transition: all 0.2s; outline: none; }
  .form-input:focus { border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(230,57,70,0.1); }
  .form-hint { font-size: 12px; color: var(--color-text-muted); margin: 0; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 12px; }
</style>

<script>
  import { api, clone, el, errorText, getJSON, rowId, sendJSON, setText } from '../../../lib/client';

  const modal = el('category-modal');
  const form = el('category-form') as HTMLFormElement;

  function openModal(cat?: any) {
    el('modal-title').textContent = cat ? 'Edit Kategori' : 'Tambah Kategori';
    el('cat-id').value = cat ? rowId(cat) : '';
    el('cat-name').value = cat?.name || '';
    el('cat-slug').value = cat?.slug || '';
    modal.classList.add('active');
  }

  function closeModal() {
    modal.classList.remove('active');
    form.reset();
  }

  function message(text: string) {
    const tr = document.createElement('tr');
    const td = document.createElement('td');
    td.colSpan = 5;
    td.textContent = text;
    td.style.cssText = 'text-align:center;padding:32px';
    tr.append(td);
    el('cat-rows').replaceChildren(tr);
  }

  async function load() {
    try {
      const cats: any[] = (await getJSON('/categories?with_count=1')) || [];
      if (!cats.length) return message('Belum ada kategori yang dibuat.');
      // induk lebih dulu, diikuti sub-kategorinya
      const rows: Node[] = [];
      const add = (parent: number | null, depth: number) => {
        cats.filter((c) => (c.parentId ?? null) === parent).forEach((cat) => {
          const node = clone('row-template');
          setText(node, '.cat-id', rowId(cat));
          setText(node, '.category-name', `${depth ? '— '.repeat(depth) : ''}${cat.name}`);
          setText(node, '.category-slug', cat.slug);
          setText(node, '.cat-count', Number(cat.count || 0).toLocaleString('id-ID'));
          node.querySelector('.btn-edit')!.addEventListener('click', () => openModal(cat));
          node.querySelector('.btn-delete')!.addEventListener('click', () => remove(cat));
          rows.push(node);
          add(rowId(cat), depth + 1);
        });
      };
      add(null, 0);
      el('cat-rows').replaceChildren(...rows);
    } catch {
      message('Gagal memuat kategori. Pastikan Go Fiber backend aktif.');
    }
  }

  async function remove(cat: any) {
    if (!confirm(`Hapus kategori "${cat.name}"? Artikelnya tidak ikut terhapus.`)) return;
    const res = await api(`/categories/${rowId(cat)}`, { method: 'DELETE' }).catch(() => null);
    if (res?.ok) load();
    else alert(res ? await errorText(res, 'Gagal menghapus kategori.') : 'Terjadi kesalahan.');
  }

  el('btn-add-category').addEventListener('click', () => openModal());
  el('modal-close').addEventListener('click', closeModal);
  el('btn-cancel').addEventListener('click', closeModal);
  modal.addEventListener('click', (e: Event) => { if (e.target === modal) closeModal(); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = el('cat-id').value;
    const body = { name: el('cat-name').value.trim(), slug: el('cat-slug').value.trim() };
    const res = await sendJSON(id ? `/categories/${id}` : '/categories', id ? 'PUT' : 'POST', body).catch(() => null);
    if (res?.ok) { closeModal(); load(); }
    else alert(res ? await errorText(res, 'Gagal menyimpan kategori.') : 'Terjadi kesalahan.');
  });

  load();
</script>
