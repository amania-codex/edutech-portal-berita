---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getSessionFromRequest } from '../../../../lib/session';

const session = await getSessionFromRequest(Astro.request);
if (!session) return Astro.redirect('/login');
if (session.role !== 'admin') return Astro.redirect('/user');

const { id } = Astro.params;
const API_BASE = 'http://localhost:3000/api';
let article: any = null;
try {
  const res = await fetch(`${API_BASE}/news/${id}`);
  if (res.ok) {
    const raw = await res.json();
    article = {
      id: raw.ID || raw.id, title: raw.title, slug: raw.slug, content: raw.content || '',
      image_url: raw.imageUrl || raw.image_url || '', category: raw.category,
      tags: raw.tags || '', status: raw.status, is_featured: raw.is_featured || raw.isFeatured || 0
    };
  }
} catch(e) {}
if (!article) return Astro.redirect('/dashboard/news');
---

<DashboardLayout title="Edit Berita" activeMenu="news">
  <div class="gb-editor">
    <!-- Editor Toolbar (sticky inside content area) -->
    <div class="gb-toolbar">
      <div class="gb-toolbar-left">
        <a href="/dashboard/news" class="gb-back-btn" title="Kembali">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <div class="gb-status-group">
          <span id="save-indicator" class="save-indicator">{article.status === 'published' ? 'Terbit' : 'Draft'}</span>
          <span class="gb-breadcrumb-sep">›</span>
          <span id="breadcrumb-title" class="gb-breadcrumb-title">Edit Artikel</span>
        </div>
      </div>
      <div class="gb-toolbar-right">
        <button class="gb-btn-secondary" id="save-draft-btn">Simpan Draft</button>
        <button class="gb-btn-primary" id="publish-btn">Terbitkan</button>
        <button class="gb-icon-btn sidebar-toggle-btn" id="settings-toggle-btn" title="Pengaturan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
      </div>
    </div>

    <!-- Main Editor Area -->
    <div class="gb-layout">
      <!-- Canvas -->
      <div class="gb-canvas">
        <div class="gb-page">
          <!-- Post Title -->
          <div
            class="gb-title"
            id="post-title"
            contenteditable="true"
            data-placeholder="Tulis judul berita yang menarik..."
            spellcheck="false"
          >{article.title}</div>
          <div id="raw-html-content" style="display:none;" set:html={article.content}></div>

          <!-- Blocks -->
          <div class="gb-blocks" id="blocks-container"></div>
        </div>
      </div>

      <!-- Settings Sidebar -->
      <aside class="gb-sidebar" id="gb-sidebar">
        <!-- Tabs -->
        <div class="gb-tabs">
          <button class="gb-tab active" data-tab="post">Artikel</button>
          <button class="gb-tab" data-tab="block">Blok</button>
        </div>

        <!-- Article Settings -->
        <div class="gb-tab-content active" id="tab-post">

          <div class="sb-section">
            <button class="sb-section-toggle" data-target="sec-summary">
              <span>Ringkasan</span>
              <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <div class="sb-section-body" id="sec-summary">
              <div class="sb-field">
                <label class="sb-label">Status Publikasi</label>
                <select id="status" class="sb-select">
                  <option value="draft" selected={article.status === 'draft'}>Draft</option>
                  <option value="published" selected={article.status === 'published'}>Terbitkan</option>
                </select>
              </div>
              <div class="sb-field">
                <label class="sb-label">Slug URL</label>
                <input type="text" id="slug" class="sb-input" placeholder="url-artikel-anda" value={article.slug} />
              </div>
            </div>
          </div>

          <div class="sb-section">
            <button class="sb-section-toggle" data-target="sec-category">
              <span>Kategori</span>
              <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <div class="sb-section-body" id="sec-category">
              <select id="category" class="sb-select" data-current={article.category}>
                <option value="">-- Pilih Kategori --</option>
              </select>
            </div>
          </div>

          <div class="sb-section">
            <button class="sb-section-toggle" data-target="sec-tags">
              <span>Tags</span>
              <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <div class="sb-section-body" id="sec-tags">
              <input type="text" id="tags" class="sb-input" placeholder="AI, Teknologi, Pendidikan..." value={article.tags} />
              <p class="sb-hint">Pisahkan dengan koma</p>
            </div>
          </div>

          <div class="sb-section">
            <button class="sb-section-toggle" data-target="sec-image">
              <span>Gambar Utama</span>
              <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <div class="sb-section-body" id="sec-image">
              <!-- Drop zone -->
              <div class="feat-upload-zone" id="feat-upload-zone" style={article.image_url ? 'display:none;' : ''}>
                <input type="file" id="feat-file-input" accept="image/*" style="display:none" />
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <p class="feat-upload-label">Klik atau seret gambar ke sini</p>
                <p class="feat-upload-hint">JPG, PNG, WebP · Maks. 10MB</p>
              </div>
              <div class="feat-or-sep"><span>atau URL</span></div>
              <input type="text" id="image-url" class="sb-input" placeholder="https://..." value={article.image_url} />
              <div id="img-preview-box" style={article.image_url ? 'position:relative; border-radius:8px; overflow:hidden; margin-top:4px;' : 'display:none; position:relative; border-radius:8px; overflow:hidden; margin-top:4px;'}>
                <img id="img-preview" src={article.image_url || ''} alt="Preview" style="width:100%; max-height:140px; object-fit:cover; display:block;" />
                <button id="remove-img-btn" style="position:absolute; bottom:6px; right:6px; background:rgba(0,0,0,0.7); color:white; border:none; border-radius:5px; padding:3px 8px; font-size:11px; font-weight:600; cursor:pointer;">Hapus</button>
              </div>
              <div id="feat-upload-progress" style="display:none;" class="upload-progress">
                <div class="upload-progress-bar" id="feat-progress-bar"></div>
                <span id="feat-upload-msg">Mengunggah...</span>
              </div>
            </div>
          </div>

          <div class="sb-section">
            <button class="sb-section-toggle" data-target="sec-options">
              <span>Opsi</span>
              <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <div class="sb-section-body" id="sec-options">
              <div class="toggle-row">
                <div>
                  <p class="toggle-label">Berita Unggulan</p>
                  <p class="toggle-desc">Tampil di section featured</p>
                </div>
                <label class="toggle-sw">
                  <input type="checkbox" id="is-featured" checked={article.is_featured === 1 || article.is_featured === true} />
                  <span class="toggle-thumb"></span>
                </label>
              </div>
              <div class="toggle-row">
                <div>
                  <p class="toggle-label">Berita Trending</p>
                  <p class="toggle-desc">Tampil di sidebar trending</p>
                </div>
                <label class="toggle-sw">
                  <input type="checkbox" id="is-trending" />
                  <span class="toggle-thumb"></span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Block Settings -->
        <div class="gb-tab-content" id="tab-block">
          <div class="no-block-msg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
            <p>Pilih blok untuk melihat pengaturannya.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- Block Inserter Popup -->
  <div class="block-inserter" id="block-inserter" style="display:none">
    <div class="bi-search-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="bi-search" placeholder="Cari blok..." class="bi-search-input" />
    </div>
    <div class="bi-grid" id="bi-grid">
      <button class="bi-item" data-type="paragraph">
        <div class="bi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 4v16M7 4h10a4 4 0 0 1 0 8H7z"/></svg></div>
        <span>Paragraf</span>
      </button>
      <button class="bi-item" data-type="heading">
        <div class="bi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h16M4 6h7M4 18h7"/></svg></div>
        <span>Heading</span>
      </button>
      <button class="bi-item" data-type="image">
        <div class="bi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
        <span>Gambar</span>
      </button>
      <button class="bi-item" data-type="quote">
        <div class="bi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg></div>
        <span>Kutipan</span>
      </button>
      <button class="bi-item" data-type="list">
        <div class="bi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></div>
        <span>List</span>
      </button>
      <button class="bi-item" data-type="divider">
        <div class="bi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/></svg></div>
        <span>Garis</span>
      </button>
      <button class="bi-item" data-type="code">
        <div class="bi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></div>
        <span>Kode</span>
      </button>
      <button class="bi-item" data-type="embed">
        <div class="bi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></div>
        <span>Video</span>
      </button>
    </div>
  </div>

  <!-- Toasts -->
  <div class="toast toast-error" id="toast-error" style="display:none">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span id="toast-error-msg"></span>
  </div>
  <div class="toast toast-success" id="toast-success" style="display:none">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span id="toast-success-msg"></span>
  </div>
</DashboardLayout>

<style is:global>
  /* Override dashboard-content padding for editor */
  .dashboard-content:has(.gb-editor) {
    padding: 0 !important;
  }
</style>

<style>
  .gb-editor {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 60px);
    overflow: hidden;
  }

  /* === TOOLBAR === */
  .gb-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 16px;
    background: var(--color-bg-card);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    gap: 12px;
  }
  .gb-toolbar-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .gb-toolbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  .gb-back-btn {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    transition: all 0.15s; flex-shrink: 0;
    text-decoration: none;
  }
  .gb-back-btn:hover { color: var(--color-text-primary); border-color: var(--color-text-secondary); }
  .gb-back-btn svg { width: 16px; height: 16px; }

  .gb-status-group {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--color-text-muted); font-weight: 500;
    min-width: 0;
  }
  .gb-breadcrumb-sep { color: var(--color-border); }
  .gb-breadcrumb-title {
    color: var(--color-text-primary); font-weight: 600;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    max-width: 280px;
  }

  .save-indicator {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 3px 8px; border-radius: 4px;
    background: var(--color-surface); border: 1px solid var(--color-border);
    color: var(--color-text-muted); white-space: nowrap;
  }
  .save-indicator.saved { background: rgba(34,197,94,0.08); border-color: rgba(34,197,94,0.25); color: #16a34a; }
  .save-indicator.saving { background: rgba(59,130,246,0.08); border-color: rgba(59,130,246,0.25); color: #3b82f6; }

  .gb-icon-btn {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 6px;
    border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer; transition: all 0.15s;
  }
  .gb-icon-btn svg { width: 15px; height: 15px; }
  .gb-icon-btn:hover { color: var(--color-text-primary); border-color: var(--color-text-secondary); }
  .gb-icon-btn.active { background: rgba(225,29,72,0.08); border-color: rgba(225,29,72,0.3); color: var(--color-accent); }

  .gb-btn-secondary {
    padding: 6px 14px; border-radius: 6px;
    border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: 13px; font-weight: 600; font-family: var(--font-sans);
    cursor: pointer; transition: all 0.15s; white-space: nowrap;
  }
  .gb-btn-secondary:hover { color: var(--color-text-primary); border-color: var(--color-text-secondary); }

  .gb-btn-primary {
    padding: 6px 16px; border-radius: 6px;
    border: none; background: var(--color-accent); color: white;
    font-size: 13px; font-weight: 700; font-family: var(--font-sans);
    cursor: pointer; transition: background 0.15s; white-space: nowrap;
  }
  .gb-btn-primary:hover { background: #be123c; }

  /* === LAYOUT === */
  .gb-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* === CANVAS === */
  .gb-canvas {
    flex: 1;
    overflow-y: auto;
    padding: 32px 24px 65vh;
    background: var(--color-bg-primary);
  }

  .gb-page {
    max-width: 680px;
    margin: 0 auto;
  }

  .gb-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin-bottom: 20px;
    outline: none;
    font-family: var(--font-sans);
    word-break: break-word;
  }
  .gb-title:empty::before {
    content: attr(data-placeholder);
    color: var(--color-text-muted);
    pointer-events: none;
    font-weight: 400;
  }

  .gb-blocks {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Block Elements (dynamically injected) */
  :global(.gb-block) {
    position: relative;
    border-radius: 6px;
    border: 1px solid transparent;
    transition: border-color 0.15s;
  }
  :global(.gb-block:focus-within),
  :global(.gb-block.selected) {
    border-color: var(--color-accent);
    background: rgba(225,29,72,0.02);
  }

  :global(.gb-block-toolbar) {
    position: absolute;
    top: -36px; left: 0;
    display: none;
    align-items: center;
    gap: 1px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 7px;
    padding: 3px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    z-index: 20;
    white-space: nowrap;
  }
  :global(.gb-block:focus-within .gb-block-toolbar),
  :global(.gb-block.selected .gb-block-toolbar) {
    display: flex;
  }
  :global(.gb-tb-btn) {
    display: flex; align-items: center; justify-content: center;
    padding: 0 8px; height: 26px; border-radius: 5px;
    border: none; background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer; transition: all 0.12s;
    font-size: 11px; font-weight: 700; font-family: var(--font-sans);
  }
  :global(.gb-tb-btn svg) { width: 13px; height: 13px; }
  :global(.gb-tb-btn:hover) { background: var(--color-surface); color: var(--color-text-primary); }
  :global(.gb-tb-btn.del:hover) { background: rgba(239,68,68,0.1); color: #ef4444; }
  :global(.gb-tb-sep) { width: 1px; height: 18px; background: var(--color-border); margin: 0 1px; }
  :global(.gb-tb-type-label) {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--color-text-muted);
    padding: 0 8px; display: flex; align-items: center;
  }

  /* Block content types */
  :global(.block-para) {
    padding: 8px 10px;
    font-size: 15px; line-height: 1.75;
    color: var(--color-text-secondary);
    outline: none; min-height: 38px;
    font-family: var(--font-sans);
  }
  :global(.block-para:empty::before) {
    content: attr(data-placeholder);
    color: var(--color-text-muted); pointer-events: none;
  }

  :global(.block-heading) {
    padding: 8px 10px;
    font-weight: 800; color: var(--color-text-primary);
    outline: none; min-height: 38px;
    font-family: var(--font-sans);
  }
  :global(.block-heading[data-level="1"]) { font-size: 1.9rem; }
  :global(.block-heading[data-level="2"]) { font-size: 1.45rem; }
  :global(.block-heading[data-level="3"]) { font-size: 1.15rem; }
  :global(.block-heading:empty::before) {
    content: attr(data-placeholder);
    color: var(--color-text-muted); font-weight: 400; pointer-events: none;
  }

  :global(.block-img-wrapper) { padding: 8px 10px; text-align: center; }
  :global(.block-img-rendered-wrap) {
    position: relative; display: inline-block; width: 100%; max-width: 100%;
  }
  :global(.gb-resize-handle) {
    position: absolute; width: 12px; height: 12px; background: white;
    border: 2px solid var(--color-blue); border-radius: 50%; z-index: 20;
    opacity: 0; pointer-events: none; transition: opacity 0.2s;
  }
  :global(.gb-block.selected .gb-resize-handle) { opacity: 1; pointer-events: auto; }
  :global(.gb-resize-handle.right) { top: 50%; right: -6px; transform: translateY(-50%); cursor: ew-resize; }
  :global(.gb-resize-handle.bottom) { bottom: -6px; left: 50%; transform: translateX(-50%); cursor: ns-resize; }
  :global(.gb-resize-handle.bottom-right) { bottom: -6px; right: -6px; cursor: nwse-resize; }
  :global(.gb-block.selected .block-img-rendered-wrap::after) {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    border: 1.5px solid var(--color-blue); z-index: 10;
  }

  :global(.block-img-upload) {
    background: var(--color-surface); border: 1.5px dashed var(--color-border);
    border-radius: 8px; padding: 16px;
    display: flex; flex-direction: column; gap: 12px;
  }
  :global(.block-img-dropzone) {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 24px 16px; border-radius: 6px; border: 1.5px dashed transparent;
    background: var(--color-bg-primary); cursor: pointer; transition: all 0.2s;
  }
  :global(.block-img-dropzone:hover), :global(.block-img-dropzone.dragging) {
