</style>

<script is:inline>
  const API_BASE = 'http://localhost:3000/api';

  let blocks = [];
  let blockIdCounter = 0;
  let activeInsertAfterId = null;
  const blocksContainer = document.getElementById('blocks-container');
  const titleEl = document.getElementById('post-title');
  const blockInserter = document.getElementById('block-inserter');
  const biSearchInput = document.getElementById('bi-search');

  // ====== SIDEBAR TOGGLE ======
  const settingsToggleBtn = document.getElementById('settings-toggle-btn');
  const gbSidebar = document.getElementById('gb-sidebar');
  settingsToggleBtn.addEventListener('click', () => {
    gbSidebar.classList.toggle('hidden');
    settingsToggleBtn.classList.toggle('active');
  });

  // ====== SIDEBAR TABS ======
  document.querySelectorAll('.gb-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.gb-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.gb-tab-content').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    });
  });

  // ====== SIDEBAR SECTIONS ======
  document.querySelectorAll('.sb-section-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = document.getElementById(btn.dataset.target);
      target.classList.toggle('hidden');
      btn.classList.toggle('collapsed');
    });
  });

  // ====== TITLE SYNC ======
  titleEl.addEventListener('input', () => {
    const title = titleEl.textContent.trim();
    document.getElementById('breadcrumb-title').textContent = title || 'Artikel Baru';
    const slugEl = document.getElementById('slug');
    if (!slugEl.dataset.manual) {
      slugEl.value = title.toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').trim();
    }
  });
  document.getElementById('slug').addEventListener('input', e => e.target.dataset.manual = 'true');

  // ====== IMAGE URL PREVIEW ======
  const imageUrlInput = document.getElementById('image-url');
  const imgPreviewBox = document.getElementById('img-preview-box');
  const imgPreview = document.getElementById('img-preview');
  
  function updateImagePreview(url) {
    imgPreviewBox.style.display = url ? 'block' : 'none';
    if (url) { 
      imgPreview.src = url; 
      imgPreview.onerror = () => { imgPreviewBox.style.display = 'none'; }; 
    }
  }
  
  imageUrlInput.addEventListener('input', () => updateImagePreview(imageUrlInput.value.trim()));
  
  document.getElementById('remove-img-btn').addEventListener('click', () => {
    imageUrlInput.value = ''; updateImagePreview('');
  });

  // ====== FEATURED IMAGE UPLOAD ======
  const featUploadZone = document.getElementById('feat-upload-zone');
  const featFileInput = document.getElementById('feat-file-input');
  const featProgressEl = document.getElementById('feat-upload-progress');
  const featProgressBar = document.getElementById('feat-progress-bar');
  const featProgressMsg = document.getElementById('feat-upload-msg');

  async function uploadFeaturedImage(file) {
    featProgressEl.style.display = 'flex';
    featProgressMsg.textContent = 'Mengunggah...';
    featProgressMsg.style.color = 'var(--color-text-secondary)';
    featProgressBar.style.width = '30%';
    const formData = new FormData();
    formData.append('image', file);
    try {
      featProgressBar.style.width = '70%';
      const res = await fetch(`${API_BASE}/upload`, {
        method: 'POST', credentials: 'include', body: formData
      });
      featProgressBar.style.width = '100%';
      if (!res.ok) {
        const err = await res.json();
        featProgressMsg.textContent = err.error || 'Gagal upload';
        featProgressMsg.style.color = '#ef4444';
        return;
      }
      const data = await res.json();
      featProgressEl.style.display = 'none';
      const fullUrl = `http://localhost:3000${data.url}`;
      imageUrlInput.value = fullUrl;
      updateImagePreview(fullUrl);
    } catch {
      featProgressMsg.textContent = 'Error jaringan';
      featProgressMsg.style.color = '#ef4444';
    }
  }

  featUploadZone.addEventListener('click', () => featFileInput.click());
  featUploadZone.addEventListener('dragover', e => { e.preventDefault(); featUploadZone.classList.add('dragging'); });
  featUploadZone.addEventListener('dragleave', () => featUploadZone.classList.remove('dragging'));
  featUploadZone.addEventListener('drop', e => {
    e.preventDefault();
    featUploadZone.classList.remove('dragging');
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) uploadFeaturedImage(file);
  });
  featFileInput.addEventListener('change', () => {
    if (featFileInput.files[0]) uploadFeaturedImage(featFileInput.files[0]);
  });

  const catSelect = document.getElementById('category');
  const currentCat = catSelect.dataset.current;
  
  fetch(API_BASE + '/categories').then(r => r.json()).then(data => {
    if (Array.isArray(data)) data.forEach(cat => {
      const opt = document.createElement('option');
      opt.value = cat.name; opt.textContent = cat.name;
      if (cat.name === currentCat) opt.selected = true;
      catSelect.appendChild(opt);
    });
  }).catch(() => {});

  // ====== BLOCK INSERTER ======
  function showInserter(afterId, anchorEl) {
    activeInsertAfterId = afterId;
    const rect = anchorEl.getBoundingClientRect();
    blockInserter.style.display = 'block';
    const top = rect.bottom + 4;
    const left = Math.min(rect.left, window.innerWidth - 256 - 8);
    blockInserter.style.top = top + 'px';
    blockInserter.style.left = left + 'px';
    biSearchInput.value = '';
    filterBiGrid('');
    biSearchInput.focus();
  }

  function hideInserter() {
    blockInserter.style.display = 'none';
    activeInsertAfterId = null;
  }

  document.addEventListener('click', e => {
    if (!blockInserter.contains(e.target) && !e.target.closest('.add-block-btn')) hideInserter();
  });

  const blockTypes = [
    { type: 'paragraph', label: 'Paragraf' },
    { type: 'heading', label: 'Heading' },
    { type: 'image', label: 'Gambar' },
    { type: 'quote', label: 'Kutipan' },
    { type: 'list', label: 'List' },
    { type: 'divider', label: 'Garis' },
    { type: 'code', label: 'Kode' },
    { type: 'embed', label: 'Video' },
  ];

  function filterBiGrid(q) {
    document.querySelectorAll('.bi-item').forEach(el => {
      const type = el.dataset.type;
      const bt = blockTypes.find(b => b.type === type);
      const match = !q || (bt && bt.label.toLowerCase().includes(q.toLowerCase())) || type.includes(q.toLowerCase());
      el.style.display = match ? 'flex' : 'none';
    });
  }
  biSearchInput.addEventListener('input', () => filterBiGrid(biSearchInput.value));

  document.querySelectorAll('.bi-item').forEach(el => {
    el.addEventListener('click', () => {
      addBlock(el.dataset.type, activeInsertAfterId);
      hideInserter();
    });
  });

  // ====== CREATE BLOCK ======
  function genId() { return 'blk-' + (++blockIdCounter); }

  function makeAddBtn(afterId) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'add-block-btn';
    btn.innerHTML = `<span class="add-block-icon">+</span><span>Type / to choose a block</span>`;
    btn.addEventListener('click', e => { e.stopPropagation(); showInserter(afterId, btn); });
    return btn;
  }

  function makeToolbar(bid, type) {
    const labels = { paragraph: 'Paragraf', heading: 'Heading', image: 'Gambar', quote: 'Kutipan', list: 'List', divider: 'Garis', code: 'Kode', embed: 'Video' };
    const upSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>`;
    const downSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>`;
    const delSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>`;

    const alignLeftSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="15" y2="12"/><line x1="3" y1="18" x2="19" y2="18"/></svg>`;
    const alignCenterSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>`;
    const alignRightSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="9" y1="12" x2="21" y2="12"/><line x1="5" y1="18" x2="21" y2="18"/></svg>`;

    let headingBtns = type === 'heading' ? `
      <button class="gb-tb-btn" data-action="h1" data-bid="${bid}">H1</button>
      <button class="gb-tb-btn" data-action="h2" data-bid="${bid}">H2</button>
      <button class="gb-tb-btn" data-action="h3" data-bid="${bid}">H3</button>
      <div class="gb-tb-sep"></div>` : '';

    let imgBtns = type === 'image' ? `
      <button class="gb-tb-btn" data-action="align-left" data-bid="${bid}" title="Kiri">${alignLeftSvg}</button>
      <button class="gb-tb-btn" data-action="align-center" data-bid="${bid}" title="Tengah">${alignCenterSvg}</button>
      <button class="gb-tb-btn" data-action="align-right" data-bid="${bid}" title="Kanan">${alignRightSvg}</button>
      <div class="gb-tb-sep"></div>` : '';

    return `<div class="gb-block-toolbar">
      <span class="gb-tb-type-label">${labels[type] || type}</span>
      <div class="gb-tb-sep"></div>
      ${headingBtns}${imgBtns}
      <button class="gb-tb-btn" data-action="up" data-bid="${bid}" title="Naik">${upSvg}</button>
      <button class="gb-tb-btn" data-action="down" data-bid="${bid}" title="Turun">${downSvg}</button>
      <div class="gb-tb-sep"></div>
      <button class="gb-tb-btn del" data-action="del" data-bid="${bid}" title="Hapus">${delSvg}</button>
    </div>`;
  }

  function makeBlockEl(blockData) {
    const { id, type } = blockData;
    const wrap = document.createElement('div');
    wrap.className = 'gb-block';
    wrap.dataset.blockId = id;
    wrap.dataset.blockType = type;

    let inner = '';
    switch(type) {
      case 'paragraph':
        inner = `<div class="block-para" contenteditable="true" data-placeholder="Tulis sesuatu atau ketik '/' untuk pilih blok..." data-bid="${id}">${blockData.content || ''}</div>`;
        break;
      case 'heading':
        const lvl = blockData.level || 2;
        inner = `<div class="block-heading" contenteditable="true" data-placeholder="Heading..." data-bid="${id}" data-level="${lvl}">${blockData.content || ''}</div>`;
        break;
      case 'image':
        if (blockData.content) {
          inner = `<div class="block-img-wrapper" style="text-align:${blockData.align || 'center'};">
            <div class="block-img-rendered-wrap" style="width:${blockData.width || 100}%;">
              <img class="block-img-rendered" src="${blockData.content}" alt="" style="width:100%; height:auto; display:block;" draggable="false" />
              <button class="gb-remove-img-btn" data-action="remove-img" data-bid="${id}" title="Hapus Gambar" style="position:absolute; top:8px; right:8px; background:rgba(0,0,0,0.65); color:white; border:none; padding:6px; border-radius:6px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 0.15s; z-index:15;">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
              </button>
              <div class="gb-resize-handle right" data-dir="x"></div>
              <div class="gb-resize-handle bottom" data-dir="y"></div>
              <div class="gb-resize-handle bottom-right" data-dir="xy"></div>
            </div>
          </div>`;


        } else {
          inner = `<div class="block-img-wrapper">
            <div class="block-img-upload" data-bid="${id}">
              <input type="file" class="block-img-file" accept="image/*" style="display:none" />
              <div class="block-img-dropzone" tabindex="0">
                <svg class="block-img-dz-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <p class="block-img-dz-label">Seret gambar ke sini atau <span class="block-img-dz-browse">klik untuk pilih</span></p>
                <p class="block-img-dz-hint">JPG, PNG, WebP, GIF · Maks 10MB</p>
              </div>
              <div class="block-img-url-row">
                <span class="block-img-or">atau URL:</span>
                <input class="block-img-url-input" type="text" placeholder="https://..." data-bid="${id}" />
              </div>
              <div class="block-img-progress" style="display:none">
                <div class="block-img-progress-bar"></div>
                <span class="block-img-progress-msg">Mengunggah...</span>
              </div>
            </div>
          </div>`;
        }
        break;
      case 'quote':
        inner = `<div class="block-quote-wrap"><div class="block-quote-text" contenteditable="true" data-placeholder="Tulis kutipan di sini..." data-bid="${id}">${blockData.content || ''}</div><div class="block-quote-cite" contenteditable="true">${blockData.cite || ''}</div></div>`;
        break;
      case 'list':
        const items = Array.isArray(blockData.content) ? blockData.content : ['Item pertama'];
        const lis = items.map(i => `<li>${i}</li>`).join('');
        inner = `<div class="block-list-wrap"><ul class="block-list-el" contenteditable="true" data-bid="${id}">${lis}</ul></div>`;
        break;
      case 'divider':
        inner = `<hr class="block-hr" />`;
        break;
      case 'code':
        inner = `<div class="block-code-wrap"><div class="block-code-pre" contenteditable="true" spellcheck="false" data-bid="${id}">${blockData.content || ''}</div></div>`;
        break;
      case 'embed':
        inner = `<div class="block-embed-wrap"><input class="block-embed-input" type="text" placeholder="Tempel URL YouTube atau embed URL..." data-bid="${id}" value="${blockData.content || ''}" /></div>`;
        break;
      default:
        inner = `<div class="block-para" contenteditable="true" data-placeholder="Tulis sesuatu..." data-bid="${id}">${blockData.content || ''}</div>`;
    }

    wrap.innerHTML = makeToolbar(id, type) + inner;

    // Toolbar and remove actions
    wrap.querySelectorAll('.gb-tb-btn, .gb-remove-img-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        const { action, bid } = btn.dataset;
        if (action === 'del') deleteBlock(bid);
        else if (action === 'up') moveBlock(bid, -1);
        else if (action === 'down') moveBlock(bid, 1);
        else if (action === 'h1') setHeadingLevel(bid, 1);
        else if (action === 'h2') setHeadingLevel(bid, 2);
        else if (action === 'h3') setHeadingLevel(bid, 3);
        else if (action === 'remove-img') removeImageFromBlock(bid);
        else if (action === 'align-left') setAlign(bid, 'left');
        else if (action === 'align-center') setAlign(bid, 'center');
        else if (action === 'align-right') setAlign(bid, 'right');
      });
    });

    // Image block interactions
    const imgUpload = wrap.querySelector('.block-img-upload');
    if (imgUpload) {
      const fileInput = imgUpload.querySelector('.block-img-file');
      const dropzone = imgUpload.querySelector('.block-img-dropzone');
      const urlInput = imgUpload.querySelector('.block-img-url-input');
      const progressEl = imgUpload.querySelector('.block-img-progress');
      const progressBar = imgUpload.querySelector('.block-img-progress-bar');
      const progressMsg = imgUpload.querySelector('.block-img-progress-msg');

      async function uploadToServer(file) {
        progressEl.style.display = 'flex';
        progressMsg.textContent = 'Mengunggah...';
        progressBar.style.width = '30%';
        const formData = new FormData();
        formData.append('image', file);
        try {
          progressBar.style.width = '70%';
          const res = await fetch(`${API_BASE}/upload`, {
            method: 'POST', credentials: 'include', body: formData
          });
          progressBar.style.width = '100%';
          if (!res.ok) {
            const err = await res.json();
            progressMsg.textContent = err.error || 'Gagal upload';
            progressMsg.style.color = '#ef4444';
            return;
          }
          const data = await res.json();
          progressEl.style.display = 'none';
          const fullUrl = `http://localhost:3000${data.url}`;
          const idx = blocks.findIndex(b => b.id === id);
          if (idx !== -1) { blocks[idx].content = fullUrl; blocks[idx].width = 100; renderBlocks(); }
        } catch {
          progressMsg.textContent = 'Error jaringan';
          progressMsg.style.color = '#ef4444';
        }
      }

      // Click dropzone = open file picker
      dropzone.addEventListener('click', () => fileInput.click());
      dropzone.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });

      // Drag & drop on dropzone
      dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('dragging'); });
      dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragging'));
      dropzone.addEventListener('drop', e => {
        e.preventDefault();
        dropzone.classList.remove('dragging');
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) uploadToServer(file);
      });

      // File input change
      fileInput.addEventListener('change', () => {
        if (fileInput.files[0]) uploadToServer(fileInput.files[0]);
      });

      // URL input: Enter = load image
      urlInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const url = urlInput.value.trim();
          if (url) {
            const idx = blocks.findIndex(b => b.id === id);
            if (idx !== -1) { blocks[idx].content = url; blocks[idx].width = 100; renderBlocks(); }
          }
        }
      });
    }

    // Resize Handles Drag Logic
    const imgWrap = wrap.querySelector('.block-img-rendered-wrap');
    if (imgWrap) {
      const handles = wrap.querySelectorAll('.gb-resize-handle');
      handles.forEach(handle => {
        handle.addEventListener('mousedown', e => {
          e.preventDefault();
          e.stopPropagation();
          const startX = e.clientX;
          const startWidth = imgWrap.getBoundingClientRect().width;
          const parentWidth = imgWrap.parentElement.getBoundingClientRect().width;

          const onMouseMove = moveEvent => {
            const dx = moveEvent.clientX - startX;
            let newWidth = startWidth;
            if (handle.classList.contains('right') || handle.classList.contains('bottom-right')) {
              newWidth = startWidth + dx;
            } else if (handle.classList.contains('bottom')) {
              // optional: just scale width proportionally based on Y drag if needed,
              // but since width defines the size, we can calculate width change via aspect ratio
              // For simplicity, bottom handle dragging isn't strictly necessary for % width, but let's implement basic y-drag.
              const imgEl = imgWrap.querySelector('img');
              const ratio = imgEl.naturalWidth / imgEl.naturalHeight;
              const dy = moveEvent.clientY - e.clientY;
              newWidth = startWidth + (dy * ratio);
            }
            
            let percent = (newWidth / parentWidth) * 100;
            if (percent < 10) percent = 10;
            if (percent > 100) percent = 100;
            imgWrap.style.width = percent + '%';
          };

          const onMouseUp = () => {
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
            // Save width state
            const currentPercent = parseFloat(imgWrap.style.width);
            const idx = blocks.findIndex(b => b.id === id);
            if (idx !== -1) { blocks[idx].width = currentPercent.toFixed(1); }
          };

          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        });
      });
    }

    // Paragraph enter = new block
    const paraEl = wrap.querySelector('.block-para');
    if (paraEl) {
      paraEl.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          addBlock('paragraph', id);
        }
      });
    }

    // Focus or Click = selected
    const selectBlock = () => {
      document.querySelectorAll('.gb-block.selected').forEach(el => {
        if (el !== wrap) el.classList.remove('selected');
      });
      wrap.classList.add('selected');
    };
    wrap.addEventListener('focusin', selectBlock);
    wrap.addEventListener('mousedown', selectBlock);

    return wrap;
  }

  function setHeadingLevel(bid, level) {
    const idx = blocks.findIndex(b => b.id === bid);
    if (idx !== -1) { blocks[idx].level = level; renderBlocks(); }
  }

  function setAlign(bid, align) {
    const idx = blocks.findIndex(b => b.id === bid);
    if (idx !== -1) { blocks[idx].align = align; renderBlocks(); }
  }

  function removeImageFromBlock(bid) {
    const idx = blocks.findIndex(b => b.id === bid);
    if (idx !== -1) { blocks[idx].content = ''; renderBlocks(); }
  }

  function addBlock(type, afterId) {
    const nb = { id: genId(), type, content: type === 'list' ? ['Item pertama'] : '', level: type === 'heading' ? 2 : undefined };
    if (afterId) {
      const idx = blocks.findIndex(b => b.id === afterId);
      blocks.splice(idx !== -1 ? idx + 1 : blocks.length, 0, nb);
    } else {
      blocks.push(nb);
    }
    renderBlocks();
    setTimeout(() => {
      const el = document.querySelector(`[data-block-id="${nb.id}"] [contenteditable], [data-block-id="${nb.id}"] input`);
      if (el) el.focus();
    }, 40);
  }

  function deleteBlock(bid) {
    blocks = blocks.filter(b => b.id !== bid);
    renderBlocks();
  }

  function moveBlock(bid, dir) {
    const idx = blocks.findIndex(b => b.id === bid);
    const ni = idx + dir;
    if (ni < 0 || ni >= blocks.length) return;
    [blocks[idx], blocks[ni]] = [blocks[ni], blocks[idx]];
    renderBlocks();
  }

  function syncBlocks() {
    document.querySelectorAll('.gb-block').forEach(el => {
      const bid = el.dataset.blockId;
      const type = el.dataset.blockType;
      const idx = blocks.findIndex(b => b.id === bid);
      if (idx === -1) return;
      if (type === 'paragraph') { const ce = el.querySelector('.block-para'); if (ce) blocks[idx].content = ce.innerHTML; }
      else if (type === 'heading') { const ce = el.querySelector('.block-heading'); if (ce) { blocks[idx].content = ce.innerHTML; blocks[idx].level = parseInt(ce.dataset.level) || 2; } }
      else if (type === 'quote') { const t = el.querySelector('.block-quote-text'), c = el.querySelector('.block-quote-cite'); if (t) blocks[idx].content = t.innerHTML; if (c) blocks[idx].cite = c.innerHTML; }
      else if (type === 'list') { const le = el.querySelector('.block-list-el'); if (le) blocks[idx].content = Array.from(le.querySelectorAll('li')).map(li => li.innerHTML); }
      else if (type === 'code') { const ce = el.querySelector('.block-code-pre'); if (ce) blocks[idx].content = ce.textContent; }
      else if (type === 'image') { 
        const img = el.querySelector('.block-img-rendered'); 
        if (img) {
          blocks[idx].content = img.src; 
          const wrapEl = el.querySelector('.block-img-rendered-wrap');
          if (wrapEl) blocks[idx].width = parseFloat(wrapEl.style.width) || 100;
        }
      }
      else if (type === 'embed') { const inp = el.querySelector('.block-embed-input'); if (inp) blocks[idx].content = inp.value; }
    });
  }

  function blocksToHtml() {
    return blocks.map(b => {
      switch(b.type) {
        case 'paragraph': return `<p>${b.content || ''}</p>`;
        case 'heading': return `<h${b.level||2}>${b.content || ''}</h${b.level||2}>`;
        case 'image': 
          if (!b.content) return '';
          let margin = 'margin: 24px auto;';
          if (b.align === 'left') margin = 'margin: 24px auto 24px 0;';
          if (b.align === 'right') margin = 'margin: 24px 0 24px auto;';
          return `<figure style="width:${b.width || 100}%; max-width:100%; ${margin} text-align:${b.align||'center'};"><img src="${b.content}" alt="" style="width:100%; height:auto; border-radius:8px;" /></figure>`;
        case 'quote': return `<blockquote><p>${b.content||''}</p>${b.cite?`<cite>${b.cite}</cite>`:''}</blockquote>`;
        case 'list': return Array.isArray(b.content) ? `<ul>${b.content.map(i=>`<li>${i}</li>`).join('')}</ul>` : '';
        case 'divider': return '<hr/>';
        case 'code': return `<pre><code>${b.content||''}</code></pre>`;
        case 'embed': return b.content ? `<div class="embed"><iframe src="${b.content}" allowfullscreen></iframe></div>` : '';
        default: return `<p>${b.content||''}</p>`;
      }
    }).join('\n');
  }

  function renderBlocks() {
    blocksContainer.innerHTML = '';
    blocks.forEach(block => {
      blocksContainer.appendChild(makeBlockEl(block));
      blocksContainer.appendChild(makeAddBtn(block.id));
    });
    if (blocks.length === 0) {
      const btn = makeAddBtn(null);
      btn.querySelector('span:last-child').textContent = 'Klik untuk menambahkan blok konten pertama...';
      blocksContainer.appendChild(btn);
    }
  }

  // ====== INIT BLOCKS FROM HTML ======
  function parseHtmlToBlocks(html) {
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const parsedBlocks = [];
    doc.body.childNodes.forEach(node => {
      if (node.nodeType !== Node.ELEMENT_NODE) return;
      const tag = node.tagName.toLowerCase();
      let type = 'paragraph'; let content = ''; let level = 2; let cite = ''; let width = 100; let align = 'center';
      
      if (tag === 'p') { type = 'paragraph'; content = node.innerHTML; }
      else if (tag.match(/^h[1-6]$/)) { type = 'heading'; level = parseInt(tag[1]); content = node.innerHTML; }
      else if (tag === 'figure') {
        type = 'image';
        const img = node.querySelector('img');
        if (img) content = img.src;
        const style = node.getAttribute('style') || '';
        const wMatch = style.match(/width:\s*([\d.]+)%/);
        if (wMatch) width = parseFloat(wMatch[1]);
        const taMatch = style.match(/text-align:\s*(left|center|right)/);
        if (taMatch) align = taMatch[1];
      }
      else if (tag === 'blockquote') {
        type = 'quote';
        const p = node.querySelector('p');
        const c = node.querySelector('cite');
        if (p) content = p.innerHTML;
        if (c) cite = c.innerHTML;
      }
      else if (tag === 'ul' || tag === 'ol') {
        type = 'list';
        content = Array.from(node.querySelectorAll('li')).map(li => li.innerHTML);
      }
      else if (tag === 'hr') { type = 'divider'; }
      else if (tag === 'pre') {
        type = 'code';
        const code = node.querySelector('code');
        if (code) content = code.innerHTML;
      }
      else if (tag === 'div' && node.classList.contains('embed')) {
        type = 'embed';
        const iframe = node.querySelector('iframe');
        if (iframe) content = iframe.src;
      } else {
        type = 'paragraph'; content = node.innerHTML || node.textContent;
      }
      
      if (content || type === 'divider') {
        parsedBlocks.push({ id: genId(), type, content, level, cite, width, align });
      }
    });
    return parsedBlocks;
  }

  const rawHtmlEl = document.getElementById('raw-html-content');
  if (rawHtmlEl && rawHtmlEl.innerHTML.trim()) {
    blocks = parseHtmlToBlocks(rawHtmlEl.innerHTML);
    if (blocks.length === 0) addBlock('paragraph', null);
    else renderBlocks();
  } else {
    addBlock('paragraph', null);
  }

  // ====== SUBMIT ======
  function showToast(type, msg) {
    const el = document.getElementById('toast-' + type);
    document.getElementById('toast-' + type + '-msg').textContent = msg;
    el.style.display = 'flex';
    setTimeout(() => el.style.display = 'none', 4000);
  }

  async function submitForm(isDraft) {
    syncBlocks();
    const title = titleEl.textContent.trim();
    const htmlContent = blocksToHtml();
    
    let category = document.getElementById('category').value;
    if (!category) category = document.getElementById('category').dataset.current || '';

    if (!title) return showToast('error', 'Judul berita wajib diisi!');
    if (!htmlContent.replace(/<[^>]+>/g,'').trim()) return showToast('error', 'Konten berita wajib diisi!');
    if (!category) return showToast('error', 'Pilih kategori terlebih dahulu!');

    const indicator = document.getElementById('save-indicator');
    const publishBtn = document.getElementById('publish-btn');
    const draftBtn = document.getElementById('save-draft-btn');
    indicator.textContent = 'Menyimpan...'; indicator.className = 'save-indicator saving';
    publishBtn.disabled = true; draftBtn.disabled = true;

    const status = isDraft ? 'draft' : document.getElementById('status').value;
    const payload = {
      title,
      slug: document.getElementById('slug').value.trim() || undefined,
      content: htmlContent,
      imageUrl: imageUrlInput.value.trim(),
      category: category,
      tags: document.getElementById('tags').value.trim(),
      status,
      isFeatured: document.getElementById('is-featured').checked,
      isTrending: document.getElementById('is-trending').checked,
    };

    const articleId = window.location.pathname.split('/').filter(Boolean).pop();

    try {
      const res = await fetch(`${API_BASE}/news/${articleId}`, {
        method: 'PUT', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await res.json();
      if (!res.ok) {
        showToast('error', result.error || 'Gagal memperbarui berita.');
        indicator.textContent = 'Gagal'; indicator.className = 'save-indicator';
      } else {
        indicator.textContent = 'Tersimpan'; indicator.className = 'save-indicator saved';
        showToast('success', 'Berita berhasil diperbarui!');
        setTimeout(() => window.location.href = '/dashboard/news', 1200);
      }
    } catch {
      showToast('error', 'Terjadi kesalahan jaringan.');
      indicator.textContent = 'Gagal'; indicator.className = 'save-indicator';
    } finally {
      publishBtn.disabled = false; draftBtn.disabled = false;
    }
  }

  document.getElementById('publish-btn').addEventListener('click', () => submitForm(false));
  document.getElementById('save-draft-btn').addEventListener('click', () => submitForm(true));
</script>
