---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getSessionFromRequest } from '../../../lib/session';

const session = await getSessionFromRequest(Astro.request);
if (!session || session.role !== 'admin') return Astro.redirect('/dashboard');

const API_BASE = "http://localhost:3000/api";

let allNews: any[] = [];
try {
  const res = await fetch(`${API_BASE}/news?limit=200`);
  if (res.ok) {
    const data = await res.json();
    allNews = Array.isArray(data) ? data : (data.data || []);
  }
} catch (err) {
  console.error("Failed to fetch news:", err);
}

function normalize(a: any) {
  return {
    id: a.ID || a.id,
    title: a.title,
    slug: a.slug,
    imageUrl: a.imageUrl || a.image_url,
    category: a.category,
    author: a.author,
    status: a.status,
    viewCount: a.viewCount || a.view_count || 0,
    created_at: a.CreatedAt || a.createdAt || a.created_at,
  };
}

const normalizedNews = allNews.map(normalize);
const categories = ['Teknologi', 'Pendidikan', 'Kampus', 'Event', 'Riset', 'Loker', 'Video', 'Artikel', 'Berita'];
---

<DashboardLayout title="Kelola Berita" activeMenu="news">
  <div class="news-manager">
    <!-- Header -->
    <div class="manager-header">
      <div>
        <h2 class="manager-title">Kelola Berita</h2>
        <p class="manager-subtitle">{normalizedNews.length} artikel ditemukan</p>
      </div>
      <a href="/dashboard/news/create" class="btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tulis Berita Baru
      </a>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
      <div class="filter-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" id="search-input" placeholder="Cari berita..." />
      </div>
      <select id="status-filter" class="filter-select">
        <option value="">Semua Status</option>
        <option value="published">Terbit</option>
        <option value="draft">Draft</option>
      </select>
      <select id="category-filter" class="filter-select">
        <option value="">Semua Kategori</option>
        {categories.map(cat => <option value={cat}>{cat}</option>)}
      </select>
    </div>

    <!-- Table -->
    <div class="dash-card table-card">
      <div class="table-wrapper">
        <table class="news-table">
          <thead>
            <tr>
              <th>Berita</th>
              <th>Kategori</th>
              <th>Status</th>
              <th>Tayangan</th>
              <th>Tanggal</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody id="table-body">
            {normalizedNews.length === 0 ? (
              <tr><td colspan="6" class="empty-row">Tidak ada berita. Pastikan Go Fiber backend aktif.</td></tr>
            ) : (
              normalizedNews.map((article) => (
                <tr
                  class="news-row"
                  data-title={article.title.toLowerCase()}
                  data-status={article.status}
                  data-category={article.category}
                >
                  <td class="td-news">
                    <div class="td-news-inner">
                      {article.imageUrl ? (
                        <img src={article.imageUrl} alt={article.title} class="td-thumb" />
                      ) : (
                        <div class="td-thumb td-thumb-placeholder">📰</div>
                      )}
                      <div class="td-info">
                        <p class="td-title">{article.title}</p>
                        <p class="td-author">by {article.author}</p>
                      </div>
                    </div>
                  </td>
                  <td><span class="td-badge">{article.category}</span></td>
                  <td>
                    <span class={`td-status status-${article.status}`}>
                      {article.status === 'published' ? 'Terbit' : 'Draft'}
                    </span>
                  </td>
                  <td class="td-views">{article.viewCount}</td>
                  <td class="td-date">{article.created_at ? new Date(article.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-'}</td>
                  <td>
                    <div class="td-actions">
                      <a href={`/berita/${article.slug}`} class="action-btn action-view" target="_blank" title="Lihat">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      </a>
                      <a href={`/dashboard/news/edit/${article.id}`} class="action-btn action-edit" title="Edit">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </a>
                      <button
                        class="action-btn action-delete"
                        title="Hapus"
                        onclick={`confirmDelete(${article.id}, '${article.title.replace(/'/g, "\\'")}')`}
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Delete Confirm Modal -->
    <div class="modal-overlay" id="delete-modal" style="display:none">
      <div class="modal-box">
        <div class="modal-icon">🗑️</div>
        <h3 class="modal-title">Hapus Berita?</h3>
        <p class="modal-desc" id="modal-desc">Tindakan ini tidak dapat dibatalkan.</p>
        <div class="modal-actions">
          <button class="modal-btn modal-cancel" onclick="closeModal()">Batal</button>
          <button class="modal-btn modal-confirm" id="confirm-delete-btn">Hapus</button>
        </div>
      </div>
    </div>

    <div class="toast" id="toast" style="display:none"></div>
  </div>
</DashboardLayout>

<style>
  .news-manager { display: flex; flex-direction: column; gap: 20px; }
  .manager-header { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .manager-title { font-size: 20px; font-weight: 700; color: var(--color-text-primary); margin: 0 0 4px; }
  .manager-subtitle { font-size: 13px; color: var(--color-text-muted); margin: 0; }

  .btn-primary { display: flex; align-items: center; gap: 8px; background: var(--color-accent); color: white; padding: 10px 18px; border-radius: 10px; font-size: 13.5px; font-weight: 700; text-decoration: none; transition: all 0.15s; white-space: nowrap; }
  .btn-primary svg { width: 16px; height: 16px; }
  .btn-primary:hover { background: #c1121f; transform: translateY(-1px); }

  .filter-bar { display: flex; gap: 12px; flex-wrap: wrap; }
  .filter-search { flex: 1; min-width: 200px; display: flex; align-items: center; gap: 10px; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 10px; padding: 10px 14px; }
  .filter-search svg { width: 16px; height: 16px; color: var(--color-text-muted); flex-shrink: 0; }
  .filter-search input { flex: 1; background: none; border: none; outline: none; color: var(--color-text-primary); font-size: 13.5px; font-family: var(--font-sans); }
  .filter-search input::placeholder { color: var(--color-text-muted); }
  .filter-select { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 10px; padding: 10px 14px; color: var(--color-text-primary); font-size: 13.5px; font-family: var(--font-sans); cursor: pointer; outline: none; min-width: 150px; }

  .dash-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; }
  .table-wrapper { overflow-x: auto; }

  .news-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .news-table th { text-align: left; padding: 12px 16px; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-text-muted); border-bottom: 1px solid var(--color-border); white-space: nowrap; }
  .news-table td { padding: 12px 16px; border-bottom: 1px solid var(--color-border); vertical-align: middle; }
  .news-row:last-child td { border-bottom: none; }
  .news-row:hover td { background: var(--color-surface); }
  .news-row.hidden { display: none; }

  .td-news-inner { display: flex; align-items: center; gap: 12px; }
  .td-thumb { width: 60px; height: 44px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .td-thumb-placeholder { display: flex; align-items: center; justify-content: center; background: var(--color-surface); font-size: 20px; }
  .td-title { font-weight: 600; color: var(--color-text-primary); margin: 0 0 3px; max-width: 300px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .td-author { font-size: 11.5px; color: var(--color-text-muted); margin: 0; }

  .td-badge { background: var(--color-surface); color: var(--color-text-secondary); padding: 3px 9px; border-radius: 20px; font-size: 11px; font-weight: 600; white-space: nowrap; }
  .td-status { font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 20px; white-space: nowrap; }
  .status-published { background: rgba(34,197,94,0.12); color: #22c55e; }
  .status-draft { background: rgba(249,115,22,0.12); color: #f97316; }
  .td-views, .td-date { color: var(--color-text-muted); font-size: 12px; white-space: nowrap; }

  .td-actions { display: flex; align-items: center; gap: 6px; }
  .action-btn { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 6px; cursor: pointer; transition: all 0.15s; border: none; background: none; }
  .action-btn svg { width: 14px; height: 14px; }
  .action-view { color: #3b82f6; } .action-view:hover { background: rgba(59,130,246,0.1); }
  .action-edit { color: #f97316; } .action-edit:hover { background: rgba(249,115,22,0.1); }
  .action-delete { color: #ef4444; } .action-delete:hover { background: rgba(239,68,68,0.1); }

  .empty-row { text-align: center; color: var(--color-text-muted); padding: 40px; font-size: 13.5px; }

  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; display: flex; align-items: center; justify-content: center; }
  .modal-box { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 16px; padding: 32px; max-width: 380px; width: 90%; text-align: center; }
  .modal-icon { font-size: 40px; margin-bottom: 16px; }
  .modal-title { font-size: 18px; font-weight: 700; color: var(--color-text-primary); margin: 0 0 8px; }
  .modal-desc { font-size: 13.5px; color: var(--color-text-muted); margin: 0 0 24px; }
  .modal-actions { display: flex; gap: 12px; justify-content: center; }
  .modal-btn { padding: 10px 24px; border-radius: 8px; font-size: 13.5px; font-weight: 700; cursor: pointer; border: none; font-family: var(--font-sans); transition: all 0.15s; }
  .modal-cancel { background: var(--color-surface); color: var(--color-text-secondary); } .modal-cancel:hover { background: var(--color-border); }
  .modal-confirm { background: #ef4444; color: white; } .modal-confirm:hover { background: #dc2626; }

  .toast { position: fixed; bottom: 24px; right: 24px; background: #1e1e1e; color: white; padding: 12px 20px; border-radius: 10px; font-size: 13.5px; font-weight: 600; z-index: 2000; box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
</style>

<script define:vars={{ API_BASE: "http://localhost:3000/api" }}>
  const searchInput = document.getElementById('search-input');
  const statusFilter = document.getElementById('status-filter');
  const categoryFilter = document.getElementById('category-filter');

  function filterRows() {
    const search = searchInput.value.toLowerCase();
    const status = statusFilter.value;
    const category = categoryFilter.value;
    document.querySelectorAll('.news-row').forEach(row => {
      const title = row.dataset.title || '';
      const rowStatus = row.dataset.status || '';
      const rowCategory = row.dataset.category || '';
      const match = (!search || title.includes(search)) && (!status || rowStatus === status) && (!category || rowCategory === category);
      row.classList.toggle('hidden', !match);
    });
  }

  searchInput.addEventListener('input', filterRows);
  statusFilter.addEventListener('change', filterRows);
  categoryFilter.addEventListener('change', filterRows);

  let deleteId = null;
  const modal = document.getElementById('delete-modal');
  const modalDesc = document.getElementById('modal-desc');
  const confirmBtn = document.getElementById('confirm-delete-btn');
  const toast = document.getElementById('toast');

  function showToast(msg, isError = false) {
    toast.textContent = msg;
    toast.style.display = 'block';
    toast.style.background = isError ? '#ef4444' : '#22c55e';
    setTimeout(() => { toast.style.display = 'none'; }, 3000);
  }

  window.confirmDelete = (id, title) => {
    deleteId = id;
    modalDesc.textContent = `Hapus "${title}"? Tindakan ini tidak dapat dibatalkan.`;
    modal.style.display = 'flex';
  };

  window.closeModal = () => { modal.style.display = 'none'; deleteId = null; };

  confirmBtn.addEventListener('click', async () => {
    if (!deleteId) return;
    confirmBtn.textContent = 'Menghapus...';
    confirmBtn.disabled = true;
    try {
      // Send delete to Go Fiber backend
      const res = await fetch(`${API_BASE}/news/${deleteId}`, { method: 'DELETE' });
      if (res.ok) {
        document.querySelector(`[onclick*="confirmDelete(${deleteId}"]`)?.closest('tr')?.remove();
        showToast('Berita berhasil dihapus.');
      } else {
        showToast('Gagal menghapus berita.', true);
      }
    } catch {
      showToast('Terjadi kesalahan.', true);
    } finally {
      modal.style.display = 'none';
      deleteId = null;
      confirmBtn.textContent = 'Hapus';
      confirmBtn.disabled = false;
    }
  });
</script>
