---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getSessionFromRequest } from '../../../../lib/session';

const session = await getSessionFromRequest(Astro.request);
if (!session || session.role !== 'admin') return Astro.redirect('/dashboard');

const { id } = Astro.params;
const API_BASE = 'http://localhost:3000/api';

let article: any = null;
let comments: any[] = [];

try {
  const [articleRes, commentsRes] = await Promise.all([
    fetch(`${API_BASE}/news/${id}`),
    fetch(`${API_BASE}/comments/news/${id}`),
  ]);
  if (articleRes.ok) {
    const raw = await articleRes.json();
    article = {
      id: raw.ID || raw.id,
      title: raw.title,
      slug: raw.slug,
      category: raw.category,
      author: raw.author,
      status: raw.status,
      viewCount: raw.viewCount || raw.view_count || 0,
      imageUrl: raw.imageUrl || raw.image_url || '',
      tags: raw.tags || '',
      isFeatured: raw.isFeatured || raw.is_featured || false,
      isTrending: raw.isTrending || raw.is_trending || false,
      createdAt: raw.CreatedAt || raw.createdAt || raw.created_at,
      updatedAt: raw.UpdatedAt || raw.updatedAt || raw.updated_at,
    };
  }
  if (commentsRes.ok) {
    const raw = await commentsRes.json();
    comments = Array.isArray(raw) ? raw : [];
  }
} catch (err) {
  console.error('Failed to fetch analytics data:', err);
}

if (!article) return Astro.redirect('/dashboard/news');

const formattedCreated = article.createdAt
  ? new Date(article.createdAt).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
  : '-';

const formattedUpdated = article.updatedAt
  ? new Date(article.updatedAt).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
  : '-';

const commentCount = comments.length;
const approvedComments = comments.filter((c: any) => c.status === 'approved' || !c.status).length;
const pendingComments = comments.filter((c: any) => c.status === 'pending').length;
---

<DashboardLayout title={`Analisis: ${article.title}`} activeMenu="news">
  <div class="analytics-page">

    <!-- Header -->
    <div class="page-header">
      <a href="/dashboard/news" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Kembali ke Daftar Berita
      </a>
      <div class="header-actions">
        <a href={`/berita/${article.slug}`} target="_blank" class="btn-outline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Lihat Artikel
        </a>
        <a href={`/dashboard/news/edit/${article.id}`} class="btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Edit Berita
        </a>
      </div>
    </div>

    <!-- Article Info Card -->
    <div class="dash-card article-overview-card">
      {article.imageUrl && (
        <div class="overview-thumb-wrap">
          <img src={article.imageUrl} alt={article.title} class="overview-thumb" />
        </div>
      )}
      <div class="overview-info">
        <div class="overview-badges">
          <span class={`status-badge ${article.status === 'published' ? 'badge-published' : 'badge-draft'}`}>
            {article.status === 'published' ? '● Terbit' : '○ Draft'}
          </span>
          {article.isFeatured && <span class="status-badge badge-featured">⭐ Unggulan</span>}
          {article.isTrending && <span class="status-badge badge-trending">🔥 Trending</span>}
          <span class="status-badge badge-category">{article.category}</span>
        </div>
        <h1 class="overview-title">{article.title}</h1>
        <div class="overview-meta">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {article.author || 'Redaksi'}
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Dibuat: {formattedCreated}
          </span>
          {article.tags && (
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              {article.tags}
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="stats-grid">
      <div class="stat-card stat-views">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <div class="stat-body">
          <p class="stat-label">Total Tayangan</p>
          <p class="stat-value" id="view-count">{article.viewCount.toLocaleString('id-ID')}</p>
          <p class="stat-desc">Sejak pertama diterbitkan</p>
        </div>
      </div>

      <div class="stat-card stat-comments">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="stat-body">
          <p class="stat-label">Total Komentar</p>
          <p class="stat-value">{commentCount}</p>
          <p class="stat-desc">{approvedComments} disetujui · {pendingComments} menunggu</p>
        </div>
      </div>

      <div class="stat-card stat-engagement">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        </div>
        <div class="stat-body">
          <p class="stat-label">Rasio Komentar/Tayangan</p>
          <p class="stat-value">
            {article.viewCount > 0 ? ((commentCount / article.viewCount) * 100).toFixed(2) : '0.00'}%
          </p>
          <p class="stat-desc">Tingkat interaksi pembaca</p>
        </div>
      </div>

      <div class="stat-card stat-age">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-body">
          <p class="stat-label">Umur Artikel</p>
          <p class="stat-value" id="article-age">-</p>
          <p class="stat-desc">Terakhir diperbarui: {formattedUpdated}</p>
        </div>
      </div>
    </div>

    <!-- Comments Section -->
    <div class="dash-card comments-card">
      <div class="comments-header">
        <h2 class="comments-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Komentar Terbaru ({commentCount})
        </h2>
      </div>

      {commentCount === 0 ? (
        <div class="empty-comments">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <p>Belum ada komentar untuk artikel ini</p>
        </div>
      ) : (
        <div class="comments-list">
          {comments.slice(0, 20).map((comment: any) => (
            <div class="comment-item">
              <div class="comment-avatar">
                {(comment.name || comment.user_name || 'A')[0].toUpperCase()}
              </div>
              <div class="comment-body">
                <div class="comment-meta">
                  <span class="comment-author">{comment.name || comment.user_name || 'Anonim'}</span>
                  {comment.email && <span class="comment-email">{comment.email}</span>}
                  <span class="comment-date">
                    {comment.CreatedAt || comment.createdAt
                      ? new Date(comment.CreatedAt || comment.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })
                      : '-'}
                  </span>
                  {comment.status && (
                    <span class={`comment-status ${comment.status === 'approved' ? 'cs-approved' : 'cs-pending'}`}>
                      {comment.status}
                    </span>
                  )}
                </div>
                <p class="comment-content">{comment.content || comment.body || comment.comment || ''}</p>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

  </div>
</DashboardLayout>

<style>
  .analytics-page { display: flex; flex-direction: column; gap: 20px; }

  /* Header */
  .page-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .back-link { display: flex; align-items: center; gap: 6px; color: var(--color-text-muted); font-size: 13.5px; font-weight: 500; transition: color 0.15s; }
  .back-link svg { width: 16px; height: 16px; }
  .back-link:hover { color: var(--color-text-primary); }
  .header-actions { display: flex; gap: 10px; align-items: center; }
  .btn-outline { display: flex; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; border: 1.5px solid var(--color-border); color: var(--color-text-secondary); transition: all 0.15s; }
  .btn-outline svg { width: 14px; height: 14px; }
  .btn-outline:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .btn-primary { display: flex; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; background: var(--color-accent); color: white; transition: all 0.15s; }
  .btn-primary svg { width: 14px; height: 14px; }
  .btn-primary:hover { background: #c1121f; }

  /* Overview Card */
  .dash-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 14px; }
  .article-overview-card { display: flex; gap: 20px; padding: 20px; align-items: flex-start; }
  .overview-thumb-wrap { flex-shrink: 0; }
  .overview-thumb { width: 160px; height: 110px; object-fit: cover; border-radius: 10px; }
  .overview-info { flex: 1; min-width: 0; }
  .overview-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .status-badge { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; }
  .badge-published { background: rgba(34,197,94,0.12); color: #22c55e; }
  .badge-draft { background: rgba(249,115,22,0.12); color: #f97316; }
  .badge-featured { background: rgba(234,179,8,0.12); color: #eab308; }
  .badge-trending { background: rgba(239,68,68,0.12); color: #ef4444; }
  .badge-category { background: var(--color-surface); color: var(--color-text-secondary); }
  .overview-title { font-size: 18px; font-weight: 800; color: var(--color-text-primary); margin: 0 0 12px; line-height: 1.3; }
  .overview-meta { display: flex; flex-wrap: wrap; gap: 16px; }
  .overview-meta span { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--color-text-muted); }
  .overview-meta svg { width: 13px; height: 13px; flex-shrink: 0; }

  /* Stats Grid */
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
  .stat-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 14px; padding: 20px; display: flex; align-items: flex-start; gap: 16px; }
  .stat-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .stat-icon svg { width: 20px; height: 20px; }
  .stat-views .stat-icon { background: rgba(59,130,246,0.12); color: #3b82f6; }
  .stat-comments .stat-icon { background: rgba(168,85,247,0.12); color: #a855f7; }
  .stat-engagement .stat-icon { background: rgba(34,197,94,0.12); color: #22c55e; }
  .stat-age .stat-icon { background: rgba(249,115,22,0.12); color: #f97316; }
  .stat-label { font-size: 11.5px; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 4px; }
  .stat-value { font-size: 26px; font-weight: 900; color: var(--color-text-primary); margin: 0 0 4px; line-height: 1; font-variant-numeric: tabular-nums; }
  .stat-desc { font-size: 11.5px; color: var(--color-text-muted); margin: 0; }

  /* Comments */
  .comments-card { overflow: hidden; }
  .comments-header { padding: 18px 20px; border-bottom: 1px solid var(--color-border); }
  .comments-title { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; color: var(--color-text-primary); margin: 0; }
  .comments-title svg { width: 16px; height: 16px; color: var(--color-accent); }
  .empty-comments { padding: 48px 20px; display: flex; flex-direction: column; align-items: center; gap: 12px; color: var(--color-text-muted); }
  .empty-comments svg { width: 40px; height: 40px; opacity: 0.3; }
  .empty-comments p { font-size: 14px; margin: 0; }

  .comments-list { display: flex; flex-direction: column; }
  .comment-item { display: flex; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--color-border); transition: background 0.15s; }
  .comment-item:last-child { border-bottom: none; }
  .comment-item:hover { background: var(--color-surface); }
  .comment-avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--color-accent), #ff6b6b); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; color: white; flex-shrink: 0; }
  .comment-body { flex: 1; min-width: 0; }
  .comment-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 6px; }
  .comment-author { font-size: 13px; font-weight: 700; color: var(--color-text-primary); }
  .comment-email { font-size: 11.5px; color: var(--color-text-muted); }
  .comment-date { font-size: 11.5px; color: var(--color-text-muted); margin-left: auto; }
  .comment-status { font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
  .cs-approved { background: rgba(34,197,94,0.12); color: #22c55e; }
  .cs-pending { background: rgba(249,115,22,0.12); color: #f97316; }
  .comment-content { font-size: 13.5px; color: var(--color-text-secondary); line-height: 1.6; margin: 0; }

  @media (max-width: 768px) {
    .article-overview-card { flex-direction: column; }
    .overview-thumb { width: 100%; height: 180px; }
    .page-header { flex-direction: column; align-items: flex-start; }
  }
</style>

<script is:inline define:vars={{ createdAt: article.createdAt }}>
  // Calculate article age
  if (createdAt) {
    const created = new Date(createdAt);
    const now = new Date();
    const diffMs = now - created;
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    const ageEl = document.getElementById('article-age');
    if (ageEl) {
      if (diffDays === 0) ageEl.textContent = 'Hari ini';
      else if (diffDays === 1) ageEl.textContent = '1 hari';
      else if (diffDays < 30) ageEl.textContent = diffDays + ' hari';
      else if (diffDays < 365) ageEl.textContent = Math.floor(diffDays / 30) + ' bulan';
      else ageEl.textContent = Math.floor(diffDays / 365) + ' tahun';
    }
  }
</script>
