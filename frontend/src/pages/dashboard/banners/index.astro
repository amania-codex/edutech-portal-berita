---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const banners: any[] = [];
const activeCount = 0;
const inactiveCount = 0;
---

<DashboardLayout title="Kelola Poster" activeMenu="banners">
  <div class="banner-manager">
    <!-- Header -->
    <div class="manager-header">
      <div>
        <h2 class="page-title">Manajemen Poster & Banner</h2>
        <p class="page-subtitle">Kelola foto poster event, konferensi, dan pengumuman visual yang tampil di beranda portal.</p>
      </div>
      <button class="btn btn-primary" id="btn-add-banner">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Tambah Poster Baru
      </button>
    </div>

    <!-- Quick Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon icon-total">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div>
          <span class="stat-label">Total Poster</span>
          <span class="stat-value">{banners.length}</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon icon-active">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div>
          <span class="stat-label">Sedang Aktif (Tayang)</span>
          <span class="stat-value text-success">{activeCount}</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon icon-inactive">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
        </div>
        <div>
          <span class="stat-label">Nonaktif (Diarsipkan)</span>
          <span class="stat-value text-muted">{inactiveCount}</span>
        </div>
      </div>
    </div>

    <!-- Banner Table / Cards -->
    <div class="dash-card">
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 140px;">Preview Foto</th>
              <th>Judul Poster</th>
              <th>Tautan / Link</th>
              <th>Status</th>
              <th>Dibuat</th>
              <th class="text-right">Aksi</th>
            </tr>
          </thead>
          <tbody>
            {banners.length === 0 ? (
              <tr>
                <td colspan="6" class="text-center empty-state">
                  <div class="empty-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    <p>Belum ada poster yang ditambahkan.</p>
                    <button class="btn btn-outline btn-sm" id="btn-empty-add">Tambah Sekarang</button>
                  </div>
                </td>
              </tr>
            ) : (
              banners.map((banner: any) => {
                const imgUrl = banner.image_url?.startsWith('http')
                  ? banner.image_url
                  : `http://localhost:3000${banner.image_url}`;
                return (
                  <tr data-id={banner.id}>
                    <td>
                      <a href={imgUrl} target="_blank" rel="noopener noreferrer" class="poster-thumb-wrap" title="Klik untuk lihat ukuran penuh">
                        <img src={imgUrl} alt={banner.title} class="poster-thumb" loading="lazy" />
                        <span class="thumb-zoom">🔍</span>
                      </a>
                    </td>
                    <td>
                      <div class="poster-info">
                        <span class="poster-title">{banner.title}</span>
                      </div>
                    </td>
                    <td>
                      {banner.target_url ? (
                        <a href={banner.target_url} target="_blank" rel="noopener noreferrer" class="poster-link">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                          </svg>
                          <span>{banner.target_url.replace(/^https?:\/\//, '').slice(0, 30)}</span>
                        </a>
                      ) : (
                        <span class="text-muted text-sm">- Tidak ada tautan -</span>
                      )}
                    </td>
                    <td>
                      <span class={`status-badge ${banner.is_active ? 'badge-active' : 'badge-inactive'}`}>
                        <span class="badge-dot"></span>
                        {banner.is_active ? 'Aktif di Beranda' : 'Nonaktif'}
                      </span>
                    </td>
                    <td>
                      <span class="date-text">
                        {new Date(banner.created_at).toLocaleDateString('id-ID', {
                          day: 'numeric',
                          month: 'short',
                          year: 'numeric',
                        })}
                      </span>
                    </td>
                    <td class="text-right actions-cell">
                      <button
                        class={`btn-action btn-toggle ${banner.is_active ? 'active' : ''}`}
                        data-id={banner.id}
                        data-active={banner.is_active}
                        title={banner.is_active ? 'Nonaktifkan Poster' : 'Aktifkan Poster di Beranda'}
                      >
                        {banner.is_active ? 'Nonaktifkan' : 'Aktifkan'}
                      </button>
                      <button class="btn-icon btn-delete" data-id={banner.id} title="Hapus Poster">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          <line x1="10" y1="11" x2="10" y2="17"></line>
                          <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                      </button>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Tambah Poster -->
    <div class="modal-overlay" id="banner-modal">
      <div class="modal-content">
        <div class="modal-header">
          <h3 class="modal-title">Tambah Poster Foto Baru</h3>
          <button class="modal-close" id="modal-close">✕</button>
        </div>
        <div class="modal-body">
          <form id="banner-form">
            <!-- Preview Area -->
            <div class="upload-dropzone" id="dropzone">
              <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp,image/gif" class="file-hidden" />
              <div class="dropzone-empty" id="dropzone-empty">
                <div class="drop-icon">📷</div>
                <p class="drop-text"><strong>Klik untuk unggah foto poster</strong> atau seret file ke sini</p>
                <p class="drop-sub">Format: JPG, PNG, WebP (Rekomendasi rasio banner 16:9 atau 21:9)</p>
              </div>
              <div class="dropzone-preview" id="dropzone-preview" style="display: none;">
                <img id="preview-img" src="" alt="Preview Poster" />
                <button type="button" class="btn-change-img" id="btn-change-img">Ganti Foto</button>
              </div>
            </div>

            <div class="form-group mt-4">
              <label class="form-label">Atau Masukkan URL Gambar (Opsional)</label>
              <input type="url" id="banner-image-url" class="form-input" placeholder="https://example.com/poster.jpg" />
            </div>

            <div class="form-group mt-4">
              <label class="form-label">Judul Poster / Event <span class="required">*</span></label>
              <input type="text" id="banner-title" class="form-input" placeholder="Contoh: SENIKO 2026 - Seminar Nasional Informatika" required />
            </div>

            <div class="form-group mt-4">
              <label class="form-label">Tautan Tujuan / Target URL (Opsional)</label>
              <input type="url" id="banner-target-url" class="form-input" placeholder="https://seniko.id atau https://link-pendaftaran.com" />
              <p class="form-hint">Pengunjung yang mengklik banner di beranda akan dialihkan ke alamat tautan ini.</p>
            </div>

            <div class="form-check mt-4">
              <label class="check-label">
                <input type="checkbox" id="banner-is-active" checked />
                <span>Langsung aktifkan dan tampilkan di beranda</span>
              </label>
            </div>

            <div class="modal-actions mt-6">
              <button type="button" class="btn btn-outline" id="btn-cancel">Batal</button>
              <button type="submit" class="btn btn-primary" id="btn-save">
                <span id="btn-save-text">Simpan Poster</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .banner-manager {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .manager-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }

  .page-title {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 4px;
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    margin: 0;
    font-size: 14px;
  }

  /* Stats */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-icon svg {
    width: 22px;
    height: 22px;
  }

  .icon-total {
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
  }

  .icon-active {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
  }

  .icon-inactive {
    background: rgba(156, 163, 175, 0.12);
    color: #9ca3af;
  }

  .stat-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .stat-value {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .text-success { color: #10b981; }
  .text-muted { color: var(--color-text-muted); }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-family: var(--font-sans);
  }

  .btn svg { width: 16px; height: 16px; }

  .btn-primary {
    background: var(--color-accent);
    color: white;
  }

  .btn-primary:hover {
    background: #c1121f;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(230, 57, 70, 0.25);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .btn-outline:hover {
    background: var(--color-surface);
  }

  .btn-sm {
    padding: 6px 14px;
    font-size: 13px;
  }

  .btn-action {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-secondary);
    transition: all 0.2s;
  }

  .btn-action.active {
    border-color: rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }

  .btn-action.active:hover {
    background: rgba(239, 68, 68, 0.1);
  }

  .btn-action:not(.active) {
    border-color: rgba(16, 185, 129, 0.3);
    color: #10b981;
  }

  .btn-action:not(.active):hover {
    background: rgba(16, 185, 129, 0.1);
  }

  .btn-icon {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 6px;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-icon svg { width: 18px; height: 18px; }
  .btn-delete:hover { color: #ef4444; background: rgba(239, 68, 68, 0.1); }

  /* Table */
  .dash-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .data-table th {
    padding: 14px 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }

  .data-table td {
    padding: 14px 16px;
    font-size: 14px;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .data-table tbody tr:hover {
    background: var(--color-surface);
  }

  .text-right { text-align: right; }
  .text-center { text-align: center; }

  /* Thumbnail */
  .poster-thumb-wrap {
    position: relative;
    display: block;
    width: 120px;
    height: 68px;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--color-border);
  }

  .poster-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s;
  }

  .poster-thumb-wrap:hover .poster-thumb {
    transform: scale(1.05);
  }

  .thumb-zoom {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    font-size: 10px;
    padding: 2px 4px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .poster-thumb-wrap:hover .thumb-zoom {
    opacity: 1;
  }

  .poster-title {
    font-weight: 600;
    color: var(--color-text-primary);
    max-width: 320px;
    display: block;
  }

  .poster-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #3b82f6;
    text-decoration: none;
    font-size: 13px;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .poster-link:hover {
    text-decoration: underline;
  }

  /* Status Badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 600;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .badge-active {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
  }

  .badge-active .badge-dot {
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .badge-inactive {
    background: rgba(156, 163, 175, 0.12);
    color: #9ca3af;
  }

  .badge-inactive .badge-dot {
    background: #9ca3af;
  }

  .date-text {
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .actions-cell {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    min-height: 68px;
  }

  .empty-state {
    padding: 48px !important;
  }

  .empty-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--color-text-muted);
  }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s;
    backdrop-filter: blur(4px);
    padding: 20px;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-content {
    background: var(--color-bg-card);
    width: 100%;
    max-width: 540px;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    transform: translateY(20px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-overlay.active .modal-content {
    transform: translateY(0);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .modal-title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 18px;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .modal-close:hover {
    background: var(--color-surface);
    color: var(--color-text-primary);
  }

  .modal-body {
    padding: 24px;
  }

  /* Dropzone */
  .upload-dropzone {
    border: 2px dashed var(--color-border);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    cursor: pointer;
    background: var(--color-bg-primary);
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .upload-dropzone:hover {
    border-color: var(--color-accent);
    background: rgba(230, 57, 70, 0.02);
  }

  .file-hidden {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .drop-icon {
    font-size: 32px;
    margin-bottom: 8px;
  }

  .drop-text {
    margin: 0 0 4px;
    font-size: 14px;
    color: var(--color-text-primary);
  }

  .drop-sub {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .dropzone-preview {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
  }

  .dropzone-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .btn-change-img {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mt-4 { margin-top: 16px; }
  .mt-6 { margin-top: 24px; }

  .form-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .required {
    color: var(--color-accent);
  }

  .form-input {
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 14px;
    transition: all 0.2s;
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.1);
  }

  .form-hint {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .form-check {
    display: flex;
    align-items: center;
  }

  .check-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .check-label input {
    accent-color: var(--color-accent);
    width: 16px;
    height: 16px;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }
</style>

<script is:inline>
  const modal = document.getElementById('banner-modal');
  const btnAdd = document.getElementById('btn-add-banner');
  const btnEmptyAdd = document.getElementById('btn-empty-add');
  const btnClose = document.getElementById('modal-close');
  const btnCancel = document.getElementById('btn-cancel');
  const form = document.getElementById('banner-form');

  const fileInput = document.getElementById('file-input');
  const dropzoneEmpty = document.getElementById('dropzone-empty');
  const dropzonePreview = document.getElementById('dropzone-preview');
  const previewImg = document.getElementById('preview-img');
  const btnChangeImg = document.getElementById('btn-change-img');

  const inputImageUrl = document.getElementById('banner-image-url');
  const inputTitle = document.getElementById('banner-title');
  const inputTargetUrl = document.getElementById('banner-target-url');
  const inputIsActive = document.getElementById('banner-is-active');
  const btnSave = document.getElementById('btn-save');
  const btnSaveText = document.getElementById('btn-save-text');

  let uploadedImageUrl = '';

  function openModal() {
    form.reset();
    uploadedImageUrl = '';
    dropzoneEmpty.style.display = 'block';
    dropzonePreview.style.display = 'none';
    previewImg.src = '';
    modal.classList.add('active');
  }

  function closeModal() {
    modal.classList.remove('active');
  }

  if (btnAdd) btnAdd.addEventListener('click', openModal);
  if (btnEmptyAdd) btnEmptyAdd.addEventListener('click', openModal);
  btnClose.addEventListener('click', closeModal);
  btnCancel.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Handle File Upload
  fileInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const tokenMatch = document.cookie.match(/(?:^|;)\s*auth_token=([^;]*)/);
    const token = tokenMatch ? tokenMatch[1] : '';

    const formData = new FormData();
    formData.append('image', file);

    btnSaveText.textContent = 'Mengunggah Foto...';
    btnSave.disabled = true;

    try {
      const res = await fetch('http://localhost:3000/api/upload', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${token}`,
        },
        body: formData,
      });

      if (!res.ok) {
        const data = await res.json();
        alert(data.error || 'Gagal mengunggah foto.');
        return;
      }

      const data = await res.json();
      uploadedImageUrl = data.url;
      previewImg.src = `http://localhost:3000${data.url}`;
      dropzoneEmpty.style.display = 'none';
      dropzonePreview.style.display = 'block';
    } catch (err) {
      console.error(err);
      alert('Terjadi kesalahan saat upload gambar.');
    } finally {
      btnSaveText.textContent = 'Simpan Poster';
      btnSave.disabled = false;
    }
  });

  // Manual URL input preview
  inputImageUrl.addEventListener('input', (e) => {
    const val = e.target.value.trim();
    if (val) {
      uploadedImageUrl = val;
      previewImg.src = val;
      dropzoneEmpty.style.display = 'none';
      dropzonePreview.style.display = 'block';
    }
  });

  if (btnChangeImg) {
    btnChangeImg.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });
  }

  // Toggle Status logic
  document.querySelectorAll('.btn-toggle').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const id = e.currentTarget.dataset.id;
      const tokenMatch = document.cookie.match(/(?:^|;)\s*auth_token=([^;]*)/);
      const token = tokenMatch ? tokenMatch[1] : '';

      try {
        const res = await fetch(`http://localhost:3000/api/admin/banners/${id}/toggle`, {
          method: 'PUT',
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('Gagal memperbarui status poster.');
        }
      } catch (err) {
        console.error(err);
        alert('Terjadi kesalahan.');
      }
    });
  });

  // Delete logic
  document.querySelectorAll('.btn-delete').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      if (!confirm('Apakah Anda yakin ingin menghapus poster ini?')) return;

      const id = e.currentTarget.dataset.id;
      const tokenMatch = document.cookie.match(/(?:^|;)\s*auth_token=([^;]*)/);
      const token = tokenMatch ? tokenMatch[1] : '';

      try {
        const res = await fetch(`http://localhost:3000/api/admin/banners/${id}`, {
          method: 'DELETE',
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('Gagal menghapus poster.');
        }
      } catch (err) {
        console.error(err);
        alert('Terjadi kesalahan.');
      }
    });
  });

  // Save Banner Form Submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const finalImageUrl = uploadedImageUrl || inputImageUrl.value.trim();
    if (!finalImageUrl) {
      alert('Silakan unggah foto poster atau masukkan URL gambar!');
      return;
    }

    const payload = {
      title: inputTitle.value.trim(),
      image_url: finalImageUrl,
      target_url: inputTargetUrl.value.trim(),
      is_active: inputIsActive.checked,
    };

    const tokenMatch = document.cookie.match(/(?:^|;)\s*auth_token=([^;]*)/);
    const token = tokenMatch ? tokenMatch[1] : '';

    btnSaveText.textContent = 'Menyimpan...';
    btnSave.disabled = true;

    try {
      const res = await fetch('http://localhost:3000/api/admin/banners', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        const error = await res.json();
        alert(error.message || 'Gagal menyimpan poster.');
      }
    } catch (err) {
      console.error(err);
      alert('Terjadi kesalahan saat menyimpan poster.');
    } finally {
      btnSaveText.textContent = 'Simpan Poster';
      btnSave.disabled = false;
    }
  });
</script>
