---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Kelola Poster" activeMenu="banners">
  <div class="banner-manager">
    <!-- Header -->
    <div class="manager-header">
      <div>
        <h2 class="page-title">Manajemen Poster & Banner</h2>
        <p class="page-subtitle">Kelola foto poster event, konferensi, dan pengumuman visual yang tampil di beranda portal.</p>
      </div>
      <button class="btn btn-primary" id="btn-add-banner">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Tambah Poster Baru
      </button>
    </div>

    <!-- Quick Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon icon-total">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div>
          <span class="stat-label">Total Poster</span>
          <span data-n="banners" class="stat-value">0</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon icon-active">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div>
          <span class="stat-label">Sedang Aktif (Tayang)</span>
          <span data-n="active" class="stat-value text-success">0</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon icon-inactive">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
        </div>
        <div>
          <span class="stat-label">Nonaktif (Diarsipkan)</span>
          <span data-n="inactive" class="stat-value text-muted">0</span>
        </div>
      </div>
    </div>

    <!-- Banner Table / Cards -->
    <div class="dash-card">
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 140px;">Preview Foto</th>
              <th>Judul Poster</th>
              <th>Tautan / Link</th>
              <th>Status</th>
              <th>Dibuat</th>
              <th class="text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="banner-rows">
            <tr><td colspan="6" class="text-center empty-state">Memuat poster...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Tambah Poster -->
    <div class="modal-overlay" id="banner-modal">
      <div class="modal-content">
        <div class="modal-header">
          <h3 class="modal-title">Tambah Poster Foto Baru</h3>
          <button class="modal-close" id="modal-close">✕</button>
        </div>
        <div class="modal-body">
          <form id="banner-form">
            <!-- Preview Area -->
            <div class="upload-dropzone" id="dropzone">
              <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp,image/gif" class="file-hidden" />
              <div class="dropzone-empty" id="dropzone-empty">
                <div class="drop-icon">📷</div>
                <p class="drop-text"><strong>Klik untuk unggah foto poster</strong> atau seret file ke sini</p>
                <p class="drop-sub">Format: JPG, PNG, WebP (Rekomendasi rasio banner 16:9 atau 21:9)</p>
              </div>
              <div class="dropzone-preview" id="dropzone-preview" style="display: none;">
                <img id="preview-img" src="" alt="Preview Poster" />
                <button type="button" class="btn-change-img" id="btn-change-img">Ganti Foto</button>
              </div>
            </div>

            <div class="form-group mt-4">
              <label class="form-label">Atau Masukkan URL Gambar (Opsional)</label>
              <input type="url" id="banner-image-url" class="form-input" placeholder="https://example.com/poster.jpg" />
            </div>

            <div class="form-group mt-4">
              <label class="form-label">Judul Poster / Event <span class="required">*</span></label>
              <input type="text" id="banner-title" class="form-input" placeholder="Contoh: SENIKO 2026 - Seminar Nasional Informatika" required />
            </div>

            <div class="form-group mt-4">
              <label class="form-label">Tautan Tujuan / Target URL (Opsional)</label>
              <input type="url" id="banner-target-url" class="form-input" placeholder="https://seniko.id atau https://link-pendaftaran.com" />
              <p class="form-hint">Pengunjung yang mengklik banner di beranda akan dialihkan ke alamat tautan ini.</p>
            </div>

            <div class="form-check mt-4">
              <label class="check-label">
                <input type="checkbox" id="banner-is-active" checked />
                <span>Langsung aktifkan dan tampilkan di beranda</span>
              </label>
            </div>

            <div class="modal-actions mt-6">
              <button type="button" class="btn btn-outline" id="btn-cancel">Batal</button>
              <button type="submit" class="btn btn-primary" id="btn-save">
                <span id="btn-save-text">Simpan Poster</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <template id="empty-template">
              <tr>
                <td colspan="6" class="text-center empty-state">
                  <div class="empty-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    <p>Belum ada poster yang ditambahkan.</p>
                    <button class="btn btn-outline btn-sm" id="btn-empty-add">Tambah Sekarang</button>
                  </div>
                </td>
              </tr>
  </template>
  <template id="row-template">
    <tr>
      <td>
        <a target="_blank" rel="noopener noreferrer" class="poster-thumb-wrap" title="Klik untuk lihat ukuran penuh">
          <img alt="" class="poster-thumb" loading="lazy" />
          <span class="thumb-zoom">🔍</span>
        </a>
      </td>
      <td><div class="poster-info"><span class="poster-title"></span></div></td>
      <td>
        <a target="_blank" rel="noopener noreferrer" class="poster-link">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                          </svg>
                          <span></span></a>
        <span class="text-muted text-sm no-link">- Tidak ada tautan -</span>
      </td>
      <td><span class="status-badge"><span class="badge-dot"></span><span class="status-text"></span></span></td>
      <td><span class="date-text"></span></td>
      <td class="text-right actions-cell">
        <button class="btn-action btn-toggle"></button>
        <button class="btn-icon btn-delete" title="Hapus Poster">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          <line x1="10" y1="11" x2="10" y2="17"></line>
                          <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                      </button>
      </td>
    </tr>
  </template>
</DashboardLayout>

<style>
  .banner-manager {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .manager-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }

  .page-title {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 4px;
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    margin: 0;
    font-size: 14px;
  }

  /* Stats */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-icon svg {
    width: 22px;
    height: 22px;
  }

  .icon-total {
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
  }

  .icon-active {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
  }

  .icon-inactive {
    background: rgba(156, 163, 175, 0.12);
    color: #9ca3af;
  }

  .stat-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .stat-value {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .text-success { color: #10b981; }
  .text-muted { color: var(--color-text-muted); }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-family: var(--font-sans);
  }

  .btn svg { width: 16px; height: 16px; }

  .btn-primary {
    background: var(--color-accent);
    color: white;
  }

  .btn-primary:hover {
    background: #c1121f;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(230, 57, 70, 0.25);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .btn-outline:hover {
    background: var(--color-surface);
  }

  .btn-sm {
    padding: 6px 14px;
    font-size: 13px;
  }

  .btn-action {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-secondary);
    transition: all 0.2s;
  }

  .btn-action.active {
    border-color: rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }

  .btn-action.active:hover {
    background: rgba(239, 68, 68, 0.1);
  }

  .btn-action:not(.active) {
    border-color: rgba(16, 185, 129, 0.3);
    color: #10b981;
  }

  .btn-action:not(.active):hover {
    background: rgba(16, 185, 129, 0.1);
  }

  .btn-icon {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 6px;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-icon svg { width: 18px; height: 18px; }
  .btn-delete:hover { color: #ef4444; background: rgba(239, 68, 68, 0.1); }

  /* Table */
  .dash-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .data-table th {
    padding: 14px 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }

  .data-table td {
    padding: 14px 16px;
    font-size: 14px;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .data-table tbody tr:hover {
    background: var(--color-surface);
  }

  .text-right { text-align: right; }
  .text-center { text-align: center; }

  /* Thumbnail */
  .poster-thumb-wrap {
    position: relative;
    display: block;
    width: 120px;
    height: 68px;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--color-border);
  }

  .poster-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s;
  }

  .poster-thumb-wrap:hover .poster-thumb {
    transform: scale(1.05);
  }

  .thumb-zoom {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    font-size: 10px;
    padding: 2px 4px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .poster-thumb-wrap:hover .thumb-zoom {
    opacity: 1;
  }

  .poster-title {
    font-weight: 600;
    color: var(--color-text-primary);
    max-width: 320px;
    display: block;
  }

  .poster-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #3b82f6;
    text-decoration: none;
    font-size: 13px;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .poster-link:hover {
    text-decoration: underline;
  }

  /* Status Badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 600;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .badge-active {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
  }

  .badge-active .badge-dot {
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .badge-inactive {
    background: rgba(156, 163, 175, 0.12);
    color: #9ca3af;
  }

  .badge-inactive .badge-dot {
    background: #9ca3af;
  }

  .date-text {
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .actions-cell {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    min-height: 68px;
  }

  .empty-state {
    padding: 48px !important;
  }

  .empty-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--color-text-muted);
  }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s;
    backdrop-filter: blur(4px);
    padding: 20px;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-content {
    background: var(--color-bg-card);
    width: 100%;
    max-width: 540px;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    transform: translateY(20px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-overlay.active .modal-content {
    transform: translateY(0);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .modal-title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 18px;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .modal-close:hover {
    background: var(--color-surface);
    color: var(--color-text-primary);
  }

  .modal-body {
    padding: 24px;
  }

  /* Dropzone */
  .upload-dropzone {
    border: 2px dashed var(--color-border);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    cursor: pointer;
    background: var(--color-bg-primary);
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .upload-dropzone:hover {
    border-color: var(--color-accent);
    background: rgba(230, 57, 70, 0.02);
  }

  .file-hidden {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .drop-icon {
    font-size: 32px;
    margin-bottom: 8px;
  }

  .drop-text {
    margin: 0 0 4px;
    font-size: 14px;
    color: var(--color-text-primary);
  }

  .drop-sub {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .dropzone-preview {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
  }

  .dropzone-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .btn-change-img {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mt-4 { margin-top: 16px; }
  .mt-6 { margin-top: 24px; }

  .form-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .required {
    color: var(--color-accent);
  }

  .form-input {
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 14px;
    transition: all 0.2s;
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.1);
  }

  .form-hint {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .form-check {
    display: flex;
    align-items: center;
  }

  .check-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .check-label input {
    accent-color: var(--color-accent);
    width: 16px;
    height: 16px;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }
</style>

<script>
  import { api, clone, el, errorText, formatDate, getJSON, safeHref, sendJSON, setText } from '../../../lib/client';
  import { assetUrl } from '../../../lib/news';

  const modal = el('banner-modal');
  const form = el('banner-form') as HTMLFormElement;
  const fileInput = el('file-input') as HTMLInputElement;
  const dropzone = el('dropzone') as HTMLElement;
  const btnSave = el('btn-save') as HTMLButtonElement;
  let imageUrl = '';

  function preview(url: string) {
    imageUrl = url;
    el('preview-img').src = url ? assetUrl(url) : '';
    el('dropzone-empty').style.display = url ? 'none' : 'block';
    el('dropzone-preview').style.display = url ? 'block' : 'none';
  }

  function openModal() {
    form.reset();
    preview('');
    modal.classList.add('active');
  }
  const closeModal = () => modal.classList.remove('active');

  function busy(text: string | null) {
    el('btn-save-text').textContent = text || 'Simpan Poster';
    btnSave.disabled = !!text;
  }

  async function load() {
    try {
      const list: any[] = (await getJSON('/admin/banners')) || [];
      const active = list.filter((b) => b.is_active).length;
      const counts: Record<string, number> = { banners: list.length, active, inactive: list.length - active };
      document.querySelectorAll<HTMLElement>('[data-n]').forEach((n) => { n.textContent = String(counts[n.dataset.n!]); });
      if (!list.length) {
        const node = clone('empty-template');
        node.querySelector('#btn-empty-add')?.addEventListener('click', openModal);
        el('banner-rows').replaceChildren(node);
        return;
      }
      el('banner-rows').replaceChildren(...list.map((b) => {
        const node = clone('row-template');
        const src = assetUrl(b.image_url);
        const img = node.querySelector('img')!;
        img.src = src;
        img.alt = b.title;
        (node.querySelector('.poster-thumb-wrap') as HTMLAnchorElement).href = safeHref(src);
        setText(node, '.poster-title', b.title);
        if (b.target_url) {
          (node.querySelector('.poster-link') as HTMLAnchorElement).href = safeHref(b.target_url);
          setText(node, '.poster-link span', b.target_url.replace(/^https?:\/\//, '').slice(0, 30));
          node.querySelector('.no-link')!.remove();
        } else node.querySelector('.poster-link')!.remove();
        node.querySelector('.status-badge')!.classList.add(b.is_active ? 'badge-active' : 'badge-inactive');
        setText(node, '.status-text', b.is_active ? 'Aktif di Beranda' : 'Nonaktif');
        setText(node, '.date-text', formatDate(b.created_at));
        const toggle = node.querySelector('.btn-toggle') as HTMLButtonElement;
        toggle.textContent = b.is_active ? 'Nonaktifkan' : 'Aktifkan';
        toggle.classList.toggle('active', b.is_active);
        toggle.addEventListener('click', () => act(`/admin/banners/${b.id}/toggle`, 'PUT', 'Gagal memperbarui status poster.'));
        node.querySelector('.btn-delete')!.addEventListener('click', () => {
          if (confirm('Apakah Anda yakin ingin menghapus poster ini?')) act(`/admin/banners/${b.id}`, 'DELETE', 'Gagal menghapus poster.');
        });
        return node;
      }));
    } catch {
      el('banner-rows').textContent = 'Gagal memuat poster. Pastikan Go Fiber backend aktif.';
    }
  }

  async function act(path: string, method: string, fail: string) {
    const res = await api(path, { method }).catch(() => null);
    if (res?.ok) load();
    else alert(res ? await errorText(res, fail) : 'Terjadi kesalahan.');
  }

  async function upload(file?: File) {
    if (!file) return;
    const body = new FormData();
    body.append('image', file);
    busy('Mengunggah Foto...');
    try {
      const res = await api('/upload', { method: 'POST', body });
      if (res.ok) preview((await res.json()).url);
      else alert(await errorText(res, 'Gagal mengunggah foto.'));
    } catch {
      alert('Terjadi kesalahan saat upload gambar.');
    } finally {
      busy(null);
    }
  }

  el('btn-add-banner').addEventListener('click', openModal);
  el('modal-close').addEventListener('click', closeModal);
  el('btn-cancel').addEventListener('click', closeModal);
  modal.addEventListener('click', (e: Event) => { if (e.target === modal) closeModal(); });
  fileInput.addEventListener('change', () => upload(fileInput.files?.[0]));
  dropzone.addEventListener('dragover', (e) => e.preventDefault());
  dropzone.addEventListener('drop', (e) => { e.preventDefault(); upload(e.dataTransfer?.files[0]); });
  el('btn-change-img').addEventListener('click', (e: Event) => { e.stopPropagation(); fileInput.click(); });
  el('banner-image-url').addEventListener('input', () => {
    const value = el('banner-image-url').value.trim();
    if (value) preview(value);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!imageUrl) return alert('Silakan unggah foto poster atau masukkan URL gambar!');
    busy('Menyimpan...');
    const res = await sendJSON('/admin/banners', 'POST', {
      title: el('banner-title').value.trim(),
      image_url: imageUrl,
      target_url: el('banner-target-url').value.trim(),
      is_active: el('banner-is-active').checked,
    }).catch(() => null);
    busy(null);
    if (res?.ok) { closeModal(); load(); }
    else alert(res ? await errorText(res, 'Gagal menyimpan poster.') : 'Terjadi kesalahan saat menyimpan poster.');
  });

  load();
</script>
