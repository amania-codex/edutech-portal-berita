---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getSessionFromRequest } from '../lib/session';

// Redirect if already logged in
const session = await getSessionFromRequest(Astro.request);
if (session) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Login — EduTech News Portal" description="Masuk ke akun EduTech Anda">
  <Navbar />
  <main class="auth-page">
    <div class="auth-container">
      <div class="auth-card">
        <!-- Logo -->
        <div class="auth-logo">
          <div class="logo-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M12 3L1 9L5 11.18V17.18L12 21L19 17.18V11.18L21 10.09V17H23V9L12 3ZM18.82 9L12 12.72L5.18 9L12 5.28L18.82 9ZM17 15.99L12 18.72L7 15.99V12.27L12 15L17 12.27V15.99Z" fill="currentColor"/>
            </svg>
          </div>
          <div>
            <h1 class="auth-brand">Edu<span class="brand-accent">Tech</span></h1>
            <p class="auth-tagline">Portal Berita Pendidikan & Teknologi</p>
          </div>
        </div>

        <h2 class="auth-title">Selamat Datang Kembali</h2>
        <p class="auth-subtitle">Masuk untuk melanjutkan aktivitas Anda</p>

        <!-- Alert -->
        <div class="alert alert-error" id="login-error" style="display:none"></div>
        <div class="alert alert-success" id="login-success" style="display:none"></div>

        <!-- Form -->
        <form id="login-form" class="auth-form" novalidate>
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              <input type="email" id="email" name="email" class="form-input" placeholder="nama@email.com" autocomplete="email" required />
            </div>
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" autocomplete="current-password" required />
              <button type="button" class="toggle-password" id="toggle-password" aria-label="Toggle password">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-auth" id="login-btn">
            <span class="btn-text">Masuk</span>
            <span class="btn-loading" style="display:none">
              <svg class="spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
              Masuk...
            </span>
          </button>
        </form>

        <p class="auth-switch">
          Belum punya akun? <a href="/register" class="auth-link">Daftar sekarang</a>
        </p>

        <!-- Demo credentials hint -->
        <div class="demo-hint">
          <p class="demo-title">🔑 Akun Demo</p>
          <p>Admin: <code>admin@edutech.id</code> / <code>admin123</code></p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .auth-page {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at top left, rgba(230,57,70,0.08) 0%, transparent 50%),
                radial-gradient(ellipse at bottom right, rgba(63,55,201,0.08) 0%, transparent 50%),
                var(--color-bg-primary);
    padding: var(--space-8) var(--space-4);
  }

  .auth-container {
    width: 100%;
    max-width: 440px;
  }

  .auth-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
  }

  .auth-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .logo-icon {
    width: 52px;
    height: 52px;
    background: var(--color-accent);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }

  .auth-brand {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1;
    margin: 0;
  }

  .brand-accent { color: var(--color-accent); }

  .auth-tagline {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }

  .auth-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1);
  }

  .auth-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
  }

  .alert {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--space-4);
    border: 1px solid transparent;
  }

  .alert-error {
    background: rgba(239,68,68,0.1);
    color: #ef4444;
    border-color: rgba(239,68,68,0.2);
  }

  .alert-success {
    background: rgba(34,197,94,0.1);
    color: #22c55e;
    border-color: rgba(34,197,94,0.2);
  }

  .auth-form { display: flex; flex-direction: column; gap: var(--space-4); }

  .form-group { display: flex; flex-direction: column; gap: var(--space-1-5); }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 12px;
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    pointer-events: none;
    flex-shrink: 0;
  }

  .form-input {
    width: 100%;
    padding: 11px 40px 11px 38px;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border-light);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    box-sizing: border-box;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(230,57,70,0.15);
  }

  .form-input::placeholder { color: var(--color-text-muted); }

  .toggle-password {
    position: absolute;
    right: 12px;
    display: flex;
    align-items: center;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 2px;
  }

  .toggle-password svg { width: 16px; height: 16px; }
  .toggle-password:hover { color: var(--color-text-primary); }

  .btn-auth {
    width: 100%;
    padding: 13px;
    background: var(--color-accent);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: 700;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .btn-auth:hover { background: #c1121f; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(230,57,70,0.4); }
  .btn-auth:active { transform: translateY(0); }
  .btn-auth:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }

  @keyframes spin { to { transform: rotate(360deg); } }
  .spin { animation: spin 0.8s linear infinite; width: 18px; height: 18px; }

  .auth-switch {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: var(--space-5) 0 0;
  }

  .auth-link { color: var(--color-accent); font-weight: 600; }
  .auth-link:hover { text-decoration: underline; }

  .demo-hint {
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-light);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .demo-title { font-weight: 700; color: var(--color-text-secondary); margin-bottom: 4px; }
  .demo-hint code {
    background: var(--color-bg-primary);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    color: var(--color-accent);
  }
</style>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorEl = document.getElementById('login-error')!;
  const successEl = document.getElementById('login-success')!;
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
  const togglePwd = document.getElementById('toggle-password')!;
  const pwdInput = document.getElementById('password') as HTMLInputElement;

  togglePwd.addEventListener('click', () => {
    const isText = pwdInput.type === 'text';
    pwdInput.type = isText ? 'password' : 'text';
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';
    successEl.style.display = 'none';

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = pwdInput.value;

    loginBtn.disabled = true;
    (loginBtn.querySelector('.btn-text') as HTMLElement).style.display = 'none';
    (loginBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'flex';

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data.error || 'Login gagal.';
        errorEl.style.display = 'block';
      } else {
        successEl.textContent = `Selamat datang, ${data.user.name}! Mengalihkan...`;
        successEl.style.display = 'block';
        setTimeout(() => {
          window.location.href = data.user.role === 'admin' ? '/dashboard' : '/dashboard';
        }, 1000);
      }
    } catch {
      errorEl.textContent = 'Terjadi kesalahan. Silakan coba lagi.';
      errorEl.style.display = 'block';
    } finally {
      loginBtn.disabled = false;
      (loginBtn.querySelector('.btn-text') as HTMLElement).style.display = 'inline';
      (loginBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
    }
  });
</script>
