---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { apiFind } from "../../lib/news";
import { getSettings, textToHtml } from "../../lib/site";

const page = await apiFind(`/pages/slug/${encodeURIComponent(Astro.params.slug as string)}`);
if (!page) return Astro.rewrite("/404");
const settings = await getSettings();
const html = textToHtml(page.content || "");
const plain = (page.content || "").replace(/\s+/g, " ").trim().slice(0, 155);
---

<Layout title={`${page.title} — EduTech News Portal`} description={plain || settings.site_description || page.title}>
  <Navbar />
  <div class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/">Beranda</a>
      <span class="bc-sep">›</span>
      <span class="bc-current">{page.title}</span>
    </div>
  </div>
  <main id="main-content" class="container info-page">
    <h1>{page.title}</h1>
    <div class="info-content" set:html={html}></div>
  </main>
  <Footer />
</Layout>

<style>
  .breadcrumb-bar { background: var(--color-bg-secondary); border-bottom: 1px solid var(--color-border); padding: var(--space-2) 0; }
  .breadcrumb-inner { display: flex; gap: var(--space-2); font-size: var(--text-xs); color: var(--color-text-muted); }
  .breadcrumb-inner a { color: var(--color-text-secondary); }
  .info-page { max-width: 820px; padding-top: var(--space-8); padding-bottom: var(--space-12); }
  .info-page h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 900; color: var(--color-text-primary); margin-bottom: var(--space-5); line-height: 1.25; }
</style>

<style is:global>
  .info-content { font-size: var(--text-base); color: var(--color-text-secondary); line-height: 1.85; }
  .info-content p { margin: 0 0 var(--space-4); }
  .info-content h2 { font-size: var(--text-xl); font-weight: 800; color: var(--color-text-primary); margin: var(--space-6) 0 var(--space-3); }
  .info-content a { color: var(--color-accent); text-decoration: underline; overflow-wrap: anywhere; }
</style>
