---
import UserLayout from '../../layouts/UserLayout.astro';
---

<UserLayout title="Riwayat Baca" activeMenu="history">
  <div class="content-wrapper">
    <div class="dash-card">
      <!-- Card Header -->
      <div class="card-head">
        <div class="head-info">
          <h2 class="dash-card-title">Riwayat Baca Berita</h2>
          <span class="count-badge" id="history-count-badge">
            <span id="history-total">0</span> Berita
          </span>
        </div>
          <button id="clear-all-btn" style="display:none" class="btn-clear-all" title="Hapus seluruh riwayat bacaan Anda">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
              <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path>
            </svg>
            Bersihkan Semua
          </button>
      </div>

      <!-- Alert -->
      <div class="alert alert-toast" id="history-toast" style="display:none"></div>

      <!-- News List -->
      <div class="history-list" id="history-list">
        <p>Memuat...</p>
      </div>
    </div>
  </div>

  <template id="empty-template">
          <div class="empty-state" id="history-empty">
            <div class="empty-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3>Belum Ada Riwayat Baca</h3>
            <p>Artikel dan berita yang Anda baca akan otomatis tercatat di sini agar mudah ditemukan kembali.</p>
            <a href="/" class="btn-primary-sm">Jelajahi Berita Sekarang</a>
          </div>
  </template>
  <template id="card-template">
            <div class="history-card">
              <a class="history-thumb-link">
                <img
                  loading="lazy"
                />
              </a>

              <div class="history-body">
                <a class="history-title-link">
                  <h3 class="history-title"></h3>
                </a>

                <div class="history-meta">
                  <span class="meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Terakhir dibaca: <span class="read-date"></span>
                  </span>
                </div>
              </div>

              <div class="history-actions">
                <a class="btn-read-again">
                  Baca Lagi
                </a>
                <button
                  class="btn-delete-item"
                  title="Hapus dari riwayat baca"
                  aria-label="Hapus item riwayat"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
  </template>
</UserLayout>

<style>
  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .dash-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .head-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .dash-card-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
  }

  .count-badge {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-accent);
    background: rgba(230, 57, 70, 0.1);
    padding: 3px 10px;
    border-radius: 20px;
  }

  .btn-clear-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-clear-all:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: #ef4444;
  }

  .alert-toast {
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 500;
    margin-bottom: 16px;
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  /* History list */
  .history-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .history-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: all 0.2s ease;
  }

  .history-card:hover {
    border-color: rgba(230, 57, 70, 0.4);
    box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    transform: translateY(-1px);
  }

  .history-thumb-link {
    width: 110px;
    height: 76px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    display: block;
    background: var(--color-bg-primary);
  }

  .history-thumb-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .history-card:hover .history-thumb-link img {
    transform: scale(1.06);
  }

  .history-body {
    flex: 1;
    min-width: 0;
  }

  .history-title-link {
    text-decoration: none;
  }

  .history-title {
    margin: 0 0 6px;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }

  .history-title-link:hover .history-title {
    color: var(--color-accent);
  }

  .history-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .history-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .btn-read-again {
    padding: 7px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .btn-read-again:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-delete-item {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: none;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-delete-item:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.2);
  }

  /* Empty State */
  .empty-state {
    padding: 60px 20px;
    text-align: center;
    color: var(--color-text-muted);
  }

  .empty-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(230, 57, 70, 0.08);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .empty-icon-wrap svg {
    width: 32px;
    height: 32px;
  }

  .empty-state h3 {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .empty-state p {
    margin: 0 auto 20px;
    font-size: 13.5px;
    max-width: 440px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .btn-primary-sm {
    display: inline-block;
    padding: 9px 20px;
    background: var(--color-accent);
    color: white;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary-sm:hover {
    background: #c1121f;
  }

  @media (max-width: 640px) {
    .history-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .history-thumb-link {
      width: 100%;
      height: 140px;
    }

    .history-actions {
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid var(--color-border);
      padding-top: 10px;
      margin-top: 6px;
    }
  }
</style>

<script>
  import { api, clone, el, getJSON, relativeTime, rowId, setText, show, toast } from '../../lib/client';
  import { FALLBACK_IMAGE, assetUrl } from '../../lib/news';

  let items: any[] = [];
  const list = el('history-list') as HTMLElement;

  function render() {
    el('history-total').textContent = String(items.length);
    show(el('clear-all-btn'), items.length > 0);
    if (!items.length) return list.replaceChildren(clone('empty-template'));
    list.replaceChildren(...items.map((h) => {
      const node = clone('card-template');
      node.querySelectorAll('a').forEach((a) => { a.href = `/berita/${h.news_slug}`; });
      const img = node.querySelector('img')!;
      img.src = assetUrl(h.news_image) || FALLBACK_IMAGE;
      img.alt = h.news_title || '';
      setText(node, '.history-title', h.news_title);
      setText(node, '.read-date', relativeTime(h.read_at));
      node.querySelector('.btn-delete-item')!.addEventListener('click', async () => {
        if (!confirm('Hapus artikel ini dari riwayat baca?')) return;
        const res = await api(`/user/history/${rowId(h)}`, { method: 'DELETE' }).catch(() => null);
        if (!res?.ok) return toast('history-toast', 'Gagal menghapus riwayat.');
        items = items.filter((x) => x !== h);
        render();
        toast('history-toast', 'Artikel berhasil dihapus dari riwayat baca.');
      });
      return node;
    }));
  }

  el('clear-all-btn').addEventListener('click', async () => {
    if (!confirm('Apakah Anda yakin ingin menghapus seluruh riwayat bacaan Anda? Tindakan ini tidak dapat dibatalkan.')) return;
    const res = await api('/user/history', { method: 'DELETE' }).catch(() => null);
    if (!res?.ok) return toast('history-toast', 'Gagal membersihkan riwayat.');
    items = [];
    render();
    toast('history-toast', 'Seluruh riwayat baca berhasil dibersihkan.');
  });

  getJSON('/user/history').then((data) => { items = data || []; render(); })
    .catch(() => { list.textContent = 'Gagal memuat riwayat. Silakan coba lagi.'; });
</script>
