---

import UserLayout from '../../layouts/UserLayout.astro';


const API_BASE = "http://localhost:3000/api";
let bookmarkItems: any[] = [];



const fallbackImg = "https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=800&q=80";

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<UserLayout title="Berita Disimpan" activeMenu="bookmarks">
  <div class="content-wrapper">
    <div class="dash-card">
      <!-- Card Header -->
      <div class="card-head">
        <div class="head-info">
          <h2 class="dash-card-title">Koleksi Berita Disimpan</h2>
          <span class="count-badge">
            <span id="bm-total">{bookmarkItems.length}</span> Tersimpan
          </span>
        </div>

        {bookmarkItems.length > 0 && (
          <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="bm-search"
              placeholder="Cari dalam koleksi..."
              aria-label="Cari berita yang disimpan"
            />
          </div>
        )}
      </div>

      <!-- Toast Feedback -->
      <div class="alert alert-toast" id="bm-toast" style="display:none"></div>

      <!-- News List -->
      <div class="bookmark-list" id="bookmark-list">
        {bookmarkItems.length === 0 ? (
          <div class="empty-state" id="bm-empty">
            <div class="empty-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <h3>Koleksi Simpanan Masih Kosong</h3>
            <p>Simpan artikel yang menarik saat menjelajahi portal berita untuk dibaca nanti dengan menekan tombol simpan berita.</p>
            <a href="/" class="btn-primary-sm">Jelajahi Berita</a>
          </div>
        ) : (
          bookmarkItems.map((item) => (
            <div class="bookmark-card" id={`bm-card-${item.news_id}`} data-title={(item.news_title || '').toLowerCase()}>
              <a href={`/berita/${item.news_slug}`} class="bookmark-thumb-link">
                <img
                  src={item.news_image || fallbackImg}
                  alt={item.news_title}
                  loading="lazy"
                  onerror={`this.onerror=null;this.src='${fallbackImg}';`}
                />
              </a>

              <div class="bookmark-body">
                <a href={`/berita/${item.news_slug}`} class="bookmark-title-link">
                  <h3 class="bookmark-title">{item.news_title}</h3>
                </a>

                <div class="bookmark-meta">
                  <span class="meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Disimpan: {formatDate(item.created_at || item.CreatedAt)}
                  </span>
                </div>
              </div>

              <div class="bookmark-actions">
                <a href={`/berita/${item.news_slug}`} class="btn-read-now">
                  Baca Artikel
                </a>
                <button
                  class="btn-remove-bm"
                  data-id={item.news_id}
                  title="Hapus dari koleksi simpanan"
                  aria-label="Hapus dari simpanan"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path>
                  </svg>
                </button>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>
</UserLayout>

<style>
  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .dash-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 16px;
    flex-wrap: wrap;
    gap: 14px;
  }

  .head-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .dash-card-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
  }

  .count-badge {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-accent);
    background: rgba(230, 57, 70, 0.1);
    padding: 3px 10px;
    border-radius: 20px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 6px 12px;
    width: 240px;
    color: var(--color-text-muted);
  }

  .search-box:focus-within {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
  }

  .search-box input {
    border: none;
    background: none;
    outline: none;
    font-size: 13px;
    color: var(--color-text-primary);
    width: 100%;
    font-family: var(--font-sans);
  }

  .alert-toast {
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 500;
    margin-bottom: 16px;
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  /* Bookmark list */
  .bookmark-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bookmark-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: all 0.2s ease;
  }

  .bookmark-card:hover {
    border-color: rgba(230, 57, 70, 0.4);
    box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    transform: translateY(-1px);
  }

  .bookmark-thumb-link {
    width: 110px;
    height: 76px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    display: block;
    background: var(--color-bg-primary);
  }

  .bookmark-thumb-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .bookmark-card:hover .bookmark-thumb-link img {
    transform: scale(1.06);
  }

  .bookmark-body {
    flex: 1;
    min-width: 0;
  }

  .bookmark-title-link {
    text-decoration: none;
  }

  .bookmark-title {
    margin: 0 0 6px;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }

  .bookmark-title-link:hover .bookmark-title {
    color: var(--color-accent);
  }

  .bookmark-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .bookmark-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .btn-read-now {
    padding: 7px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .btn-read-now:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-remove-bm {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: none;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-remove-bm:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.2);
  }

  /* Empty State */
  .empty-state {
    padding: 60px 20px;
    text-align: center;
    color: var(--color-text-muted);
  }

  .empty-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(230, 57, 70, 0.08);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .empty-icon-wrap svg {
    width: 30px;
    height: 30px;
  }

  .empty-state h3 {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .empty-state p {
    margin: 0 auto 20px;
    font-size: 13.5px;
    max-width: 440px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .btn-primary-sm {
    display: inline-block;
    padding: 9px 20px;
    background: var(--color-accent);
    color: white;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary-sm:hover {
    background: #c1121f;
  }

  @media (max-width: 640px) {
    .bookmark-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .bookmark-thumb-link {
      width: 100%;
      height: 140px;
    }

    .bookmark-actions {
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid var(--color-border);
      padding-top: 10px;
      margin-top: 6px;
    }
  }
</style>

<script is:inline>
  const API_BASE = 'http://localhost:3000/api';
  const toast = document.getElementById('bm-toast');
  const countBadge = document.getElementById('bm-total');
  const searchInput = document.getElementById('bm-search');

  function showToast(msg) {
    if (!toast) return;
    toast.textContent = msg;
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 3000);
  }

  function updateCount(delta) {
    if (!countBadge) return;
    let current = parseInt(countBadge.textContent || '0');
    current = Math.max(0, current + delta);
    countBadge.textContent = current.toString();

    if (current === 0) {
      const list = document.getElementById('bookmark-list');
      if (list) {
        list.innerHTML = `
          <div class="empty-state" id="bm-empty">
            <div class="empty-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="30" height="30">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <h3>Koleksi Simpanan Masih Kosong</h3>
            <p>Simpan artikel yang menarik saat menjelajahi portal berita untuk dibaca nanti dengan menekan tombol simpan berita.</p>
            <a href="/" class="btn-primary-sm">Jelajahi Berita</a>
          </div>
        `;
      }
    }
  }

  // Remove bookmark
  document.querySelectorAll('.btn-remove-bm').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const newsId = btn.dataset.id;
      if (!confirm('Hapus berita ini dari koleksi disimpan?')) return;

      try {
        const res = await fetch(`${API_BASE}/user/bookmarks`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ news_id: parseInt(newsId) })
        });
        if (res.ok) {
          const card = document.getElementById(`bm-card-${newsId}`);
          if (card) {
            card.style.opacity = '0';
            card.style.transform = 'translateY(10px)';
            setTimeout(() => { card.remove(); updateCount(-1); }, 200);
          }
          showToast('Berita berhasil dihapus dari koleksi disimpan.');
        }
      } catch (err) {
        console.error(err);
      }
    });
  });

  // Client-side quick filter search
  searchInput?.addEventListener('input', (e) => {
    const q = (e.target.value || '').toLowerCase().trim();
    document.querySelectorAll('.bookmark-card').forEach(card => {
      const title = card.dataset.title || '';
      if (!q || title.includes(q)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  });
</script>
