---
import UserLayout from '../../layouts/UserLayout.astro';
---

<UserLayout title="Berita Disimpan" activeMenu="bookmarks">
  <div class="content-wrapper">
    <div class="dash-card">
      <!-- Card Header -->
      <div class="card-head">
        <div class="head-info">
          <h2 class="dash-card-title">Koleksi Berita Disimpan</h2>
          <span class="count-badge">
            <span id="bm-total">0</span> Tersimpan
          </span>
        </div>

          <div class="search-box" id="search-box" style="display:none">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="bm-search"
              placeholder="Cari dalam koleksi..."
              aria-label="Cari berita yang disimpan"
            />
          </div>
      </div>

      <!-- Toast Feedback -->
      <div class="alert alert-toast" id="bm-toast" style="display:none"></div>

      <!-- News List -->
      <div class="bookmark-list" id="bookmark-list">
        <p>Memuat...</p>
      </div>
    </div>
  </div>

  <template id="empty-template">
          <div class="empty-state" id="bm-empty">
            <div class="empty-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <h3>Koleksi Simpanan Masih Kosong</h3>
            <p>Simpan artikel yang menarik saat menjelajahi portal berita untuk dibaca nanti dengan menekan tombol simpan berita.</p>
            <a href="/" class="btn-primary-sm">Jelajahi Berita</a>
          </div>
  </template>
  <template id="card-template">
            <div class="bookmark-card">
              <a class="bookmark-thumb-link">
                <img
                  loading="lazy"
                />
              </a>

              <div class="bookmark-body">
                <a class="bookmark-title-link">
                  <h3 class="bookmark-title"></h3>
                </a>

                <div class="bookmark-meta">
                  <span class="meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Disimpan: <span class="saved-date"></span>
                  </span>
                </div>
              </div>

              <div class="bookmark-actions">
                <a class="btn-read-now">
                  Baca Artikel
                </a>
                <button
                  class="btn-remove-bm"
                  title="Hapus dari koleksi simpanan"
                  aria-label="Hapus dari simpanan"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path>
                  </svg>
                </button>
              </div>
            </div>
  </template>
</UserLayout>

<style>
  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .dash-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 16px;
    flex-wrap: wrap;
    gap: 14px;
  }

  .head-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .dash-card-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
  }

  .count-badge {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-accent);
    background: rgba(230, 57, 70, 0.1);
    padding: 3px 10px;
    border-radius: 20px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 6px 12px;
    width: 240px;
    color: var(--color-text-muted);
  }

  .search-box:focus-within {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
  }

  .search-box input {
    border: none;
    background: none;
    outline: none;
    font-size: 13px;
    color: var(--color-text-primary);
    width: 100%;
    font-family: var(--font-sans);
  }

  .alert-toast {
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 500;
    margin-bottom: 16px;
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  /* Bookmark list */
  .bookmark-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bookmark-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: all 0.2s ease;
  }

  .bookmark-card:hover {
    border-color: rgba(230, 57, 70, 0.4);
    box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    transform: translateY(-1px);
  }

  .bookmark-thumb-link {
    width: 110px;
    height: 76px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    display: block;
    background: var(--color-bg-primary);
  }

  .bookmark-thumb-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .bookmark-card:hover .bookmark-thumb-link img {
    transform: scale(1.06);
  }

  .bookmark-body {
    flex: 1;
    min-width: 0;
  }

  .bookmark-title-link {
    text-decoration: none;
  }

  .bookmark-title {
    margin: 0 0 6px;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }

  .bookmark-title-link:hover .bookmark-title {
    color: var(--color-accent);
  }

  .bookmark-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .bookmark-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .btn-read-now {
    padding: 7px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .btn-read-now:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-remove-bm {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: none;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-remove-bm:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.2);
  }

  /* Empty State */
  .empty-state {
    padding: 60px 20px;
    text-align: center;
    color: var(--color-text-muted);
  }

  .empty-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(230, 57, 70, 0.08);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .empty-icon-wrap svg {
    width: 30px;
    height: 30px;
  }

  .empty-state h3 {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .empty-state p {
    margin: 0 auto 20px;
    font-size: 13.5px;
    max-width: 440px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .btn-primary-sm {
    display: inline-block;
    padding: 9px 20px;
    background: var(--color-accent);
    color: white;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary-sm:hover {
    background: #c1121f;
  }

  @media (max-width: 640px) {
    .bookmark-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .bookmark-thumb-link {
      width: 100%;
      height: 140px;
    }

    .bookmark-actions {
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid var(--color-border);
      padding-top: 10px;
      margin-top: 6px;
    }
  }
</style>

<script>
  import { clone, createdAt, el, formatDate, getJSON, sendJSON, setText, show, toast } from '../../lib/client';
  import { FALLBACK_IMAGE, assetUrl } from '../../lib/news';

  let items: any[] = [];
  const list = el('bookmark-list') as HTMLElement;

  function render() {
    const q = el('bm-search').value.toLowerCase().trim();
    el('bm-total').textContent = String(items.length);
    show(el('search-box'), items.length > 0);
    if (!items.length) return list.replaceChildren(clone('empty-template'));
    list.replaceChildren(...items.filter((b) => !q || (b.news_title || '').toLowerCase().includes(q)).map((b) => {
      const node = clone('card-template');
      node.querySelectorAll('a').forEach((a) => { a.href = `/berita/${b.news_slug}`; });
      const img = node.querySelector('img')!;
      img.src = assetUrl(b.news_image) || FALLBACK_IMAGE;
      img.alt = b.news_title || '';
      setText(node, '.bookmark-title', b.news_title);
      setText(node, '.saved-date', formatDate(createdAt(b)));
      node.querySelector('.btn-remove-bm')!.addEventListener('click', async () => {
        if (!confirm('Hapus berita ini dari koleksi disimpan?')) return;
        const res = await sendJSON('/user/bookmarks', 'POST', { news_id: b.news_id }).catch(() => null);
        if (!res?.ok) return toast('bm-toast', 'Gagal menghapus berita dari koleksi.');
        items = items.filter((x) => x !== b);
        render();
        toast('bm-toast', 'Berita berhasil dihapus dari koleksi disimpan.');
      });
      return node;
    }));
  }

  el('bm-search').addEventListener('input', render);
  getJSON('/user/bookmarks').then((data) => { items = data || []; render(); })
    .catch(() => { list.textContent = 'Gagal memuat koleksi. Silakan coba lagi.'; });
</script>
