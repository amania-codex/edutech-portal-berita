---
import UserLayout from '../../layouts/UserLayout.astro';
import { getSessionFromRequest } from '../../lib/session';

const session = await getSessionFromRequest(Astro.request);
if (!session) return Astro.redirect('/login');

const API_BASE = "http://localhost:3000/api";
let notifs: any[] = [];

try {
  const res = await fetch(`${API_BASE}/user/notifications`, {
    headers: { 'Cookie': Astro.request.headers.get('cookie') || '' }
  });
  if (res.ok) {
    notifs = await res.json();
  }
} catch(err) {
  console.error("Gagal mengambil notifikasi", err);
}

const unreadCount = notifs.filter(n => !n.is_read).length;
---

<UserLayout title="Kotak Masuk" activeMenu="inbox">
  <div class="content-wrapper">
    <div class="dash-card">
      <div class="card-head">
        <h2 class="dash-card-title">Pemberitahuan Interaksi</h2>
        {unreadCount > 0 && (
          <button id="mark-all-read" class="btn-text">Tandai semua dibaca</button>
        )}
      </div>

      <div class="notif-list">
        {notifs.length === 0 ? (
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <p>Kotak masuk Anda kosong.</p>
          </div>
        ) : (
          notifs.map((notif) => (
            <a href={`/berita/${notif.news_slug}`} class={`notif-item ${notif.is_read ? 'read' : 'unread'}`} data-id={notif.ID}>
              <div class="notif-icon">
                {notif.type === 'like' ? (
                  <svg class="icon-like" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
                ) : (
                  <svg class="icon-reply" viewBox="0 0 24 24" fill="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                )}
              </div>
              <div class="notif-content">
                <p class="notif-text"><strong>{notif.sender_name}</strong> {notif.message}</p>
                <span class="notif-time">{new Date(notif.CreatedAt).toLocaleString('id-ID')}</span>
              </div>
              {!notif.is_read && <div class="unread-dot"></div>}
            </a>
          ))
        )}
      </div>
    </div>
  </div>
</UserLayout>

<style>
  .content-wrapper { max-width: 800px; margin: 0 auto; }
  .card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--color-border); padding-bottom: 12px; }
  
  .btn-text { background: none; border: none; color: #3b82f6; font-size: 13px; font-weight: 600; cursor: pointer; }
  .btn-text:hover { text-decoration: underline; }

  .notif-list { display: flex; flex-direction: column; gap: 12px; }
  .notif-item { display: flex; align-items: center; gap: 16px; padding: 16px; border-radius: 12px; border: 1px solid var(--color-border); background: var(--color-bg-card); text-decoration: none; transition: background 0.2s; position: relative; }
  .notif-item:hover { background: var(--color-surface); }
  
  .notif-item.unread { background: rgba(59,130,246,0.05); border-color: rgba(59,130,246,0.2); }
  
  .notif-icon { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .notif-item.unread .notif-icon { background: rgba(59,130,246,0.1); color: #3b82f6; }
  .notif-item.read .notif-icon { background: var(--color-surface); color: var(--color-text-muted); }
  
  .notif-icon svg { width: 20px; height: 20px; }

  .notif-content { flex: 1; }
  .notif-text { margin: 0 0 4px; font-size: 14.5px; color: var(--color-text-primary); line-height: 1.4; }
  .notif-text strong { font-weight: 600; }
  .notif-time { font-size: 12px; color: var(--color-text-muted); }
  
  .unread-dot { width: 10px; height: 10px; background: #3b82f6; border-radius: 50%; }

  .empty-state { padding: 40px 20px; text-align: center; color: var(--color-text-muted); }
  .empty-state svg { width: 48px; height: 48px; opacity: 0.5; margin-bottom: 16px; }
</style>

<script is:inline>
  const markReadBtn = document.getElementById('mark-all-read');
  if (markReadBtn) {
    markReadBtn.addEventListener('click', async () => {
      try {
        await fetch('http://localhost:3000/api/user/notifications/read-all', { method: 'POST', credentials: 'include' });
        window.location.reload();
      } catch (err) {
        console.error(err);
      }
    });
  }

  // Mark single as read when clicked
  document.querySelectorAll('.notif-item.unread').forEach(item => {
    item.addEventListener('click', async (e) => {
      // Allow navigation to happen, but fire request first
      const id = item.dataset.id;
      fetch(`http://localhost:3000/api/user/notifications/${id}/read`, { method: 'POST', credentials: 'include' });
    });
  });
</script>
