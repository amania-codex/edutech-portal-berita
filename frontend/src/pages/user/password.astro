---
import UserLayout from '../../layouts/UserLayout.astro';
import { getSessionFromRequest } from '../../lib/session';

const session = await getSessionFromRequest(Astro.request);
if (!session) return Astro.redirect('/login');
if (session.role === 'admin') return Astro.redirect('/dashboard');

const email = session.email;
---

<UserLayout title="Ganti Password" activeMenu="password">
  <div class="password-container">
    <div class="dash-card">
      <div class="page-header">
        <h2 class="title">Ganti Password</h2>
        <p class="subtitle">Demi keamanan, kami akan mengirimkan kode verifikasi ke email Anda <strong>{email}</strong>.</p>
      </div>

      <div class="alert alert-success" id="success-msg" style="display:none"></div>
      <div class="alert alert-error" id="error-msg" style="display:none"></div>

      <!-- Step 1: Request Code -->
      <div id="step-request">
        <button class="btn-primary" id="btn-request">
          Kirim Kode ke Email
        </button>
      </div>

      <!-- Step 2: Enter Code & New Password -->
      <form id="step-reset" class="password-form" style="display:none">
        <div class="form-group">
          <label for="code" class="form-label">Kode Verifikasi (6 digit)</label>
          <input type="text" id="code" class="form-input" required maxlength="6" placeholder="Masukkan 6 digit kode" />
        </div>
        
        <div class="form-group">
          <label for="new-password" class="form-label">Password Baru (Min. 6 karakter)</label>
          <input type="password" id="new-password" class="form-input" required minlength="6" placeholder="••••••••" />
        </div>

        <button type="submit" class="btn-primary" id="btn-reset">
          Simpan Password Baru
        </button>
      </form>
    </div>
  </div>
</UserLayout>

<style>
  .password-container { max-width: 500px; margin: 0 auto; }
  .dash-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; padding: 24px; }
  .page-header { margin-bottom: 24px; border-bottom: 1px solid var(--color-border); padding-bottom: 16px; }
  .title { font-size: 20px; font-weight: 700; color: var(--color-text-primary); margin: 0 0 8px; }
  .subtitle { font-size: 14px; color: var(--color-text-secondary); margin: 0; line-height: 1.5; }
  
  .alert { padding: 12px 16px; border-radius: 8px; font-size: 14px; font-weight: 500; margin-bottom: 20px; }
  .alert-success { background: rgba(34,197,94,0.1); color: #22c55e; border: 1px solid rgba(34,197,94,0.2); }
  .alert-error { background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.2); }
  
  .password-form { display: flex; flex-direction: column; gap: 20px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-label { font-size: 13px; font-weight: 600; color: var(--color-text-secondary); }
  
  .form-input { 
    padding: 10px 14px; background: var(--color-surface); 
    border: 1.5px solid var(--color-border-light); border-radius: 8px; 
    color: var(--color-text-primary); font-size: 14px; width: 100%; box-sizing: border-box; 
  }
  .form-input:focus { outline: none; border-color: var(--color-accent); }
  
  .btn-primary { 
    width: 100%; padding: 10px 24px; border-radius: 8px; 
    font-size: 14px; font-weight: 600; background: var(--color-accent); 
    color: white; border: none; cursor: pointer; transition: background 0.15s; 
  }
  .btn-primary:hover { background: #c1121f; }
  .btn-primary:disabled { opacity: 0.7; cursor: not-allowed; }
</style>

<script define:vars={{ email }}>
  const btnRequest = document.getElementById('btn-request');
  const stepRequest = document.getElementById('step-request');
  const stepReset = document.getElementById('step-reset');
  const errorMsg = document.getElementById('error-msg');
  const successMsg = document.getElementById('success-msg');
  
  btnRequest.addEventListener('click', async () => {
    btnRequest.disabled = true;
    btnRequest.textContent = "Mengirim...";
    errorMsg.style.display = 'none';
    successMsg.style.display = 'none';

    try {
      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await res.json();
      if (res.ok) {
        stepRequest.style.display = 'none';
        stepReset.style.display = 'flex';
        successMsg.textContent = data.message + " (Cek terminal backend untuk simulasi)";
        successMsg.style.display = 'block';
      } else {
        errorMsg.textContent = data.error || "Gagal meminta kode.";
        errorMsg.style.display = 'block';
        btnRequest.disabled = false;
        btnRequest.textContent = "Kirim Kode ke Email";
      }
    } catch (e) {
      errorMsg.textContent = "Kesalahan server.";
      errorMsg.style.display = 'block';
      btnRequest.disabled = false;
      btnRequest.textContent = "Kirim Kode ke Email";
    }
  });

  stepReset.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btnReset = document.getElementById('btn-reset');
    const code = document.getElementById('code').value;
    const newPassword = document.getElementById('new-password').value;

    btnReset.disabled = true;
    btnReset.textContent = "Menyimpan...";
    errorMsg.style.display = 'none';
    successMsg.style.display = 'none';

    try {
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, code, newPassword })
      });
      const data = await res.json();
      if (res.ok) {
        successMsg.textContent = data.message;
        successMsg.style.display = 'block';
        stepReset.reset();
        setTimeout(() => {
          window.location.href = '/user'; // Go back to profile
        }, 2000);
      } else {
        errorMsg.textContent = data.error || "Gagal mereset password.";
        errorMsg.style.display = 'block';
        btnReset.disabled = false;
        btnReset.textContent = "Simpan Password Baru";
      }
    } catch (e) {
      errorMsg.textContent = "Kesalahan server.";
      errorMsg.style.display = 'block';
      btnReset.disabled = false;
      btnReset.textContent = "Simpan Password Baru";
    }
  });
</script>
