---
import UserLayout from '../../layouts/UserLayout.astro';
---

<UserLayout title="Ganti Password" activeMenu="password">
  <div class="password-container">
    <div class="dash-card">
      <div class="page-header">
        <h2 class="title">Ganti Password</h2>
        <p class="subtitle">Masukkan password Anda saat ini, lalu password baru (minimal 6 karakter).</p>
      </div>

      <div class="alert alert-success" id="success-msg" style="display:none"></div>
      <div class="alert alert-error" id="error-msg" style="display:none"></div>

      <form id="password-form" class="password-form">
        <div class="form-group">
          <label for="old-password" class="form-label">Password Saat Ini</label>
          <input type="password" id="old-password" class="form-input" required autocomplete="current-password" />
        </div>
        <div class="form-group">
          <label for="new-password" class="form-label">Password Baru</label>
          <input type="password" id="new-password" class="form-input" required minlength="6" autocomplete="new-password" />
        </div>
        <div class="form-group">
          <label for="confirm-password" class="form-label">Ulangi Password Baru</label>
          <input type="password" id="confirm-password" class="form-input" required minlength="6" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn-primary" id="btn-save">Simpan Password Baru</button>
      </form>
    </div>
  </div>
</UserLayout>

<style>
  .password-container { max-width: 500px; margin: 0 auto; }
  .dash-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; padding: 24px; }
  .page-header { margin-bottom: 24px; border-bottom: 1px solid var(--color-border); padding-bottom: 16px; }
  .title { font-size: 20px; font-weight: 700; color: var(--color-text-primary); margin: 0 0 8px; }
  .subtitle { font-size: 14px; color: var(--color-text-secondary); margin: 0; line-height: 1.5; }
  
  .alert { padding: 12px 16px; border-radius: 8px; font-size: 14px; font-weight: 500; margin-bottom: 20px; }
  .alert-success { background: rgba(34,197,94,0.1); color: #22c55e; border: 1px solid rgba(34,197,94,0.2); }
  .alert-error { background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.2); }
  
  .password-form { display: flex; flex-direction: column; gap: 20px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-label { font-size: 13px; font-weight: 600; color: var(--color-text-secondary); }
  
  .form-input { 
    padding: 10px 14px; background: var(--color-surface); 
    border: 1.5px solid var(--color-border-light); border-radius: 8px; 
    color: var(--color-text-primary); font-size: 14px; width: 100%; box-sizing: border-box; 
  }
  .form-input:focus { outline: none; border-color: var(--color-accent); }
  
  .btn-primary { 
    width: 100%; padding: 10px 24px; border-radius: 8px; 
    font-size: 14px; font-weight: 600; background: var(--color-accent); 
    color: white; border: none; cursor: pointer; transition: background 0.15s; 
  }
  .btn-primary:hover { background: #c1121f; }
  .btn-primary:disabled { opacity: 0.7; cursor: not-allowed; }
</style>

<script>
  import { errorText, sendJSON } from '../../lib/client';

  const form = document.getElementById('password-form') as HTMLFormElement;
  const btn = document.getElementById('btn-save') as HTMLButtonElement;
  const okMsg = document.getElementById('success-msg')!;
  const errMsg = document.getElementById('error-msg')!;
  const value = (id: string) => (document.getElementById(id) as HTMLInputElement).value;

  function show(target: HTMLElement, text: string) {
    okMsg.style.display = errMsg.style.display = 'none';
    target.textContent = text;
    target.style.display = 'block';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (value('new-password') !== value('confirm-password')) return show(errMsg, 'Ulangan password baru tidak sama.');
    if (value('new-password') === value('old-password')) return show(errMsg, 'Password baru harus berbeda dari password saat ini.');
    btn.disabled = true;
    btn.textContent = 'Menyimpan...';
    try {
      const res = await sendJSON('/auth/password', 'PUT', { oldPassword: value('old-password'), newPassword: value('new-password') });
      if (res.ok) {
        form.reset();
        show(okMsg, 'Password berhasil diganti.');
      } else show(errMsg, await errorText(res, 'Gagal mengganti password.'));
    } catch {
      show(errMsg, 'Server tidak dapat dihubungi. Silakan coba lagi.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Simpan Password Baru';
    }
  });
</script>
