---
import UserLayout from '../../layouts/UserLayout.astro';
---

<UserLayout title="Profil Saya" activeMenu="profile">
  <div class="profile-container">
    <!-- Header Card -->
    <div class="dash-card profile-card">
      <div class="profile-header">
        <div class="profile-avatar-large">
          <img id="p-avatar" alt="" style="display:none" />
          <span id="p-initial">?</span>
        </div>
        <div class="profile-info">
          <div class="profile-title-row">
            <h2 class="profile-name" id="p-name">Memuat...</h2>
            <span class="profile-status-badge">
              <span class="status-dot"></span>
              Terverifikasi
            </span>
          </div>
          <p class="profile-email" id="p-email"></p>
          <p class="profile-join">
            Bergabung sejak <span id="p-joined">-</span>
          </p>
        </div>
        <div class="profile-action">
          <a href="/user/edit" class="btn-edit-profile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            Edit Profil
          </a>
        </div>
      </div>

      <!-- Bio Section -->
      <div class="profile-bio-box">
        <h3 class="section-label">Tentang Saya</h3>
        <p class="bio-content" id="p-bio" style="display:none"></p>
        <div class="bio-empty-prompt" id="p-bio-empty" style="display:none">
            <p>Belum ada bio yang ditambahkan.</p>
            <a href="/user/edit" class="bio-cta-link">+ Tambahkan deskripsi singkat tentang minat baca Anda</a>
        </div>
      </div>
    </div>

    <!-- Quick Activity Cards -->
    <div class="activity-cards-grid">
      <a href="/user/bookmarks" class="activity-card">
        <div class="activity-icon icon-bookmark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
        <div class="activity-info">
          <h4>Berita Disimpan</h4>
          <p>Akses artikel yang Anda tandai untuk dibaca nanti</p>
        </div>
        <span class="activity-arrow">→</span>
      </a>

      <a href="/user/history" class="activity-card">
        <div class="activity-icon icon-history">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="activity-info">
          <h4>Riwayat Baca</h4>
          <p>Telusuri jejak artikel dan berita yang pernah Anda kunjungi</p>
        </div>
        <span class="activity-arrow">→</span>
      </a>

      <a href="/user/tickets" class="activity-card">
        <div class="activity-icon icon-ticket" style="background: rgba(230, 57, 70, 0.15); color: #e63946;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z" />
            <path d="M13 5v2" />
            <path d="M13 17v2" />
            <path d="M13 11v2" />
          </svg>
        </div>
        <div class="activity-info">
          <h4>Tiket & Event Saya</h4>
          <p>Cek status tiket seminar/webinar, klaim sertifikat & materi</p>
        </div>
        <span class="activity-arrow">→</span>
      </a>

      <a href="/user/password" class="activity-card">
        <div class="activity-icon icon-security">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <div class="activity-info">
          <h4>Keamanan Akun</h4>
          <p>Perbarui kata sandi akun secara berkala demi keamanan</p>
        </div>
        <span class="activity-arrow">→</span>
      </a>
    </div>
  </div>
</UserLayout>

<style>
  .profile-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .dash-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 28px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 24px;
  }

  .profile-avatar-large {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent) 0%, #c1121f 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 38px;
    font-weight: 800;
    color: white;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(230, 57, 70, 0.35);
  }

  .profile-avatar-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-info {
    flex: 1;
    min-width: 0;
  }

  .profile-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .profile-name {
    font-size: 22px;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
  }

  .profile-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
    border-radius: 20px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
  }

  .profile-email {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 6px;
  }

  .profile-join {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .btn-edit-profile {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    background: var(--color-accent);
    color: white;
    text-decoration: none;
    transition: all 0.15s ease;
    box-shadow: 0 2px 10px rgba(230, 57, 70, 0.3);
    white-space: nowrap;
  }

  .btn-edit-profile:hover {
    background: #c1121f;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(230, 57, 70, 0.4);
  }

  .profile-bio-box {
    padding-top: 20px;
  }

  .section-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 10px;
  }

  .bio-content {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .bio-empty-prompt {
    background: var(--color-surface);
    padding: 16px;
    border-radius: 8px;
    border: 1px dashed var(--color-border);
  }

  .bio-empty-prompt p {
    font-size: 13.5px;
    color: var(--color-text-muted);
    margin: 0 0 6px;
  }

  .bio-cta-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .bio-cta-link:hover {
    text-decoration: underline;
  }

  /* Activity Cards Grid */
  .activity-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .activity-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 0.2s ease;
  }

  .activity-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
  }

  .activity-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .activity-icon svg {
    width: 20px;
    height: 20px;
  }

  .icon-bookmark {
    background: rgba(230, 57, 70, 0.1);
    color: var(--color-accent);
  }

  .icon-history {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
  }

  .icon-security {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
  }

  .activity-info {
    flex: 1;
    min-width: 0;
  }

  .activity-info h4 {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .activity-info p {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .activity-arrow {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-muted);
    transition: transform 0.15s;
  }

  .activity-card:hover .activity-arrow {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .profile-header {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .profile-title-row {
      justify-content: center;
    }

    .activity-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { el, formatDate, getJSON, show } from '../../lib/client';
  import { assetUrl } from '../../lib/news';

  getJSON('/auth/profile').then((u) => {
    el('p-name').textContent = u.name;
    el('p-email').textContent = u.email;
    el('p-joined').textContent = formatDate(u.created_at, { day: 'numeric', month: 'long', year: 'numeric' });
    el('p-initial').textContent = (u.name || 'U').charAt(0).toUpperCase();
    if (u.avatar) {
      el('p-avatar').src = assetUrl(u.avatar);
      show(el('p-avatar'), true);
      show(el('p-initial'), false);
    }
    el('p-bio').textContent = u.bio || '';
    show(el('p-bio'), !!u.bio?.trim());
    show(el('p-bio-empty'), !u.bio?.trim());
  }).catch(() => {});
</script>
