---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import TrendingNews from "../../components/TrendingNews.astro";
import Footer from "../../components/Footer.astro";
import Comments from "../../components/Comments.astro";
import { FALLBACK_IMAGE, getAllNews, getTrending, renderContent, type News } from "../../lib/news";

export async function getStaticPaths() {
  const news = await getAllNews();
  return news.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const article = Astro.props.article as News;
const trendingNews = await getTrending();
const contentHtml = renderContent(article.content, article.imageUrl);
const tweetText = encodeURIComponent(article.title).replace(/'/g, "%27");

const formattedDate = article.createdAt
  ? new Date(article.createdAt).toLocaleDateString("id-ID", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "Asia/Jakarta",
    })
  : "";
---

<Layout
  title={`${article.title} — EduTech News Portal`}
  description={article.excerpt || article.title}
  image={article.imageUrl}
>
  <Navbar />

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/">Beranda</a>
      <span class="bc-sep">›</span>
      {article.category && (
        <>
          <a href={`/kategori/${article.categorySlug}`}>{article.category}</a>
          <span class="bc-sep">›</span>
        </>
      )}
      <span class="bc-current">{article.title}</span>
    </div>
  </div>

  <main id="main-content" class="container article-layout">
    <!-- Main Article -->
    <article class="article-main">
      <!-- Category & Title -->
      {article.category && (
        <a href={`/kategori/${article.categorySlug}`} class="article-category badge badge-accent">
          {article.category}
        </a>
      )}
      <h1 class="article-title">{article.title}</h1>



      <!-- Meta -->
      <div class="article-meta">
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span>{article.author || "Redaksi"}</span>
        </div>
        {formattedDate && (
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>{formattedDate}</span>
          </div>
        )}
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span>{article.viewCount || 0} tayangan</span>
        </div>
        <div class="meta-item meta-readtime">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>{article.readTime} menit baca</span>
        </div>
      </div>

      <!-- Hero Image -->
      {article.imageUrl && (
        <div class="article-hero-img">
          <img
            src={article.imageUrl}
            alt={article.title}
            onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
          />
          <p class="img-caption">Foto: {article.title}</p>
        </div>
      )}

      <!-- Content -->
      <div class="article-content" set:html={contentHtml}></div>

      <!-- Tags -->
      {article.tags.length > 0 && (
        <div class="article-tags">
          <span class="tags-label">Tags:</span>
          {article.tags.map((tag) => (
            <a href={`/cari?tag=${encodeURIComponent(tag)}`} class="tag-pill">
              #{tag}
            </a>
          ))}
        </div>
      )}

      <!-- Share & Bookmark -->
      <div class="article-share">
        <div class="share-buttons">
          <!-- Ditampilkan lewat script bila pengguna sudah masuk -->
          <button id="bookmark-btn" class="share-btn share-copy" data-id={article.id} hidden>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
            <span id="bm-text">Simpan Berita</span>
          </button>

          <span class="share-label" style="margin-left:8px;">Bagikan:</span>
          <button
            id="share-fb"
            class="share-btn share-facebook"
            aria-label="Share ke Facebook"
            onclick={`window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(window.location.href),'_blank')`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622 3.604 3.604 0 0 0-.272 1.237v1.808h3.605l-.499 3.667h-3.106v7.98H9.101z"/>
            </svg>
            Facebook
          </button>
          <button
            id="share-tw"
            class="share-btn share-twitter"
            aria-label="Share ke X"
            onclick={`window.open('https://twitter.com/intent/tweet?text='+'${tweetText}%20%20'+encodeURIComponent(window.location.href),'_blank')`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            X (Twitter)
          </button>
          <button
            id="copy-link"
            class="share-btn share-copy"
            aria-label="Salin link"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            Salin Link
          </button>
        </div>
      </div>

      <!-- Comments Section -->
      <Comments newsId={article.id} />
    </article>

    <!-- Sidebar -->
    <aside class="article-sidebar">
      <TrendingNews trending={trendingNews} />
    </aside>
  </main>

  <Footer />
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb-bar {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2) 0;
  }

  .breadcrumb-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb-inner a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .breadcrumb-inner a:hover {
    color: var(--color-accent);
  }

  .bc-sep {
    color: var(--color-text-muted);
  }

  .bc-current {
    color: var(--color-text-primary);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 300px;
  }

  /* Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }

  /* Article */
  .article-main {
    min-width: 0;
  }

  .article-category {
    display: inline-flex;
    margin-bottom: var(--space-3);
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    background: var(--navy);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
  }

  .article-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
  }


  /* Meta */
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-5);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .meta-item svg {
    width: 15px;
    height: 15px;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* Hero Image */
  .article-hero-img {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article-hero-img img {
    display: block;
    width: 100%;
    max-height: 560px;
    object-fit: contain;
    background: var(--color-bg-hover);
    border-radius: var(--radius-lg);
  }

  .img-caption {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: var(--space-2) 0 0;
    text-align: center;
    font-style: italic;
  }

  /* Content & Rich Text (Quill) Styles */
  .article-content {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin-bottom: var(--space-8);
    word-break: break-word;
  }

  /* Tags */
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }

  .tags-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .tag-pill {
    padding: 3px 12px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 1px solid var(--color-border-light);
    transition: all var(--transition-fast);
  }

  .tag-pill:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  /* Share */
  .article-share {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .share-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .share-buttons {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .share-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    border: none;
    transition: all var(--transition-fast);
  }

  .share-btn[hidden] {
    display: none;
  }

  .share-btn svg {
    width: 14px;
    height: 14px;
  }

  .share-facebook {
    background: #1877f2;
    color: white;
  }
  .share-facebook:hover { background: #1558b0; }

  .share-twitter {
    background: #000;
    color: white;
  }
  .share-twitter:hover { background: #333; }

  .share-copy {
    background: var(--color-surface);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-light);
  }
  .share-copy:hover {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  /* Sidebar */
  .article-sidebar {
    position: sticky;
    top: calc(var(--navbar-height) + var(--space-4));
  }

  @media (max-width: 1024px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
    .article-sidebar {
      position: static;
    }
  }
</style>

<style is:global>
  /* Konten artikel berasal dari set:html sehingga tidak terkena CSS ber-scope.
     Mendukung hasil editor baru maupun arsip WordPress. */
  .article-content p { margin: 0 0 var(--space-4); }
  .article-content > :last-child { margin-bottom: 0; }
  .article-content h2,
  .article-content h3,
  .article-content h4 {
    color: var(--color-text-primary);
    font-weight: 800;
    line-height: 1.35;
    margin: var(--space-6) 0 var(--space-3);
  }
  .article-content strong { color: var(--color-text-primary); }
  .article-content img {
    max-width: 100%;
    max-height: 640px;
    width: auto;
    height: auto;
    border-radius: 8px;
    margin: var(--space-4) auto;
    display: block;
  }
  .article-content figure { margin: var(--space-4) 0; max-width: 100%; }
  .article-content figure img { margin-bottom: var(--space-2); }
  .article-content figcaption {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    font-style: italic;
  }
  .article-content a { color: var(--color-accent); text-decoration: underline; overflow-wrap: anywhere; }
  .article-content blockquote {
    border-left: 4px solid var(--color-accent);
    margin: 0 0 var(--space-4);
    font-style: italic;
    color: var(--color-text-muted);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    border-radius: 4px;
  }
  .article-content ul,
  .article-content ol { margin: 0 0 var(--space-4); padding-left: var(--space-6); }
  .article-content ul { list-style: disc; }
  .article-content ol { list-style: decimal; }
  .article-content li { margin-bottom: 8px; }
  .article-content pre {
    background: #1e1e1e;
    color: #fff;
    padding: var(--space-4);
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }
  .article-content table {
    display: block;
    width: 100% !important;
    height: auto !important;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }
  .article-content th,
  .article-content td {
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    vertical-align: top;
  }
  .article-content td p { margin: 0; }
  .article-content iframe { max-width: 100%; border: 0; }
  .article-content .embed,
  .article-content .video-embed { aspect-ratio: 16 / 9; margin-bottom: var(--space-4); }
  .article-content .embed iframe,
  .article-content .video-embed iframe { width: 100%; height: 100%; border-radius: 8px; }
</style>

<script>
  import { API_BASE } from "../../lib/config";

  const copyBtn = document.getElementById("copy-link");
  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText(window.location.href).then(() => {
      const original = copyBtn.innerHTML;
      copyBtn.innerHTML = "✓ Link disalin!";
      setTimeout(() => { copyBtn.innerHTML = original; }, 2000);
    });
  });

  const bmBtn = document.getElementById("bookmark-btn");
  const newsId = Number(bmBtn?.dataset.id);

  // Halaman statis: tayangan dihitung dari browser
  fetch(`${API_BASE}/news/${newsId}/view`, { method: "POST" }).catch(() => {});

  function showBookmark(saved: boolean) {
    bmBtn?.classList.toggle("bookmarked", saved);
    bmBtn?.querySelector("svg")?.setAttribute("fill", saved ? "currentColor" : "none");
    const text = document.getElementById("bm-text");
    if (text) text.textContent = saved ? "Tersimpan" : "Simpan Berita";
  }

  // 200 hanya bila pengguna sudah masuk
  fetch(`${API_BASE}/user/bookmarks/${newsId}`, { credentials: "include" })
    .then(async (res) => {
      if (!res.ok || !bmBtn) return;
      showBookmark(!!(await res.json()).bookmarked);
      bmBtn.hidden = false;
      fetch(`${API_BASE}/user/history`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ news_id: newsId }),
      }).catch(() => {});
    })
    .catch(() => {});

  bmBtn?.addEventListener("click", async () => {
    try {
      const res = await fetch(`${API_BASE}/user/bookmarks`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ news_id: newsId }),
      });
      if (res.ok) showBookmark((await res.json()).bookmarked);
    } catch (err) { console.error(err); }
  });
</script>
