---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import TrendingNews from "../../components/TrendingNews.astro";
import Footer from "../../components/Footer.astro";
import Comments from "../../components/Comments.astro";

const { slug } = Astro.params;
const API_BASE = "http://localhost:3000/api";

let article: any = null;
let trendingNews: any[] = [];

try {
  const [articleRes, trendingRes] = await Promise.all([
    fetch(`${API_BASE}/news/slug/${slug}`),
    fetch(`${API_BASE}/news/trending?limit=5`),
  ]);

  if (articleRes.ok) article = await articleRes.json();
  if (trendingRes.ok) trendingNews = await trendingRes.json();
} catch (err) {
  console.error("Failed to fetch from Go Fiber:", err);
}

if (!article) {
  return Astro.redirect("/404");
}

// Normalize Go Fiber response (handles GORM uppercase fields)
function normalize(a: any) {
  return {
    id: a.ID || a.id,
    title: a.title,
    slug: a.slug,
    excerpt: a.excerpt,
    imageUrl: a.imageUrl || a.image_url,
    category: a.category,
    content: a.content,
    tags: a.tags,
    author: a.author,
    viewCount: a.viewCount || a.view_count,
    createdAt: a.CreatedAt || a.createdAt || a.created_at,
  };
}

const normalizedArticle = normalize(article);
const normalizedTrending = trendingNews.map(normalize);

const formattedDate = normalizedArticle.createdAt
  ? new Date(normalizedArticle.createdAt).toLocaleDateString("id-ID", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : "";
---

<Layout
  title={`${normalizedArticle.title} — EduTech News Portal`}
  description={normalizedArticle.excerpt || normalizedArticle.title}
  image={normalizedArticle.imageUrl}
>
  <Navbar />

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/">Beranda</a>
      <span class="bc-sep">›</span>
      {normalizedArticle.category && (
        <>
          <a href={`/kategori/${normalizedArticle.category.toLowerCase()}`}>{normalizedArticle.category}</a>
          <span class="bc-sep">›</span>
        </>
      )}
      <span class="bc-current">{normalizedArticle.title}</span>
    </div>
  </div>

  <main id="main-content" class="container article-layout">
    <!-- Main Article -->
    <article class="article-main">
      <!-- Category & Title -->
      {normalizedArticle.category && (
        <a href={`/kategori/${normalizedArticle.category.toLowerCase()}`} class="article-category badge badge-accent">
          {normalizedArticle.category}
        </a>
      )}
      <h1 class="article-title">{normalizedArticle.title}</h1>

      {normalizedArticle.excerpt && (
        <p class="article-excerpt">{normalizedArticle.excerpt}</p>
      )}

      <!-- Meta -->
      <div class="article-meta">
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span>{normalizedArticle.author || "Redaksi"}</span>
        </div>
        {formattedDate && (
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>{formattedDate}</span>
          </div>
        )}
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span>{normalizedArticle.viewCount || 0} tayangan</span>
        </div>
      </div>

      <!-- Hero Image -->
      {normalizedArticle.imageUrl && (
        <div class="article-hero-img">
          <img src={normalizedArticle.imageUrl} alt={normalizedArticle.title} />
          <p class="img-caption">Foto: {normalizedArticle.title}</p>
        </div>
      )}

      <!-- Content -->
      <div class="article-content" set:html={normalizedArticle.content}></div>

      <!-- Tags -->
      {normalizedArticle.tags && (
        <div class="article-tags">
          <span class="tags-label">Tags:</span>
          {normalizedArticle.tags.split(',').map((tag: string) => (
            <a href={`/tag/${tag.trim().toLowerCase()}`} class="tag-pill">
              #{tag.trim()}
            </a>
          ))}
        </div>
      )}

      <!-- Share -->
      <div class="article-share">
        <span class="share-label">Bagikan:</span>
        <div class="share-buttons">
          <button
            id="share-fb"
            class="share-btn share-facebook"
            aria-label="Share ke Facebook"
            onclick={`window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(window.location.href),'_blank')`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622 3.604 3.604 0 0 0-.272 1.237v1.808h3.605l-.499 3.667h-3.106v7.98H9.101z"/>
            </svg>
            Facebook
          </button>
          <button
            id="share-tw"
            class="share-btn share-twitter"
            aria-label="Share ke X"
            onclick={`window.open('https://twitter.com/intent/tweet?text='+encodeURIComponent('${normalizedArticle.title}'+'  ')+encodeURIComponent(window.location.href),'_blank')`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            X (Twitter)
          </button>
          <button
            id="copy-link"
            class="share-btn share-copy"
            aria-label="Salin link"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            Salin Link
          </button>
        </div>
      </div>

      <!-- Comments Section -->
      <Comments newsId={normalizedArticle.id} />
    </article>

    <!-- Sidebar -->
    <aside class="article-sidebar">
      <TrendingNews trending={normalizedTrending} />
    </aside>
  </main>

  <Footer />
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb-bar {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2) 0;
  }

  .breadcrumb-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb-inner a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .breadcrumb-inner a:hover {
    color: var(--color-accent);
  }

  .bc-sep {
    color: var(--color-text-muted);
  }

  .bc-current {
    color: var(--color-text-primary);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 300px;
  }

  /* Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }

  /* Article */
  .article-main {
    min-width: 0;
  }

  .article-category {
    display: inline-flex;
    margin-bottom: var(--space-3);
    text-decoration: none;
  }

  .article-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
  }

  .article-excerpt {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
    font-style: italic;
  }

  /* Meta */
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-5);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .meta-item svg {
    width: 15px;
    height: 15px;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* Hero Image */
  .article-hero-img {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article-hero-img img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .img-caption {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: var(--space-2) 0 0;
    text-align: center;
    font-style: italic;
  }

  /* Content & Rich Text (Quill) Styles */
  .article-content {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin-bottom: var(--space-8);
    word-break: break-word;
  }

  .article-content p {
    margin-bottom: var(--space-4);
  }

  .article-content p:last-child {
    margin-bottom: 0;
  }
  
  .article-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: var(--space-4) 0;
    display: block;
  }

  .article-content a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .article-content blockquote {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-4);
    margin-left: 0;
    font-style: italic;
    color: var(--color-text-muted);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    border-radius: 4px;
  }

  .article-content ul, .article-content ol {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .article-content li {
    margin-bottom: 8px;
  }

  .article-content pre {
    background: #1e1e1e;
    color: #fff;
    padding: var(--space-4);
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  /* Tags */
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }

  .tags-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .tag-pill {
    padding: 3px 12px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 1px solid var(--color-border-light);
    transition: all var(--transition-fast);
  }

  .tag-pill:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  /* Share */
  .article-share {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .share-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .share-buttons {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .share-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    border: none;
    transition: all var(--transition-fast);
  }

  .share-btn svg {
    width: 14px;
    height: 14px;
  }

  .share-facebook {
    background: #1877f2;
    color: white;
  }
  .share-facebook:hover { background: #1558b0; }

  .share-twitter {
    background: #000;
    color: white;
  }
  .share-twitter:hover { background: #333; }

  .share-copy {
    background: var(--color-surface);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-light);
  }
  .share-copy:hover {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  /* Sidebar */
  .article-sidebar {
    position: sticky;
    top: calc(var(--navbar-height) + var(--space-4));
  }

  @media (max-width: 1024px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
    .article-sidebar {
      position: static;
    }
  }
</style>

<script>
  // Copy Link
  const copyBtn = document.getElementById('copy-link');
  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href).then(() => {
      if (copyBtn) {
        const original = copyBtn.innerHTML;
        copyBtn.innerHTML = '✓ Link disalin!';
        setTimeout(() => { copyBtn.innerHTML = original; }, 2000);
      }
    });
  });
</script>
