---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import TrendingNews from "../../components/TrendingNews.astro";
import Footer from "../../components/Footer.astro";
import Comments from "../../components/Comments.astro";
import Poster from "../../components/Poster.astro";
import { FALLBACK_IMAGE, apiFind, getNews, getTrending, normalizeNews, renderContent, type News } from "../../lib/news";
import { insertReadAlso, prepareArticle } from "../../lib/article";
import { bannersAt } from "../../lib/site";

const slug = Astro.params.slug as string;
// track=0: tayangan dihitung dari browser, bukan saat halaman dibuat
const raw = await apiFind(`/news/slug/${encodeURIComponent(slug)}?track=0`);
if (!raw) {
  // slug lama (mis. dari WordPress) → alamat sekarang; selain itu halaman 404
  const moved = await apiFind(`/news/resolve/${encodeURIComponent(slug)}`);
  if (moved?.slug && moved.slug !== slug) return Astro.redirect(`/berita/${moved.slug}`, 301);
  return Astro.rewrite("/404");
}
const article = normalizeNews(raw);
const editor = String(raw.updatedByName || "").trim();

// Berita lain dari kategori yang sama: 2 untuk "Baca Juga", sisanya "Berita Terkait"
const others = async (path: string) => (await getNews(path).catch(() => [] as News[])).filter((n) => n.id !== article.id);
let related = article.categorySlug ? await others(`/news?category=${encodeURIComponent(article.categorySlug)}&limit=9&lite=1`) : [];
if (related.length < 6) {
  const latest = await others(`/news?limit=9&lite=1`);
  related = [...related, ...latest.filter((n) => !related.some((r) => r.id === n.id))];
}
const readAlso = related.slice(0, 2);
const moreNews = related.slice(2, 8);

const [trendingNews, sidePosters] = await Promise.all([getTrending().catch(() => []), bannersAt("kanan")]);

const prepared = prepareArticle(article.content, article.imageUrl);
const contentHtml = insertReadAlso(
  renderContent(prepared.html, article.imageUrl),
  readAlso.map((n) => ({ title: n.title, href: `/berita/${n.slug}` })),
);

const published = article.createdAt ? new Date(article.createdAt) : null;
const dateText = published
  ? published.toLocaleDateString("id-ID", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Jakarta" })
  : "";
const timeText = published
  ? published.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Asia/Jakarta" }).replace(".", ":")
  : "";
const shortDate = (d: string) =>
  d ? new Date(d).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Jakarta" }) : "";
---

<Layout
  title={`${article.title} — EduTech News Portal`}
  description={prepared.subtitle || article.excerpt || article.title}
  image={article.imageUrl}
>
  <Navbar />

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/">Beranda</a>
      <span class="bc-sep">›</span>
      {article.category && (
        <>
          <a href={`/kategori/${article.categorySlug}`}>{article.category}</a>
          <span class="bc-sep">›</span>
        </>
      )}
      <span class="bc-current">{article.title}</span>
    </div>
  </div>

  <main id="main-content" class="container article-layout">
    <article class="article-main">
      <header class="article-head">
        {article.category && (
          <a href={`/kategori/${article.categorySlug}`} class="article-category">{article.category}</a>
        )}
        <h1 class="article-title">{article.title}</h1>
        {prepared.subtitle && <p class="article-subtitle">{prepared.subtitle}</p>}

        <div class="article-byline">
          <div class="byline-text">
            <p class="byline-people">
              <span>Penulis: <strong>{article.author || "Redaksi"}</strong></span>
              {editor && editor !== article.author && <span>Editor: <strong>{editor}</strong></span>}
            </p>
            <p class="byline-meta">
              {dateText && <time datetime={article.createdAt}>{dateText}, {timeText} WIB</time>}
              <span>{article.readTime} menit baca</span>
              <span>{article.viewCount || 0} kali dibaca</span>
            </p>
          </div>
          <div class="share-icons" aria-label="Bagikan berita">
            <a class="share-icon share-wa" data-share="wa" href="#" target="_blank" rel="noopener" aria-label="Bagikan ke WhatsApp" title="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.42 9.43-9.42a9.36 9.36 0 0 1 6.66 2.76 9.36 9.36 0 0 1 2.76 6.67c0 5.2-4.23 9.42-9.43 9.42m8.02-17.44A11.27 11.27 0 0 0 12.05.75C5.8.75.7 5.84.7 12.1c0 2 .52 3.95 1.52 5.67L.6 23.25l5.6-1.47a11.33 11.33 0 0 0 5.84 1.6c6.26 0 11.35-5.1 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02"/></svg>
            </a>
            <a class="share-icon share-fbk" data-share="fb" href="#" target="_blank" rel="noopener" aria-label="Bagikan ke Facebook" title="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.1 23.7v-8H6.63V12h2.47v-1.58c0-4.09 1.85-5.98 5.86-5.98.4 0 .96.04 1.47.1.5.06.88.13 1.14.2v3.32a8.6 8.6 0 0 0-.65-.03h-.74c-.7 0-1.26.1-1.67.31a1.7 1.7 0 0 0-.68.62c-.18.33-.27.75-.27 1.24V12h3.6l-.5 3.67h-3.1v7.98H9.1z"/></svg>
            </a>
            <a class="share-icon share-x" data-share="x" href="#" target="_blank" rel="noopener" aria-label="Bagikan ke X" title="X (Twitter)">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z"/></svg>
            </a>
            <button type="button" class="share-icon share-link" data-share="copy" aria-label="Salin tautan" title="Salin tautan">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
          </div>
        </div>
      </header>

      {article.imageUrl && (
        <figure class="article-hero-img">
          <img
            src={article.imageUrl}
            alt={prepared.heroCaption || article.title}
            fetchpriority="high"
            onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
          />
          {prepared.heroCaption && <figcaption class="img-caption">{prepared.heroCaption}</figcaption>}
        </figure>
      )}

      <div class="article-content article-body" set:html={contentHtml}></div>

      {article.tags.length > 0 && (
        <div class="article-tags">
          <span class="tags-label">Topik</span>
          {article.tags.map((tag) => (
            <a href={`/cari?tag=${encodeURIComponent(tag)}`} class="tag-pill">{tag}</a>
          ))}
        </div>
      )}

      <div class="article-share">
        <button id="bookmark-btn" class="share-btn share-save" data-id={article.id} hidden>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
          <span id="bm-text">Simpan Berita</span>
        </button>
        <span class="share-label">Bagikan:</span>
        <a class="share-btn share-whatsapp" data-share="wa" href="#" target="_blank" rel="noopener">WhatsApp</a>
        <a id="share-fb" class="share-btn share-facebook" data-share="fb" href="#" target="_blank" rel="noopener">Facebook</a>
        <a id="share-tw" class="share-btn share-twitter" data-share="x" href="#" target="_blank" rel="noopener">X (Twitter)</a>
        <button id="copy-link" type="button" class="share-btn share-copy" data-share="copy">Salin Link</button>
      </div>

      {moreNews.length > 0 && (
        <section class="related-news" aria-labelledby="related-heading">
          <h2 id="related-heading" class="section-heading">Berita Terkait</h2>
          <div class="related-grid">
            {moreNews.map((n) => (
              <a href={`/berita/${n.slug}`} class="related-card">
                <span class="related-img">
                  <img src={n.imageUrl} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`} />
                </span>
                <span class="related-body">
                  {n.category && <span class="related-cat">{n.category}</span>}
                  <span class="related-title">{n.title}</span>
                  <span class="related-date">{shortDate(n.createdAt)}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      <Comments newsId={article.id} />
    </article>

    <aside class="article-sidebar">
      {sidePosters.length > 0 && (
        <div class="side-posters">
          <Poster banners={sidePosters} variant="samping" />
        </div>
      )}
      <TrendingNews trending={trendingNews} />
    </aside>
  </main>

  <Footer />
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb-bar {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2) 0;
  }
  .breadcrumb-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .breadcrumb-inner a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }
  .breadcrumb-inner a:hover { color: var(--color-accent); }
  .bc-sep { color: var(--color-text-muted); }
  .bc-current {
    color: var(--color-text-primary);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: min(420px, 60vw);
  }

  /* Tata letak: kolom baca sekitar 780px + sidebar, seperti portal berita besar */
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-10);
    align-items: start;
    max-width: 1180px;
    padding-top: var(--space-6);
    padding-bottom: var(--space-10);
  }
  .article-main { min-width: 0; }

  /* Kepala berita */
  .article-category {
    display: inline-block;
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .article-category:hover { text-decoration: underline; }
  .article-title {
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
    font-family: var(--font-heading, var(--font-sans));
  }
  .article-subtitle {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.5;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .article-byline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-3) 0;
    margin-bottom: var(--space-5);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .byline-text p { margin: 0; }
  .byline-people {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .byline-people strong { color: var(--color-text-primary); font-weight: 700; }
  .byline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    margin-top: 2px !important;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .byline-meta > * + *::before { content: "•"; margin: 0 8px; opacity: 0.6; }

  .share-icons { display: flex; gap: 8px; }
  .share-icon {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    color: #fff;
    cursor: pointer;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }
  .share-icon:hover { transform: translateY(-1px); opacity: 0.9; }
  .share-icon svg { width: 17px; height: 17px; }
  .share-wa { background: #25d366; }
  .share-fbk { background: #1877f2; }
  .share-x { background: #000; }
  .share-link { background: var(--color-bg-hover); color: var(--color-text-primary); }
  .share-link.copied { background: var(--color-green); color: #fff; }

  /* Foto utama */
  .article-hero-img { margin: 0 0 var(--space-6); }
  .article-hero-img img {
    display: block;
    width: 100%;
    max-height: 560px;
    object-fit: contain;
    background: var(--color-bg-hover);
    border-radius: var(--radius-md);
  }
  .img-caption {
    margin-top: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-light);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Topik */
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-8) 0 var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .tags-label {
    margin-right: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-text-primary);
  }
  .tag-pill {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--color-bg-hover);
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    transition: all var(--transition-fast);
  }
  .tag-pill:hover { background: var(--color-accent); color: #fff; }

  /* Bagikan (bawah) */
  .article-share {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }
  .share-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-secondary);
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: 700;
    font-family: var(--font-sans);
    cursor: pointer;
    border: none;
    color: #fff;
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .share-btn[hidden] { display: none; }
  .share-btn svg { width: 14px; height: 14px; }
  .share-whatsapp { background: #25d366; }
  .share-facebook { background: #1877f2; }
  .share-twitter { background: #000; }
  .share-copy,
  .share-save {
    background: var(--color-surface);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }
  .share-copy:hover,
  .share-save:hover { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }
  .share-save.bookmarked { color: var(--color-accent); border-color: var(--color-accent); }

  /* Berita terkait */
  .related-news { margin-bottom: var(--space-8); }
  .section-heading {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-3);
    border-left: 4px solid var(--color-accent);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text-primary);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
  }
  .related-card { display: flex; flex-direction: column; gap: var(--space-2); color: inherit; text-decoration: none; }
  .related-img { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius-md); background: var(--color-bg-hover); }
  .related-img img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-base); }
  .related-card:hover img { transform: scale(1.04); }
  .related-body { display: flex; flex-direction: column; gap: 4px; }
  .related-cat { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-accent); }
  .related-title {
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card:hover .related-title { color: var(--color-accent); }
  .related-date { font-size: var(--text-xs); color: var(--color-text-muted); }

  /* Sidebar */
  .article-sidebar {
    position: sticky;
    top: calc(var(--navbar-height, 64px) + var(--space-4));
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .side-posters { display: flex; flex-direction: column; gap: var(--space-3); }

  @media (max-width: 1024px) {
    .article-layout { grid-template-columns: 1fr; gap: var(--space-8); }
    .article-sidebar { position: static; }
  }
  @media (max-width: 640px) {
    .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4) var(--space-3); }
    .related-title { font-size: var(--text-sm); }
    .article-subtitle { font-size: var(--text-md); }
    .share-icons { width: 100%; }
  }
</style>

<style is:global>
  /* Isi berita dari set:html tidak terkena CSS ber-scope.
     Mendukung hasil editor baru maupun arsip WordPress (lihat lib/article.ts). */
  .article-main .article-body {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-primary);
    word-break: break-word;
    margin-bottom: var(--space-4);
  }
  .article-main .article-body p { margin: 0 0 var(--space-5); color: var(--color-text-primary); }
  @media (max-width: 640px) {
    .article-main .article-body { font-size: 1rem; line-height: 1.75; }
  }
  .article-main .article-body > :last-child { margin-bottom: 0; }
  .article-body h2,
  .article-body h3,
  .article-body h4 {
    color: var(--color-text-primary);
    font-weight: 800;
    line-height: 1.35;
    margin: var(--space-8) 0 var(--space-3);
  }
  .article-body h2 { font-size: 1.4rem; }
  .article-body h3 { font-size: 1.2rem; }
  .article-body h4 { font-size: 1.05rem; }
  .article-body strong { color: var(--color-text-primary); }
  .article-body img {
    max-width: 100%;
    max-height: 640px;
    width: auto;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-4) auto;
    display: block;
  }
  .article-body figure { margin: var(--space-6) 0; max-width: 100%; }
  .article-body figure img { margin: 0 auto; }
  .article-body figcaption {
    margin-top: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-light);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-align: left;
    font-style: normal;
  }
  .article-body a { color: var(--color-accent); text-decoration: underline; overflow-wrap: anywhere; }
  .article-body blockquote {
    border-left: 4px solid var(--color-accent);
    margin: 0 0 var(--space-5);
    font-style: italic;
    color: var(--color-text-secondary);
    background: var(--color-bg-hover);
    padding: var(--space-3) var(--space-4);
    border-radius: 4px;
  }
  .article-body ul,
  .article-body ol { margin: 0 0 var(--space-5); padding-left: var(--space-6); }
  .article-body ul { list-style: disc; }
  .article-body ol { list-style: decimal; }
  .article-body li { margin-bottom: 8px; }
  .article-body pre {
    background: #1e1e1e;
    color: #fff;
    padding: var(--space-4);
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }
  .article-body table {
    display: block;
    width: 100% !important;
    height: auto !important;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .article-body th,
  .article-body td {
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    vertical-align: top;
  }
  .article-main .article-body td p { margin: 0; }
  .article-body iframe { max-width: 100%; border: 0; }
  .article-body .embed,
  .article-body .video-embed { aspect-ratio: 16 / 9; margin-bottom: var(--space-5); }
  .article-body .embed iframe,
  .article-body .video-embed iframe { width: 100%; height: 100%; border-radius: 8px; }

  /* Kotak "Baca Juga" di tengah tulisan */
  .article-body .read-also {
    margin: var(--space-2) 0 var(--space-6);
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-accent);
    background: var(--color-bg-hover);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .article-body .read-also-label {
    display: block;
    margin-bottom: 4px;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .article-body .read-also ul { list-style: none; margin: 0; padding: 0; }
  .article-body .read-also li { margin: 0; line-height: 1.45; }
  .article-body .read-also li + li { margin-top: 6px; }
  .article-body .read-also a {
    color: var(--color-text-primary);
    font-size: var(--text-md);
    font-weight: 700;
    text-decoration: none;
  }
  .article-body .read-also a:hover { color: var(--color-accent); text-decoration: underline; }
</style>

<script>
  import { API_BASE } from "../../lib/config";

  // Tautan bagikan memakai alamat halaman sebenarnya
  const pageUrl = window.location.href.split("#")[0];
  const title = document.querySelector("h1")?.textContent?.trim() || document.title;
  const shareUrl: Record<string, string> = {
    wa: `https://wa.me/?text=${encodeURIComponent(`${title}\n${pageUrl}`)}`,
    fb: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
    x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(pageUrl)}`,
  };
  document.querySelectorAll<HTMLAnchorElement>("a[data-share]").forEach((a) => {
    a.href = shareUrl[a.dataset.share || ""] || pageUrl;
  });
  document.querySelectorAll<HTMLButtonElement>('button[data-share="copy"]').forEach((btn) => {
    btn.addEventListener("click", () => {
      navigator.clipboard?.writeText(pageUrl).then(() => {
        btn.classList.add("copied");
        const label = btn.id === "copy-link" ? btn.textContent : null;
        if (label !== null) btn.textContent = "✓ Link disalin!";
        setTimeout(() => {
          btn.classList.remove("copied");
          if (label !== null) btn.textContent = label;
        }, 2000);
      });
    });
  });

  const bmBtn = document.getElementById("bookmark-btn");
  const newsId = Number(bmBtn?.dataset.id);

  // Tayangan dihitung dari browser
  fetch(`${API_BASE}/news/${newsId}/view`, { method: "POST" }).catch(() => {});

  function showBookmark(saved: boolean) {
    bmBtn?.classList.toggle("bookmarked", saved);
    bmBtn?.querySelector("svg")?.setAttribute("fill", saved ? "currentColor" : "none");
    const text = document.getElementById("bm-text");
    if (text) text.textContent = saved ? "Tersimpan" : "Simpan Berita";
  }

  // 200 hanya bila pengguna sudah masuk
  fetch(`${API_BASE}/user/bookmarks/${newsId}`, { credentials: "include" })
    .then(async (res) => {
      if (!res.ok || !bmBtn) return;
      showBookmark(!!(await res.json()).bookmarked);
      bmBtn.hidden = false;
      fetch(`${API_BASE}/user/history`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ news_id: newsId }),
      }).catch(() => {});
    })
    .catch(() => {});

  bmBtn?.addEventListener("click", async () => {
    try {
      const res = await fetch(`${API_BASE}/user/bookmarks`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ news_id: newsId }),
      });
      if (res.ok) showBookmark((await res.json()).bookmarked);
    } catch (err) {
      console.error(err);
    }
  });
</script>
